func IsValidRefEntity:
    inputs:
        refEntity string (1..1)
    output:
        validRefEntity boolean (1..1)

    alias validFormat: <"Valid pattern contains 2 characters, followed by optional part contains a hyphen and 3 characters.">
        StringContains(refEntity, "[A-Z]{2}(-[A-Z]{3})?")
    alias validCountryCode: SubString(refEntity, 1, 2) to-enum ISOCountryCodeEnum exists

    set validRefEntity: validCountryCode and validFormat

func LastAvailableSpotPrice:
    inputs:
        reportableInformation ReportableInformationBase (1..1)
    output:
        lastAvailableSpotPrice PriceSchedule (0..1)
    // Last Available Spot Price will be found in the tradeLot for Commodity Basis Swaps.
    // This is the only price in this kind of products which is not a spread. It is an Asset Price also.
    set lastAvailableSpotPrice:
        reportableInformation -> underlyingAssetLastAvailableSpotPrice

func CommodityBasisLegWithNoSpread:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        commodityPayout CommodityPayout (0..1)
    // This function takes, from the two commodity payouts of a commodity basis, the one which does not have an spread or which has an spread = 0
    set commodityPayout:
        EconomicTermsForProduct(product) -> payout -> CommodityPayout
            filter
                commodityPriceReturnTerms -> spread is absent
                    or commodityPriceReturnTerms -> spread -> price -> value = 0
            then only-element

func Create_DeliveryBlock:
    inputs:
        deliveryStartTime time (0..1)
        deliveryEndTime time (0..1)
        deliveryStartDate date (0..1)
        deliveryEndDate date (0..1)
        bankHolidaysTreatment BankHolidayTreatmentEnum (0..1)
        duration CommodityTimeUnitEnum (0..1)
        daysOfTheWeek DayOfWeekEnum (0..7)
        deliveryCapacity Quantity (0..1)
        priceTimeIntervalQuantity number (0..1)
        currencyOfThePriceTimeIntervalQuantity string (0..1)
    output:
        deliveryBlock ReportableDelivery (1..1)
    set deliveryBlock:
        ReportableDelivery {
            deliveryStartTime: deliveryStartTime,
            deliveryEndTime: deliveryEndTime,
            deliveryStartDate: deliveryStartDate,
            deliveryEndDate: deliveryEndDate,
            duration: GetDurationCodeFromCommodityTimeUnit(duration),
            daysOfTheWeek: GetDaysOfTheWeek(daysOfTheWeek, bankHolidaysTreatment),
            deliveryCapacity: GetDeliveryCapacityAmount(deliveryCapacity),
            quantityUnit: GetDeliveryCapacityUnit(deliveryCapacity),
            priceTimeIntervalQuantity: priceTimeIntervalQuantity,
            currencyOfThePriceTimeIntervalQuantity: currencyOfThePriceTimeIntervalQuantity
        }

func GetDaysOfTheWeek:
    inputs:
        daysOfTheWeek DayOfWeekEnum (0..7)
        bankHolidaysTreatment BankHolidayTreatmentEnum (0..1)
    output:
        dayCode string (0..*)
    alias mon: daysOfTheWeek contains DayOfWeekEnum -> MON
    alias tue: daysOfTheWeek contains DayOfWeekEnum -> TUE
    alias wed: daysOfTheWeek contains DayOfWeekEnum -> WED
    alias thu: daysOfTheWeek contains DayOfWeekEnum -> THU
    alias fri: daysOfTheWeek contains DayOfWeekEnum -> FRI
    alias sat: daysOfTheWeek contains DayOfWeekEnum -> SAT
    alias sun: daysOfTheWeek contains DayOfWeekEnum -> SUN
    add dayCode: // MOND
        if mon and (tue = False or wed = False or thu = False or fri = False)
        then "MOND"
    add dayCode: // TUED
        if tue and (mon = False or wed = False or thu = False or fri = False)
        then "TUED"
    add dayCode: // WEDD
        if wed and (mon = False or tue = False or thu = False or fri = False)
        then "WEDD"
    add dayCode: // THUD
        if thu and (mon = False or tue = False or wed = False or fri = False)
        then "THUD"
    add dayCode: // FRID
        if fri and (mon = False or tue = False or wed = False or thu = False)
        then "FRID"
    add dayCode: // SATD
        if sat and (sun = False) then "SATD"
    add dayCode: // SUND
        if sun and (sat = False) then "SUND"
    add dayCode: // WDAY
        if mon and tue and wed and thu and fri then "WDAY"
    add dayCode: // WEND
        if sat and sun then "WEND"
    add dayCode:
        if bankHolidaysTreatment = BankHolidayTreatmentEnum -> AsWeekday
                and (mon or tue or wed or thu or fri)
                and ((sat or sun) = False)
        then "IBHL"
        else if bankHolidaysTreatment = BankHolidayTreatmentEnum -> AsWeekend
                and (sat or sun)
                and ((mon or tue or wed or thu or fri) = False)
        then "IBHL"
    add dayCode:
        if bankHolidaysTreatment = BankHolidayTreatmentEnum -> AsWeekend
                and (mon or tue or wed or thu or fri)
                and ((sat or sun) = False)
        then "XBHL"
        else if bankHolidaysTreatment = BankHolidayTreatmentEnum -> AsWeekday
                and (sat or sun)
                and ((mon or tue or wed or thu or fri) = False)
        then "XBHL"

func GetDurationCodeFromCommodityTimeUnit: <"Function to get the duration of a delivery profile from CommodityTimeUnitEnum to DurationType1Code">
    inputs:
        timeUnit CommodityTimeUnitEnum (1..1)
    output:
        duration DurationType1Code (1..1)
    set duration:
        if timeUnit = CommodityTimeUnitEnum -> Minute
        then DurationType1Code -> MNUT
        else if timeUnit = CommodityTimeUnitEnum -> Hour
        then DurationType1Code -> HOUR
        else if timeUnit = CommodityTimeUnitEnum -> Day
        then DurationType1Code -> DASD
        else if timeUnit = CommodityTimeUnitEnum -> Week
        then DurationType1Code -> WEEK
        else if timeUnit = CommodityTimeUnitEnum -> Month
        then DurationType1Code -> MNTH
        else if timeUnit = CommodityTimeUnitEnum -> Quarter
        then DurationType1Code -> QURT
        else if timeUnit = CommodityTimeUnitEnum -> Season
        then DurationType1Code -> SEAS
        else if timeUnit = CommodityTimeUnitEnum -> Year
        then DurationType1Code -> YEAR
        else if timeUnit = CommodityTimeUnitEnum -> Other
        then DurationType1Code -> OTHR

func GetLoadType: <"Function to get the load type of a delivery profile from LoadTypeEnum to EnergyLoadType1Code">
    inputs:
        profile AssetDeliveryProfile (1..1)
    output:
        loadType EnergyLoadType1Code (1..1)
    set loadType:
        if profile -> loadType = LoadTypeEnum -> BaseLoad
        then EnergyLoadType1Code -> BSLD
        else if profile -> loadType = LoadTypeEnum -> PeakLoad
        then EnergyLoadType1Code -> PKLD
        else if profile -> loadType = LoadTypeEnum -> OffPeak
        then EnergyLoadType1Code -> OFFP
        else if profile -> loadType = LoadTypeEnum -> BlockHours
        then EnergyLoadType1Code -> HABH
        else if profile -> loadType = LoadTypeEnum -> Shaped
        then EnergyLoadType1Code -> SHPD
        else if profile -> loadType = LoadTypeEnum -> GasDay
        then EnergyLoadType1Code -> GASD
        else if profile -> loadType = LoadTypeEnum -> Other
        then EnergyLoadType1Code -> OTHR

func GetDeliveryCapacityAmount:
    inputs:
        deliveryCapacity Quantity (0..1)
    output:
        amount number (0..1)
    set amount: QuantityToDeliveryCapacity(deliveryCapacity) -> amount

func GetDeliveryCapacityUnit:
    inputs:
        deliveryCapacity Quantity (0..1)
    output:
        unit EnergyQuantityUnit2Code (0..1)
    set unit: QuantityToDeliveryCapacity(deliveryCapacity) -> unit

func QuantityToDeliveryCapacity:
    inputs:
        quantity Quantity (0..1)
    output:
        deliveryCapacity DeliveryCapacity (0..1)
    alias capacityUnit: quantity -> unit -> capacityUnit
    alias frequency: quantity -> frequency
    set deliveryCapacity:
        // POWER UNITS
        if capacityUnit = KW
        then DeliveryCapacity {
                amount: quantity -> value,
                unit: EnergyQuantityUnit2Code -> KWAT
            }
        else if capacityUnit = MW
        then DeliveryCapacity {
                amount: quantity -> value,
                unit: EnergyQuantityUnit2Code -> MWAT
            }
        else if capacityUnit = GW
        then DeliveryCapacity {
                amount: quantity -> value,
                unit: EnergyQuantityUnit2Code -> GWAT
            }
        // BRITISH THERMAL UNITS
        else if [CapacityUnitEnum -> GBBTU, CapacityUnitEnum -> ISOBTU, CapacityUnitEnum -> USBTU] any = capacityUnit
        then (if frequency -> period = PeriodExtendedEnum -> D
            then DeliveryCapacity {
                    amount: quantity -> value / frequency -> periodMultiplier,
                    unit: EnergyQuantityUnit2Code -> BTUD
                })
        else if [CapacityUnitEnum -> GBMBTU, CapacityUnitEnum -> ISOMBTU, CapacityUnitEnum -> USMBTU] any = capacityUnit
        then (if frequency -> period = PeriodExtendedEnum -> D
            then DeliveryCapacity {
                    amount: (1000.0 * quantity -> value) / frequency -> periodMultiplier,
                    unit: EnergyQuantityUnit2Code -> BTUD
                })
        else if [CapacityUnitEnum -> GBMMBTU, CapacityUnitEnum -> ISOMMBTU, CapacityUnitEnum -> USMMBTU] any = capacityUnit
        then (if frequency -> period = PeriodExtendedEnum -> D
            then DeliveryCapacity {
                    amount: quantity -> value / frequency -> periodMultiplier,
                    unit: EnergyQuantityUnit2Code -> MBTD
                })
        // CUBIC METERS
        else if capacityUnit = CBM
        then (if frequency -> period = PeriodExtendedEnum -> D
            then DeliveryCapacity {
                    amount: quantity -> value / frequency -> periodMultiplier,
                    unit: EnergyQuantityUnit2Code -> CMPD
                })
        else if capacityUnit = L
        then (if frequency -> period = PeriodExtendedEnum -> D
            then DeliveryCapacity {
                    amount: quantity -> value / (frequency -> periodMultiplier * 1000.0),
                    unit: EnergyQuantityUnit2Code -> CMPD
                })
        else if capacityUnit = HL
        then (if frequency -> period = PeriodExtendedEnum -> D
            then DeliveryCapacity {
                    amount: quantity -> value / (frequency -> periodMultiplier * 10.0),
                    unit: EnergyQuantityUnit2Code -> CMPD
                })
        else if capacityUnit = KL
        then (if frequency -> period = PeriodExtendedEnum -> D
            then DeliveryCapacity {
                    amount: quantity -> value / frequency -> periodMultiplier,
                    unit: EnergyQuantityUnit2Code -> CMPD
                })
        // JOULES
        else if capacityUnit = MJ
        then (if frequency -> period = PeriodExtendedEnum -> D
            then DeliveryCapacity {
                    amount: quantity -> value / frequency -> periodMultiplier,
                    unit: EnergyQuantityUnit2Code -> MJDD
                })
        else if capacityUnit = GJ
        then (if frequency -> period = PeriodExtendedEnum -> D
            then DeliveryCapacity {
                    amount: quantity -> value / frequency -> periodMultiplier,
                    unit: EnergyQuantityUnit2Code -> GJDD
                })
        // WATT*TIME UNITS
        else if capacityUnit = KWH
        then (if frequency -> period = PeriodExtendedEnum -> H
            then DeliveryCapacity {
                    amount: quantity -> value / frequency -> periodMultiplier,
                    unit: EnergyQuantityUnit2Code -> KWHH
                }
            else if frequency -> period = PeriodExtendedEnum -> D
            then DeliveryCapacity {
                    amount: quantity -> value / frequency -> periodMultiplier,
                    unit: EnergyQuantityUnit2Code -> KWHD
                })
        else if capacityUnit = MWH
        then (if frequency -> period = PeriodExtendedEnum -> H
            then DeliveryCapacity {
                    amount: quantity -> value / frequency -> periodMultiplier,
                    unit: EnergyQuantityUnit2Code -> MWHH
                }
            else if frequency -> period = PeriodExtendedEnum -> D
            then DeliveryCapacity {
                    amount: quantity -> value / frequency -> periodMultiplier,
                    unit: EnergyQuantityUnit2Code -> MWHD
                })
        else if capacityUnit = GWH
        then (if frequency -> period = PeriodExtendedEnum -> H
            then DeliveryCapacity {
                    amount: quantity -> value / frequency -> periodMultiplier,
                    unit: EnergyQuantityUnit2Code -> GWHH
                }
            else if frequency -> period = PeriodExtendedEnum -> D
            then DeliveryCapacity {
                    amount: quantity -> value / frequency -> periodMultiplier,
                    unit: EnergyQuantityUnit2Code -> GWHD
                })
        // THERMAL UNITS
        else if [CapacityUnitEnum -> GBTHM, CapacityUnitEnum -> ISOTHM, CapacityUnitEnum -> USTHM] any = capacityUnit
        then (if frequency -> period = PeriodExtendedEnum -> D
            then DeliveryCapacity {
                    amount: quantity -> value / frequency -> periodMultiplier,
                    unit: EnergyQuantityUnit2Code -> THMD
                })

func GetUnderlyingIdentificationType:
    inputs:
        reportableEvent ReportableEventBase (1..1)
    output:
        result trade.underlier.UnderlyingIdentificationTypeEnum (0..1)
    alias product:
        if product.IsCreditSwaption(ProductForEvent(reportableEvent))
                or product.IsIRSwaption(ProductForEvent(reportableEvent))
        then underlier.UnderlierForProduct(ProductForEvent(reportableEvent)) -> Product -> NonTransferableProduct
        else ProductForEvent(reportableEvent)
    set result:
        if underlier.UnderlierForProduct(product) -> Observable -> Basket exists
                or EconomicTermsForProduct(product) -> payout -> CreditDefaultPayout -> generalTerms -> basketReferenceInformation exists
                or EconomicTermsForProduct(
                        underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                    ) -> payout -> CreditDefaultPayout -> generalTerms -> basketReferenceInformation exists
        then trade.underlier.UnderlyingIdentificationTypeEnum -> B
        else if underlier.UnderlierProductIdentifier(product, ISIN) exists
        then trade.underlier.UnderlyingIdentificationTypeEnum -> I
        else if underlier.UnderlierForProduct(product) -> Observable -> Index exists
                or EconomicTermsForProduct(product) -> payout -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation exists
                or EconomicTermsForProduct(
                        underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                    ) -> payout -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation exists
                    // IR Swaps floating or inflation rate
                or (Qualify_AssetClass_InterestRate(EconomicTermsForProduct(product))
                    and (EconomicTermsForProduct(product) -> payout -> InterestRatePayout -> rateSpecification -> FloatingRateSpecification exists
                        or EconomicTermsForProduct(product) -> payout -> InterestRatePayout -> rateSpecification -> InflationRateSpecification exists))
                or Qualify_InterestRate_Fra(EconomicTermsForProduct(product))
                    // ETD Option on Futures on Index
                or (product.IsProductETD(product)
                    and underlier.UnderlierForProduct(
                            underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                        ) -> Observable -> Index exists)
        then trade.underlier.UnderlyingIdentificationTypeEnum -> X

func GetExpirationDate:
    inputs:
        transactionReportInstruction TransactionReportInstruction (1..1)
    output:
        expirationDate date (0..1)

    alias product: ProductForEvent(transactionReportInstruction)
    alias fixingDates: InterestRateLeg2(product) -> resetDates -> fixingDates
    alias periodMultiplier:
        if fixingDates -> periodMultiplier exists
        then fixingDates -> periodMultiplier
        else 0

    set expirationDate:
        if Qualify_InterestRate_Fra(product -> economicTerms)
        then AddBusinessDays(
                    cde.datetime.EffectiveDate(transactionReportInstruction),
                    periodMultiplier,
                    fixingDates -> businessCenters -> businessCenter
                )
        else cde.datetime.ExpirationDate(product)

func GetReportTrackingNumber:
    inputs:
        reportableEvent ReportableEventBase (1..1)
    output:
        reportingTrackingNumber string (0..1)

    alias role:
        FilterPartyRole(
                TradeForEvent(reportableEvent) -> partyRole,
                PartyRoleEnum -> ExecutionFacility
            ) -> partyReference only-element

    set reportingTrackingNumber:
        TradeForEvent(reportableEvent) -> tradeIdentifier
            filter issuerReference = role
            then extract assignedIdentifier -> identifier
            then flatten
            then if item exists then item else "RTNNotProvided"
            then only-element

// TH 28/03/25 Update: Supervisory Body input unbounded to accept multiple supervisory bodies
func GetRegimeSpecificIdentifiers:
    inputs:
        reportableInformation ReportableInformation (1..1)
        supervisoryBody SupervisoryBodyEnum (1..*)
        tradeIdentifierType TradeIdentifierTypeEnum (1..1)
    output:
        regimeSpecificIdentifiers string (0..*)

    alias regimeTransactionIds:
        reportableInformation -> jurisdictionInformation
            then filter supervisoryBody any = item -> supervisoryBody
            then transactionInformation -> transactionIdentifier
                filter identifierType = tradeIdentifierType

    add regimeSpecificIdentifiers:
        if regimeTransactionIds exists
        then regimeTransactionIds -> assignedIdentifier -> identifier

func IsRegulatedMarketOrThirdCountryEquivalentMarket: <"Returns True if the venue of execution of the trade is populated with a MIC code of a trading venue that was a regulated market or a third-country market considered as equivalent.">
    inputs:
        reportableInformation ReportableInformation (1..1)
        regime RegimeNameEnum (1..1)
    output:
        result boolean (1..1)

    alias getMic:
        GetOrFetchMicData(
                reportableInformation -> enrichment -> micData,
                GetVenueOfExecution(reportableInformation)
            )

    set result:
        if regime = RegimeNameEnum -> EMIR
        then (getMic -> marketCategoryEsma = MicMarketCategoryEnum -> RMKT // executed in a regulated market
                or IsESMAThirdCountryEquivalentMarket(getMic -> mic) = True // executed in a third country market considered as equivalent to regulated market
                )
        else if regime = RegimeNameEnum -> UKEMIR
        then (getMic -> marketCategoryFca = MicMarketCategoryEnum -> RMKT // executed in a regulated market
                or IsFCAThirdCountryEquivalentMarket(getMic -> mic) = True // executed in a third country market considered as equivalent to regulated market
                )
        else False

func GetModificationTimestamp:
    inputs:
        reportableEvent ReportableEvent (1..1)
    output:
        modificationTime zonedDateTime (0..1)

    set modificationTime:
        reportableEvent -> originatingWorkflowStep -> timestamp
            filter qualification = EventTimestampQualificationEnum -> executionDateTime
            then extract dateTime
            then max

func ExtractProductIdentifierBySource: <"This function extracts the identifiers as per the order prescribed 1. REDID, 2. CUSIP or 3. SEDOL, 4. RIC, 5. Sicovam, 6. FIGI, 7. BBGTICKER, 8. Name ">
    inputs:
        productIdentifiers AssetIdentifier (0..*)
    output:
        productIdentifier AssetIdentifier (0..1)

    alias orderedSources:
        [AssetIdTypeEnum -> REDID, AssetIdTypeEnum -> CUSIP, AssetIdTypeEnum -> SEDOL, AssetIdTypeEnum -> RIC, AssetIdTypeEnum -> Sicovam, AssetIdTypeEnum -> FIGI, AssetIdTypeEnum -> BBGTICKER, AssetIdTypeEnum -> Name]

    set productIdentifier:
        orderedSources
            extract src [
                productIdentifiers
                    filter identifierType = src
                    then first
            ]
            then first
                    // if no matches then default to the first in the list
                    default productIdentifiers first

func GetUnderlierProductIdentifierLeg1: <"Extracts a product identifier from the product underlier of leg 1.">
    inputs:
        product NonTransferableProduct (1..1)
    output:
        productId AssetIdentifier (0..*)
    alias swaptionsProductId:
        if underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct -> identifier exists
        then underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct -> identifier

    add productId:
        // Every underlier for Options and Forwards
        if underlier.UnderlierForProduct(product) exists
        then underlier.UnderlierForProduct(product)
        else if EconomicTermsForProduct(product) -> payout -> PerformancePayout -> underlier exists
        then EconomicTermsForProduct(product) -> payout -> PerformancePayout -> underlier
            then Observable
            then extract
                if Asset -> Instrument -> Security exists
                then Asset -> Instrument -> Security -> identifier
                else if Asset -> Instrument -> Loan exists
                then Asset -> Instrument -> Loan -> identifier
                else if Index exists
                then Index ->> identifier
                else if Basket exists
                then Basket -> identifier
            then flatten

    add productId:
        // Commodities
        if EconomicTermsForProduct(product) -> payout -> PerformancePayout -> underlier exists
        then EconomicTermsForProduct(product) -> payout -> PerformancePayout -> underlier -> Observable -> Asset -> Commodity -> identifier
        else if product.IsCommoditySwaption(product)
                and CommodityLeg1(
                        underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                    ) -> underlier -> Observable -> Asset -> Commodity -> identifier exists
        then CommodityLeg1(
                    underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                ) -> underlier -> Observable -> Asset -> Commodity -> identifier
        else if product.IsCommoditySwap(product)
                and CommodityLeg1(product) -> underlier -> Observable -> Asset -> Commodity -> identifier exists
        then CommodityLeg1(product) -> underlier -> Observable -> Asset -> Commodity -> identifier
        else if CommodityLeg1(product) -> underlier -> Observable -> Basket -> identifier exists
        then CommodityLeg1(product) -> underlier -> Observable -> Basket -> identifier
        // Commodities Index
        else if CommodityLeg1(product) -> underlier -> Observable -> Index exists
        then CommodityLeg1(product) -> underlier -> Observable -> Index ->> identifier
        // // IR on bond
        else if InterestRateLeg1(product) -> bondReference -> bond -> identifier exists
        then InterestRateLeg1(product) -> bondReference -> bond -> identifier
        // // Option on Futures on Index
        else if underlier.UnderlierForProduct(
                underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
            ) -> Observable -> Index exists
        then underlier.UnderlierForProduct(
                    underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                ) -> Observable -> Index ->> identifier

    add productId:
        // Swaptions
        swaptionsProductId
            filter source to-enum AssetIdTypeEnum exists
            then extract
                AssetIdentifier {
                    identifier: identifier,
                    identifierType: source to-enum AssetIdTypeEnum
                }

func GetUnderlierProductIdentifierLeg2: <"Extracts a product identifier from the product underlier of leg 2.">
    inputs:
        product NonTransferableProduct (1..1)
    output:
        productId AssetIdentifier (0..*)

    add productId:
        if EconomicTermsForProduct(product) -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> referenceObligation exists
        then EconomicTermsForProduct(product) -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> referenceObligation
        else if EconomicTermsForProduct(
                underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
            ) -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> referenceObligation exists
        then EconomicTermsForProduct(
                    underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                ) -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> referenceObligation
            then extract
                if security exists
                then security -> identifier
                else if loan exists
                then loan -> identifier
            then flatten

    add productId:
        // Commodities
        if product.IsCommoditySwaption(product)
                and CommodityLeg2(
                        underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                    ) -> underlier -> Observable -> Asset -> Commodity -> identifier exists
        then CommodityLeg2(
                    underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                ) -> underlier -> Observable -> Asset -> Commodity -> identifier
        else if product.IsCommoditySwap(product)
                and CommodityLeg2(product) -> underlier -> Observable -> Asset -> Commodity -> identifier exists
        then CommodityLeg2(product) -> underlier -> Observable -> Asset -> Commodity -> identifier
        else if CommodityLeg2(product) -> underlier -> Observable -> Basket -> identifier exists
        then CommodityLeg2(product) -> underlier -> Observable -> Basket -> identifier
        // Commodities Index
        else if CommodityLeg2(product) -> underlier -> Observable -> Index exists
        then CommodityLeg2(product) -> underlier -> Observable -> Index ->> identifier
        // IR on bond
        else if InterestRateLeg2(product) -> bondReference -> bond exists
        then InterestRateLeg2(product) -> bondReference -> bond -> identifier

func GetOtherUnderlierLeg1: <"Extracts the underlier ID Other leg 1 from Interest Rate and Foreign Exchange products.">
    inputs:
        product NonTransferableProduct (1..1)
    output:
        otherId string (0..1)

    set otherId:
        if IsFRA(product)
                and InterestRateLeg1(product) -> rateSpecification -> FloatingRateSpecification -> rateOption -> FloatingRateIndex -> name is absent
        then InterestRateLeg1(product) -> rateSpecification -> FloatingRateSpecification -> rateOption -> FloatingRateIndex -> name
        else if product.IsFXForward(product) or product.IsFXOption(product)
        then ConvertCurrency(FXLeg1(product, empty) -> quantity -> unit -> currency)
        else if product.IsFXSwap(product)
        then ConvertCurrency(FXSwapLeg1(product, empty) -> quantity -> unit -> currency)

func GetOtherUnderlierLeg2: <"Extracts the underlier ID Other leg 2 from Interest Rate and Foreign Exchange products.">
    inputs:
        product NonTransferableProduct (1..1)
    output:
        otherId string (0..1)

    alias economicTerms: EconomicTermsForProduct(product)

    set otherId:
        if (economicTerms -> payout only-element -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation exists
                and economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation -> name is absent)
        then economicTerms -> payout only-element -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation -> name
        else if (EconomicTermsForProduct(
                    underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                ) -> payout only-element -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation exists
                and EconomicTermsForProduct(
                        underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                    ) -> payout -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation -> name is absent)
        then EconomicTermsForProduct(
                    underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                ) -> payout only-element -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation -> name
        else if IsFRA(product)
                and InterestRateLeg2(product) -> rateSpecification -> FloatingRateSpecification -> rateOption -> FloatingRateIndex -> name is absent
        then InterestRateLeg2(product) -> rateSpecification -> FloatingRateSpecification -> rateOption -> FloatingRateIndex -> name
        else if product.IsFXForward(product) or product.IsFXOption(product)
        then ConvertCurrency(FXLeg2(product, empty) -> quantity -> unit -> currency)
        else if product.IsFXSwap(product)
        then ConvertCurrency(FXSwapLeg2(product, empty) -> quantity -> unit -> currency)

func FilterResetHistoryByLeg: <"Extracts the reset history belonging to a leg by filtering the observations of the reset history's product identifier that match with the leg's product identifier.">
    inputs:
        reportableEvent ReportableEventBase (1..1)
        payoutLeg PayoutLegWithAuxiliary (1..1)
    output:
        resetHistory Reset (0..*)

    add resetHistory:
        if TradeStateForEvent(reportableEvent) -> resetHistory -> observations -> observationIdentifier -> observable -> Index -> InterestRateIndex exists
        then TradeStateForEvent(reportableEvent) -> resetHistory
            filter
                (observations -> observationIdentifier -> observable -> Index -> InterestRateIndex -> FloatingRateIndex any = payoutLeg -> interestRatePayout -> rateSpecification -> FloatingRateSpecification -> rateOption -> FloatingRateIndex
                    or observations -> observationIdentifier -> observable -> Index -> InterestRateIndex -> InflationIndex any = payoutLeg -> interestRatePayout -> rateSpecification -> FloatingRateSpecification -> rateOption -> InflationIndex)
        else if TradeStateForEvent(reportableEvent) -> resetHistory -> observations -> observationIdentifier -> observable -> Asset -> Commodity -> identifier exists
        then TradeStateForEvent(reportableEvent) -> resetHistory
            filter
                observations -> observationIdentifier -> observable -> Asset -> Commodity -> identifier = payoutLeg -> commodityPayout -> underlier -> Observable -> Asset -> Commodity -> identifier

func GetLastFloatingReferenceResetDate: <"Extracts the last reset date filtering by the current date.">
    inputs:
        resetHistory Reset (1..*)
    output:
        lastFloatingReferenceResetDate date (0..1)

    set lastFloatingReferenceResetDate:
        resetHistory
            filter resetDate <= Today
            then resetDate
            then max

func GetLastFloatingReferenceValue: <"Extracts the last reset value filtering by the current date.">
    inputs:
        resetHistory Reset (1..*)
    output:
        lastFloatingReferenceValue number (0..1)

    set lastFloatingReferenceValue:
        resetHistory
            filter item -> resetDate <= Today
            then max [ item -> resetDate ]
            then item -> resetValue -> value

func ExtractReferenceEntity: <"For Credit Default Swaps or Credit Swaptions, extracts the reference entity that contains an LEI or CountryCode entityId, or if neither exists, returns any reference entity id.">
    inputs:
        reportableEvent ReportableEventBase (0..1)
    output:
        referenceEntity EntityIdentifier (0..1)

    alias product: ProductForEvent(reportableEvent)

    alias referenceEntityProduct:
        if product.IsCreditSwaption(product)
        then underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> referenceEntity
        else if product.IsCredit(product)
        then product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> referenceEntity

    alias referenceEntityByType:
        referenceEntityProduct -> entityIdentifier
            then filter
                ([EntityIdentifierTypeEnum -> LEI, EntityIdentifierTypeEnum -> CountryCode] any = identifierType)

    set referenceEntity:
        if referenceEntityByType exists
        then referenceEntityByType
        else referenceEntityProduct -> entityIdentifier
            then last

func ExtractCommodityClassification: <"Extracts a commodity classification value from the product taxonomy of the commodity underlier, filtered by taxonomy source and ordinal.">
    inputs:
        economicTerms EconomicTerms (1..1)
        taxonomySource TaxonomySourceEnum (1..1)
        ordinal int (1..1)
    output:
        commodityClassification string (0..1)

    alias commodityUnderlier:
        if Qualify_Commodity_Swap_FixedFloat(economicTerms)
                or Qualify_Commodity_Swap_Basis(economicTerms)
        then economicTerms -> payout -> CommodityPayout first -> underlier -> Observable -> Asset -> Commodity
        else if Qualify_Commodity_Option(economicTerms)
        then economicTerms -> payout -> OptionPayout only-element -> underlier -> Observable -> Asset -> Commodity
        else if Qualify_Commodity_Swaption(economicTerms)
        then EconomicTermsForProduct(
                    economicTerms -> payout -> OptionPayout only-element -> underlier -> Product -> NonTransferableProduct
                ) -> payout -> CommodityPayout first -> underlier -> Observable -> Asset -> Commodity
        else if Qualify_Commodity_Forward(economicTerms)
        then economicTerms -> payout -> SettlementPayout only-element -> underlier -> Observable -> Asset -> Commodity
        else economicTerms -> payout -> CommodityPayout only-element -> underlier -> Observable -> Asset -> Commodity

    alias taxonomy: commodityUnderlier -> taxonomy filter item -> source = taxonomySource

    set commodityClassification:
        taxonomy only-element -> value -> classification
            filter item -> ordinal = ordinal
            then only-element -> value

func ExtractCommodityClassificationLeg1: <"Extracts leg 1 commodity classification value from the product taxonomy of the commodity underlier, filtered by taxonomy source and ordinal.">
    inputs:
        product NonTransferableProduct (1..1)
        taxonomySource TaxonomySourceEnum (1..1)
        ordinal int (1..1)
    output:
        commodityClassification string (0..1)

    alias commodityUnderlier:
        if Qualify_Commodity_Option(EconomicTermsForProduct(product))
        then underlier.UnderlierForProduct(product) -> Observable -> Asset -> Commodity
        else if product.IsCommoditySwaption(product)
                and CommodityLeg1(
                        underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                    ) -> underlier -> Observable -> Asset -> Commodity exists
        then CommodityLeg1(
                    underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                ) -> underlier -> Observable -> Asset -> Commodity
        else if product.IsCommoditySwap(product)
                and CommodityLeg1(product) -> underlier -> Observable -> Asset -> Commodity exists
        then CommodityLeg1(product) -> underlier -> Observable -> Asset -> Commodity
        else if product.IsCommodityFloatingPriceForward(product)
        then EconomicTermsForProduct(product) -> payout -> CommodityPayout only-element -> underlier -> Observable -> Asset -> Commodity

    alias taxonomy: commodityUnderlier -> taxonomy filter item -> source = taxonomySource

    set commodityClassification:
        taxonomy only-element -> value -> classification
            filter item -> ordinal = ordinal
            then only-element -> value

func ExtractCommodityClassificationLeg2: <"Extracts leg 2 commodity classification value from the product taxonomy of the commodity underlier, filtered by taxonomy source and ordinal.">
    inputs:
        product NonTransferableProduct (1..1)
        taxonomySource TaxonomySourceEnum (1..1)
        ordinal int (1..1)
    output:
        commodityClassification string (0..1)

    alias commodityUnderlier:
        if product.IsCommoditySwaption(product)
                and CommodityLeg2(
                        underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                    ) -> underlier -> Observable -> Asset -> Commodity exists
        then CommodityLeg2(
                    underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct
                ) -> underlier -> Observable -> Asset -> Commodity
        else if product.IsCommoditySwap(product)
                and CommodityLeg2(product) -> underlier -> Observable -> Asset -> Commodity exists
        then CommodityLeg2(product) -> underlier -> Observable -> Asset -> Commodity
        else if Qualify_Commodity_Forward(EconomicTermsForProduct(product)) // Description of the commodity delivered is found within the forwardPayout
        then EconomicTermsForProduct(product) -> payout -> SettlementPayout only-element -> underlier -> Observable -> Asset -> Commodity

    alias taxonomy: commodityUnderlier -> taxonomy filter item -> source = taxonomySource

    set commodityClassification:
        taxonomy only-element -> value -> classification
            filter item -> ordinal = ordinal
            then only-element -> value

func IsCreditTotalReturnSwap: <"Evaluates a product as Credit Total Return Swap when the product qualifies a product as a Credit based on the economic terms and the following criteria: 1) A product with one performance leg and one interest leg, 2) the underlier is either a loan, a security or index">
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    alias performanceUnderlier:
        EconomicTermsForProduct(product) -> payout -> PerformancePayout only-element -> underlier

    set result:
        Qualify_AssetClass_Credit(EconomicTermsForProduct(product)) = True
            and ((EconomicTermsForProduct(product) -> payout -> InterestRatePayout exists
                and EconomicTermsForProduct(product) -> payout -> PerformancePayout exists)
                and (if performanceUnderlier exists
                    then (performanceUnderlier -> Observable -> Asset -> Instrument -> Loan exists
                            or performanceUnderlier -> Observable -> Asset -> Instrument -> Security -> instrumentType = InstrumentTypeEnum -> Debt
                            or performanceUnderlier -> Observable -> Index exists)
                    else True))

func AdjustFrequencyPeriod:
    inputs:
        period FrequencyPeriodEnum (0..1)
        periodMultiplier number (0..1)
    output:
        periodValues QuantityFrequency (0..1)
    set periodValues:
        QuantityFrequency {
            period: if period = MNTH and periodMultiplier = 12
                    then YEAR
                else period,
            periodMultiplier: if period = MNTH and periodMultiplier = 12
                    then 1
                else periodMultiplier
        }

func GetTransactionInformationForRegime:
    inputs:
        transaction TransactionReportInstruction (0..1)
        regime RegimeNameEnum (0..1)
        supervisoryBodyIn SupervisoryBodyEnum (0..1)
    output:
        transactionInformation ReportableJurisdictionInformation (0..1)

    set transactionInformation:
        transaction -> reportableInformation -> jurisdictionInformation
            then filter
                regimeName = regime
                    and (supervisoryBody = supervisoryBodyIn or supervisoryBodyIn is absent)
            then only-element

func GetIsin:
    inputs:
        product NonTransferableProduct (0..1)
    output:
        isin string (0..1)

    set isin:
        product
            then extract [
                identifier
                    filter source = ProductIdTypeEnum -> ISIN
                    then only-element
                    then extract identifier
            ]

func GetInstrumentType: <"Extracts the Instrument Type attribute from ANNA DSB record template depending on the product.">
    inputs:
        reportableEvent ReportableEventBase (1..1)
    output:
        instrumentType upi.AnnaDsbInstrumentTypeEnum (0..1)

    alias product: ProductForEvent(reportableEvent)

    alias economicTerms: product -> economicTerms

    alias isdaTaxonomy:
        product -> taxonomy
            filter source = ISDA and value -> name exists
            then first
            then value -> name

    alias isOption: product.IsOption(product)

    set instrumentType:
        if isOption
                or Qualify_InterestRate_CapFloor(economicTerms)
                or Qualify_CreditDefaultSwaption(economicTerms)
        then Option
        else if Qualify_ForeignExchange_Swap(economicTerms)
                or Qualify_ForeignExchange_NDS(economicTerms)
                or Qualify_BaseProduct_EquitySwap(economicTerms)
                or Qualify_BaseProduct_IRSwap(economicTerms)
                or Qualify_BaseProduct_CrossCurrency(economicTerms)
                or Qualify_BaseProduct_Inflation(economicTerms)
                or Qualify_CreditDefaultSwap_SingleName(economicTerms)
                or Qualify_CreditDefaultSwap_Basket(economicTerms)
                or Qualify_CreditDefaultSwap_Index(economicTerms)
                or Qualify_CreditDefaultSwap_IndexTranche(economicTerms)
                or Qualify_CreditDefaultSwap_Loan(economicTerms)
                or (IsCreditTotalReturnSwap(product) or StringContains(isdaTaxonomy, "^Credit:TotalReturnSwap.*"))
                or product.IsCommoditySwap(product)
                or Qualify_Commodity_Swap_FixedFloat(economicTerms)
                or Qualify_Commodity_Swap_Basis(economicTerms)
                or product.IsEquitySwapProduct(product)
                or product.IsDividendSwap(product)
                or (product.IsVarianceSwap(product)
                    and Qualify_ForeignExchange_ParameterReturnVariance(economicTerms) = False)
                or (product.IsVolatilitySwap(product)
                    and Qualify_ForeignExchange_ParameterReturnVolatility(economicTerms) = False)
                or Qualify_EquitySwap_TotalReturnBasicPerformance_Basket(economicTerms)
                or Qualify_EquitySwap_TotalReturnBasicPerformance_Index(economicTerms)
                or Qualify_EquitySwap_TotalReturnBasicPerformance_SingleName(economicTerms)
                or Qualify_EquitySwap_PriceReturnBasicPerformance_Basket(economicTerms)
                or Qualify_EquitySwap_PriceReturnBasicPerformance_Index(economicTerms)
                or Qualify_EquitySwap_PriceReturnBasicPerformance_SingleName(economicTerms)
        then Swap
        else if Qualify_BaseProduct_Fra(economicTerms)
                or Qualify_InterestRate_Forward_Debt(economicTerms)
                or product.IsFXForward(product)
                or Qualify_ForeignExchange_NDF(economicTerms)
                or Qualify_ForeignExchange_Spot_Forward(economicTerms)
                or Qualify_Commodity_Forward(economicTerms)
                or isdaTaxonomy = "InterestRate:Forward:Debt"
                or product.IsEquityForward(product)
                or Qualify_EquityForward_PriceReturnBasicPerformance_Basket(economicTerms)
                or Qualify_EquityForward_PriceReturnBasicPerformance_SingleIndex(
                        economicTerms
                    )
                or Qualify_EquityForward_PriceReturnBasicPerformance_SingleName(
                        economicTerms
                    )
        then Forward
        else Other

func GetDSBRecord: <"Extracts the Use Case attribute from ANNA DSB record template depending on the product.">
    inputs:
        reportableEvent ReportableEventBase (1..1)
    output:
        useCase upi.AnnaDsbUseCaseEnum (0..1)

    alias product: ProductForEvent(reportableEvent)
    alias economicTerms: product -> economicTerms
    alias isdaTaxonomy:
        product -> taxonomy
            filter source = ISDA and value -> name exists
            then first
            then value -> name

    set useCase:
        if isdaTaxonomy = "ForeignExchange:SimpleExotic:Digital"
        then Digital_Option
        else if isdaTaxonomy = "ForeignExchange:SimpleExotic:Barrier"
        then Barrier_Option
        else if isdaTaxonomy = "ForeignExchange:NDO"
        then NDO
        else if isdaTaxonomy = "ForeignExchange:ComplexExotic"
        then Non_Standard
        else if Qualify_ForeignExchange_VanillaOption(economicTerms)
        then Vanilla_Option
        else if Qualify_ForeignExchange_Spot_Forward(economicTerms)
        then Forward
        else if Qualify_ForeignExchange_Swap(economicTerms)
        then FX_Swap
        else if Qualify_ForeignExchange_NDS(economicTerms)
        then Non_Deliverable_FX_Swap
        else if Qualify_ForeignExchange_NDF(economicTerms)
        then NDF
        else if isdaTaxonomy = "InterestRate:Exotic"
        then Non_Standard
        else if isdaTaxonomy = "InterestRate:Forward:Debt"
        then Debt
        else if isdaTaxonomy = "InterestRate:FRA"
        then FRA_Index
        else if Qualify_InterestRate_IRSwap_FixedFloat(economicTerms)
        then Fixed_Float
        else if Qualify_InterestRate_IRSwap_FixedFixed(economicTerms)
        then Fixed_Fixed
        else if Qualify_InterestRate_InflationSwap_FixedFloat_YearOn_Year(economicTerms)
        then Inflation_Fixed_Float_YoY
        else if Qualify_InterestRate_InflationSwap_FixedFloat_ZeroCoupon(economicTerms)
        then Inflation_Fixed_Float_Zero_Coupon
        else if Qualify_InterestRate_InflationSwap_Basis_YearOn_Year(economicTerms)
        then Inflation_Basis_YoY
        else if Qualify_InterestRate_InflationSwap_Basis_ZeroCoupon(economicTerms)
        then Inflation_Basis_Zero_Coupon
        else if Qualify_BaseProduct_Inflation(economicTerms)
        then Inflation_Swap
        else if Qualify_InterestRate_CrossCurrency_FixedFixed(economicTerms)
        then Cross_Currency_Fixed_Fixed
        else if Qualify_InterestRate_CrossCurrency_FixedFloat(economicTerms)
        then Cross_Currency_Fixed_Float
        else if Qualify_InterestRate_IRSwap_Basis(economicTerms)
        then Basis
        else if Qualify_InterestRate_IRSwap_Basis_OIS(economicTerms)
        then Basis_OIS
        else if Qualify_InterestRate_IRSwap_FixedFloat_ZeroCoupon(economicTerms)
        then Fixed_Float_Zero_Coupon
        else if Qualify_InterestRate_IRSwap_FixedFloat_OIS(economicTerms)
        then Fixed_Float_OIS
        else if Qualify_InterestRate_CrossCurrency_Basis(economicTerms)
        then Cross_Currency_Basis
        else if Qualify_InterestRate_Option_Swaption(economicTerms)
        then Swaption
        else if Qualify_InterestRate_CapFloor(economicTerms)
        then CapFloor
        else if Qualify_InterestRate_Option_DebtOption(economicTerms)
        then Debt_Option
        else if Qualify_CreditDefaultSwap_Loan(economicTerms)
        then Loan
        else if Qualify_CreditDefaultSwap_Index(economicTerms)
        then Index
        else if Qualify_CreditDefaultSwap_IndexTranche(economicTerms)
        then Index_Tranche
        else if Qualify_CreditDefaultSwaption(economicTerms)
        then (if Qualify_CreditDefaultSwap_SingleName(
                        underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct -> economicTerms
                    )
            then Single_Name_Swaption
            else if Qualify_CreditDefaultSwap_Index(
                        underlier.UnderlierForProduct(product) -> Product -> NonTransferableProduct -> economicTerms
                    )
            then Index_Swaption)
        else if StringContains(isdaTaxonomy, "^Credit:SingleName:Corporate:.*")
        then Corporate
        else if StringContains(isdaTaxonomy, "^Credit:SingleName:Sovereign:.*")
        then Sovereign
        else if StringContains(isdaTaxonomy, "^Credit:SingleName:Muni:.*")
        then Municipal
        else if StringContains(isdaTaxonomy, "^Credit:TotalReturnSwap.*")
        then Total_Return_Swap
        else if StringContains(isdaTaxonomy, "^Credit:Exotic.*")
        then Non_Standard
        else if Qualify_Commodity_Swap_FixedFloat(economicTerms)
                or Qualify_Commodity_Swap_Basis(economicTerms)
        then Swap
        else if Qualify_Commodity_Swaption(economicTerms)
        then Swaption
        else if Qualify_Commodity_Option(economicTerms)
        then Option
        else if Qualify_Commodity_Forward(economicTerms)
        then Forward

func GetDeliveryTypeDSBRecord: <"Extracts the Delivery Type attribute from ANNA DSB record template depending on the product.">
    inputs:
        reportableEvent ReportableEventBase (1..1)
    output:
        deliveryType upi.AnnaDsbDeliveryTypeEnum (0..1)

    alias product: ProductForEvent(reportableEvent)
    alias economicTerms: product -> economicTerms
    alias instrumentType: GetInstrumentType(reportableEvent)
    alias useCase: GetDSBRecord(reportableEvent)

    alias isdaTaxonomy:
        product -> taxonomy
            filter source = ISDA and value -> name exists
            then first
            then value -> name

    alias settlementTerms:
        [economicTerms -> payout -> SettlementPayout -> settlementTerms, economicTerms -> payout -> OptionPayout -> settlementTerms, economicTerms -> payout -> InterestRatePayout -> settlementTerms, economicTerms -> payout -> CreditDefaultPayout -> settlementTerms]
            first

    set deliveryType:
        if useCase = NDF or useCase = NDO
        then empty
        else if Qualify_ForeignExchange_NDS(economicTerms)
        then CASH
        else if Qualify_ForeignExchange_Swap(economicTerms)
        then PHYS
        else if (settlementTerms -> settlementType = SettlementTypeEnum -> Cash)
        then CASH
        else if (settlementTerms -> settlementType = SettlementTypeEnum -> CashOrPhysical)
        then OPTL
        else if (settlementTerms -> settlementType = SettlementTypeEnum -> Physical)
        then PHYS
        else if (settlementTerms -> settlementType = SettlementTypeEnum -> Election)
        then OPTL
        else if (settlementTerms -> physicalSettlementTerms is absent and settlementTerms -> cashSettlementTerms exists)
        then CASH
        else if (settlementTerms -> physicalSettlementTerms exists and settlementTerms -> cashSettlementTerms exists)
        then OPTL
        else if (settlementTerms -> physicalSettlementTerms exists and settlementTerms -> cashSettlementTerms is absent)
        then PHYS
        else if instrumentType = Option or instrumentType = Forward
        then PHYS
        else if Qualify_BaseProduct_IRSwap(economicTerms)
                or Qualify_BaseProduct_CrossCurrency(economicTerms)
                or Qualify_BaseProduct_Inflation(economicTerms)
        then PHYS
        else if Qualify_AssetClass_Credit(economicTerms)
        then OPTL
        else CASH // In-case CDM does not have the settlement type information, we default to CASH

func IsNotionalScheduleCustom: <"Identifies if the Notional Schedule attribute from ANNA DSB record template is Constant or Custom.">
    inputs:
        reportableEvent ReportableEventBase (1..1)
    output:
        result upi.AnnaDsbNotionalScheduleEnum (0..1)

    alias product: ProductForEvent(reportableEvent)
    alias economicTerms: EconomicTermsForProduct(product)

    alias leg1:
        if Qualify_BaseProduct_IRSwap(economicTerms)
                or Qualify_BaseProduct_Inflation(economicTerms)
                or Qualify_BaseProduct_CrossCurrency(economicTerms)
        then Compute_NotionalScheduleType(
                    quantity.QuantitySchedule(PayoutLeg1(reportableEvent)) -> datedValue -> value
                )

    alias leg2:
        if Qualify_BaseProduct_IRSwap(economicTerms)
                or Qualify_BaseProduct_Inflation(economicTerms)
                or Qualify_BaseProduct_CrossCurrency(economicTerms)
        then Compute_NotionalScheduleType(
                    quantity.QuantitySchedule(PayoutLeg2(reportableEvent)) -> datedValue -> value
                )
    set result:
        if Qualify_BaseProduct_IRSwap(economicTerms)
                or Qualify_BaseProduct_Inflation(economicTerms)
                or Qualify_BaseProduct_CrossCurrency(economicTerms)
        then (if product.IsOption(product)
            then empty
            else if leg1 exists and leg1 = leg2
            then leg1
            else upi.AnnaDsbNotionalScheduleEnum -> Custom)

func IsUnderlyingAssetTypeFixedFixed: <"Identifies if the Underlying Asset Type attribute from ANNA DSB record template is Fixed-Fixed.">
    inputs:
        reportableEvent ReportableEventBase (1..1)
    output:
        result boolean (0..1)

    alias product: ProductForEvent(reportableEvent)
    alias economicTerms: EconomicTermsForProduct(product)

    set result:
        Qualify_InterestRate_CrossCurrency_FixedFixed(economicTerms)
            or Qualify_InterestRate_IRSwap_FixedFixed(economicTerms)

func IsUnderlyingAssetTypeIndex: <"Identifies if the Underlying Asset Type attribute from ANNA DSB record template is Index.">
    inputs:
        reportableEvent ReportableEventBase (1..1)
    output:
        result boolean (0..1)

    alias product: ProductForEvent(reportableEvent)
    alias economicTerms: EconomicTermsForProduct(product)

    set result:
        Qualify_CreditDefaultSwap_Index(economicTerms)
            or IsCreditTotalReturnSwap(product)
            or Qualify_InterestRate_IRSwap_FixedFixed(economicTerms)
            or product.IsCommoditySwap_SingleIndex(product)
            or product.IsCommodityForward_SingleIndex(product)
            or product.IsCommodityOption_SingleIndex(product)
            or product.IsCommoditySwaption(product)
            or Qualify_EquitySwap_ParameterReturnDividend_Index(economicTerms)
            or Qualify_EquitySwap_ParameterReturnVariance_Index(economicTerms)
            or Qualify_EquitySwap_ParameterReturnVolatility_Index(economicTerms)
            or Qualify_EquitySwap_TotalReturnBasicPerformance_Index(economicTerms)
            or Qualify_EquitySwap_PriceReturnBasicPerformance_Index(economicTerms)
            or Qualify_EquityForward_PriceReturnBasicPerformance_SingleIndex(economicTerms)
            or Qualify_BaseProduct_EquitySwap(economicTerms)
            or Qualify_EquityOption_PriceReturnBasicPerformance_Index(economicTerms)

func IsReturnorPayoutTriggerCFD: <"Identifies if the Return or Payout Trigger attribute from ANNA DSB record template is Contract for Difference.">
    inputs:
        reportableEvent ReportableEventBase (1..1)
    output:
        result boolean (0..1)

    alias product: ProductForEvent(reportableEvent)
    alias economicTerms: EconomicTermsForProduct(product)

    set result:
        Qualify_Commodity_Swap_Basis(economicTerms)
            or product.IsCommoditySwap(product)
            or product.IsEquitySwapProduct(product)

func IsCommodityMetal:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)

    alias productIdentifier:
        product -> identifier
            then filter
                identifier -> scheme = "http://www.fpml.org/coding-scheme/product-taxonomy"
            then only-element
            then extract identifier

    alias productTaxonomy:
        product -> taxonomy
            then filter source = ISDA
            then only-element
            then extract value -> name

    alias productClass:
        if productTaxonomy exists and productIdentifier exists
        then [productTaxonomy, productIdentifier] distinct only-element
        else if productTaxonomy exists
        then productTaxonomy
        else if productIdentifier exists
        then productIdentifier

    alias commodityReferencePrice:
        [
            underlier.UnderlierForProduct(product) -> Observable -> Asset -> Commodity -> identifier
                then filter identifierType = ISDACRP
                then only-element
                then extract identifier,
            EconomicTermsForProduct(product) -> payout -> CommodityPayout -> underlier -> Observable -> Asset -> Commodity -> identifier
                then filter identifierType = ISDACRP
                then only-element
                then extract identifier
        ]
            only-element

    set result:
        if productClass exists and commodityReferencePrice exists
        then StringContains(productClass, "Metals:NonPrecious")
                and IsCRPMetal(commodityReferencePrice)
        else if productClass exists and StringContains(productClass, "Metals:NonPrecious")
        then True
        else if commodityReferencePrice exists and IsCRPMetal(commodityReferencePrice)
        then True
        else False

func IsCommodityBullion:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)

    alias productIdentifier: // DRR
        product -> identifier
            then filter
                identifier -> scheme = "http://www.fpml.org/coding-scheme/product-taxonomy"
            then only-element
            then extract identifier

    alias productTaxonomy:
        product -> taxonomy
            then filter source = ISDA
            then only-element
            then extract value -> name

    alias productClass:
        if productTaxonomy exists and productIdentifier exists
        then [productTaxonomy, productIdentifier] distinct only-element
        else if productTaxonomy exists
        then productTaxonomy
        else if productIdentifier exists
        then productIdentifier

    alias commodityReferencePrice:
        [
            underlier.UnderlierForProduct(product) -> Observable -> Asset -> Commodity -> identifier
                then filter identifierType = ISDACRP
                then only-element
                then extract identifier,
            EconomicTermsForProduct(product) -> payout -> CommodityPayout -> underlier -> Observable -> Asset -> Commodity -> identifier
                then filter identifierType = ISDACRP
                then only-element
                then extract identifier
        ]
            only-element

    set result:
        if productClass exists and commodityReferencePrice exists
        then StringContains(productClass, "Metals:Precious")
                and IsCRPBullion(commodityReferencePrice)
        else if productClass exists and StringContains(productClass, "Metals:Precious")
        then True
        else if commodityReferencePrice exists and IsCRPBullion(commodityReferencePrice)
        then True
        else False

func IsCRPMetal:
    inputs:
        identifier string (1..1)
    output:
        result boolean (1..1)
    set result:
        StringContains(identifier, "ALUMINIUM-")
            or StringContains(identifier, "COPPER-")
            or StringContains(identifier, "IRON ORE-")
            or StringContains(identifier, "LEAD-")
            or StringContains(identifier, "NASAAC-")
            or StringContains(identifier, "NICKEL-")
            or StringContains(identifier, "STEEL-")
            or StringContains(identifier, "TIN-")
            or StringContains(identifier, "ZINC-")

func IsCRPBullion:
    inputs:
        identifier string (1..1)
    output:
        result boolean (1..1)
    set result:
        StringContains(identifier, "GOLD-")
            or StringContains(identifier, "PALLADIUM-")
            or StringContains(identifier, "PLATINUM-")
            or StringContains(identifier, "SILVER-")

func ExtractNatureOfCounterparty: <"Converts a NatureOfPartyEnum value into the corresponding NatureOfCounterpartyEnum value">
    inputs:
        natureOfParty NatureOfPartyEnum (1..1)
    output:
        natureOfCounterparty party.NatureOfCounterpartyEnum (1..1)
    set natureOfCounterparty:
        if natureOfParty = Financial
        then party.NatureOfCounterpartyEnum -> F
        else if natureOfParty = NonFinancial
        then N
        else if natureOfParty = CentralCounterparty
        then C
        else if natureOfParty = Exempt
        then O

func LimitBasketConstituents:
    [codeImplementation]
    inputs:
        basketConstituents basket.BasketConstituentsReport (0..*)
        maxNumber int (1..1)
    output:
        result basket.BasketConstituentsReport (0..*)

func FixedPriceLeg1:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        fixedPrice FixedPricePayout (0..1)

    set fixedPrice:
        if IsCommoditySwapFixedFloat(product) or IsCommodityFixedPriceForward(product)
        then EconomicTermsForProduct(product) -> payout -> FixedPricePayout only-element

func RegimePartySupervisoryBody:
    inputs:
        jurisdictionInformation ReportableJurisdictionInformation (0..*)
        supervisoryBody SupervisoryBodyEnum (0..1)
    output:
        partyReference Party (0..*)
    set partyReference:
        jurisdictionInformation
            then filter supervisoryBody = supervisoryBody
            then only-element
            then extract partyInformation -> partyReference

func EqualParty: <"Checks Party lists are equal, ignoring order">
    inputs:
        p1 Party (0..*)
        p2 Party (0..*)
    output:
        result boolean (0..1)

    alias sizeEqual: p1 count = p2 count
    alias containsAll:
        p1
            extract p2 any = item
            then all = True

    set result: sizeEqual and containsAll
