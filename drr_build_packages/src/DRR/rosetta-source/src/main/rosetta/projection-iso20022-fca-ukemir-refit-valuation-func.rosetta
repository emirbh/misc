            ntrl: if drrReport -> counterparty2IdentifierType = False
                    then NaturalPersonIdentification3__2 {
                        id:
                            NaturalPersonIdentification2__1 {
                                id:
                                    GenericIdentification175__2 {
                                        id: drrReport -> counterparty2
                        }},
                        ...
        }}

