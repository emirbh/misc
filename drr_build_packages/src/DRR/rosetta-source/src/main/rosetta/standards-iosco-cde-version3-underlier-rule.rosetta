namespace drr.standards.iosco.cde.version3.underlier
version "${project.version}"

import cdm.base.*
import cdm.base.staticdata.asset.common.*

import drr.base.*
import drr.base.qualification.*
import drr.base.trade.*
import drr.regulation.common.*
import drr.regulation.common.trade.* as common
import drr.standards.iosco.*
import drr.standards.iosco.cde.version3.* as cdeV3

reporting rule UnderlierProductIdentifierOther from TransactionReportInstructionBase: <"Underlier Product Identifier (Other)">
    if product.IsCreditSwaption(ProductForEvent) or product.IsIRSwaption(ProductForEvent)
    then underlier.UnderlierForProduct(ProductForEvent) -> Product -> NonTransferableProduct
    else ProductForEvent
        then extract
            if underlier.UnderlierProductIdentifier(item, ISIN) is absent
            then underlier.UnderlierProductIdentifier(item, empty)

reporting rule UnderlierIDOther from TransactionReportInstructionBase: <"Underlier ID (Other)">
    [docReference CPMI_IOSCO cdeV3.CDE section "2" field "102"
        provision "The asset(s), index (indices) or benchmark underlying a contract or, in the case of a foreign Exchange derivative, identification of index. This data element is applicable when the value of Underlier ID is submitted as OTHER to the UPI service provider."]
    UnderlierProductIdentifierOther -> identifier first

reporting rule UnderlierIDOtherLeg1 from TransactionReportInstructionBase: <"Underlier ID (Other) - Leg 1">
    [docReference CPMI_IOSCO cdeV3.CDE section "2" field "102"
        provision "The asset(s), index (indices) or benchmark underlying a contract or, in the case of a foreign Exchange derivative, identification of index. This data element is applicable when the value of Underlier ID is submitted as OTHER to the UPI service provider."]
    [docReference ISDA EUUKNAPeerReviewGroup date "20250402" field "Underlier ID (Other) - Leg 1"
        provision "For Credit Default Swaps, leg 1 is the interest rate. However, it is always a fixed rate; thus, for CDS no extraction of index is required at leg 1."]
    [docReference ISDA EUUKNAPeerReviewGroup date "20250417" field "Underlier ID (Other) - Leg 1"
        provision "For Foreign Exchange, the underlier is the currency of the notional, as it is expected for AnnaDsb."]
    extract ProductForEvent
    then extract
        if GetUnderlierProductIdentifierLeg1 exists
                and underlier.FilterAssetIdentifier(GetUnderlierProductIdentifierLeg1, ISIN)
                    is absent
        then GetUnderlierProductIdentifierLeg1 first -> identifier
        else if GetOtherUnderlierLeg1 exists
        then GetOtherUnderlierLeg1

reporting rule UnderlierIDOtherLeg2 from TransactionReportInstructionBase: <"Underlier ID (Other) - Leg 2">
    [docReference CPMI_IOSCO cdeV3.CDE section "2" field "102"
        provision "The asset(s), index (indices) or benchmark underlying a contract or, in the case of a foreign Exchange derivative, identification of index. This data element is applicable when the value of Underlier ID is submitted as OTHER to the UPI service provider."]
    [docReference ISDA EUUKNAPeerReviewGroup date "20250417" field "Underlier ID (Other) - Leg 2"
        provision "For Foreign Exchange, the underlier is the currency of the notional, as it is expected for AnnaDsb."]
    extract ProductForEvent
    then extract
        if GetUnderlierProductIdentifierLeg2 exists
                and underlier.FilterAssetIdentifier(GetUnderlierProductIdentifierLeg2, ISIN)
                    is absent
        then GetUnderlierProductIdentifierLeg2 first -> identifier
        else if GetOtherUnderlierLeg2 exists
        then GetOtherUnderlierLeg2

reporting rule UnderlierIDOtherSource from TransactionReportInstructionBase: <"Underlier ID (Other) Source">
    [docReference CPMI_IOSCO cdeV3.CDE section "2" field "103"
        provision "The origin, or publisher, of the associated Underlier ID (Other). This data element is applicable when the value of Underlier ID source is submitted as OTHER to the UPI service provider."]
    UnderlierProductIdentifierOther -> identifierType first

reporting rule UnderlierIDOtherSourceLeg1 from TransactionReportInstructionBase: <"Underlier ID (Other) Source - Leg 1">
    [docReference CPMI_IOSCO cdeV3.CDE section "2" field "103"
        provision "The origin, or publisher, of the associated Underlier ID (Other). This data element is applicable when the value of Underlier ID source is submitted as OTHER to the UPI service provider."]
    [docReference ISDA EUUKNAPeerReviewGroup date "20250402" field "Underlier ID (Other) - Leg 1"
        provision "For Credit Default Swaps, leg 1 is the interest rate. However, it is always a fixed rate; thus, for CDS no extraction of index is required at leg 1."]
    [docReference ISDA EUUKNAPeerReviewGroup date "20250417" field "Underlier ID (Other) Source - Leg 1"
        provision "For Foreign Exchange, the source is CCY, meaning 'currency', as it is expected for AnnaDsb."]
    extract ProductForEvent
    then extract
        if GetUnderlierProductIdentifierLeg1 exists
                and GetUnderlierProductIdentifierLeg1 -> identifierType all <> ISIN
        then GetUnderlierProductIdentifierLeg1 first -> identifierType to-string
        else if product.IsFRA
                and InterestRateLeg1 -> rateSpecification -> FloatingRateSpecification -> rateOption -> FloatingRateIndex -> identifier is absent
                and InterestRateLeg1 -> rateSpecification -> FloatingRateSpecification -> rateOption -> FloatingRateIndex -> name exists
        then ProductIdTypeEnum -> Name to-string
        else if product.IsFXForward or product.IsFXOption or product.IsFXSwap
        then "CCY" // Should this be added to ProductIDTypeEnum?

reporting rule UnderlierIDOtherSourceLeg2 from TransactionReportInstructionBase: <"Underlier ID (Other) Source - Leg 2">
    [docReference CPMI_IOSCO cdeV3.CDE section "2" field "103"
        provision "The origin, or publisher, of the associated Underlier ID (Other). This data element is applicable when the value of Underlier ID source is submitted as OTHER to the UPI service provider."]
    [docReference ISDA EUUKNAPeerReviewGroup date "20250403" field "Underlier ID (Other) - Leg 2"
        provision "For Foreign Exchange, the source is CCY, meaning 'currency', as it is expected for AnnaDsb."]
    [docReference ISDA EUUKNAPeerReviewGroup date "20250417" field "Underlier ID (Other) Source - Leg 2"
        provision "For Foreign Exchange, the source is CCY, meaning 'currency', as it is expected for AnnaDsb."]
    extract ProductForEvent
    then extract
        if GetUnderlierProductIdentifierLeg2 exists
                and GetUnderlierProductIdentifierLeg2 -> identifierType all <> ISIN
        then GetUnderlierProductIdentifierLeg2 first -> identifierType to-string
        else if (EconomicTermsForProduct -> payout -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation exists
                    and EconomicTermsForProduct -> payout -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation -> identifier is absent
                    and EconomicTermsForProduct -> payout -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation -> name exists)
                or (EconomicTermsForProduct(
                        underlier.UnderlierForProduct -> Product -> NonTransferableProduct
                    ) -> payout -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation exists
                    and EconomicTermsForProduct(
                            underlier.UnderlierForProduct -> Product -> NonTransferableProduct
                        ) -> payout -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation -> identifier is absent
                    and EconomicTermsForProduct(
                            underlier.UnderlierForProduct -> Product -> NonTransferableProduct
                        ) -> payout -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation -> name exists)
                or (product.IsFRA
                    and InterestRateLeg2 -> rateSpecification -> FloatingRateSpecification -> rateOption -> FloatingRateIndex -> identifier is absent
                    and InterestRateLeg2 -> rateSpecification -> FloatingRateSpecification -> rateOption -> FloatingRateIndex -> name exists)
        then ProductIdTypeEnum -> Name to-string
        else if product.IsFXForward or product.IsFXOption or product.IsFXSwap
        then "CCY" // Should this be added to ProductIDTypeEnum?

reporting rule UnderlyingAssetTradingPlatformIdentifierLeg1 from TransactionReportInstruction: <"Underlying asset trading platform identifier">
    [docReference CPMI_IOSCO cdeV3.CDE section "2" field "104"
        provision "For a platform (e.g. exchange) traded underlying asset, the platform on which the asset is traded. This data element is not applicable to OTC derivative transactions with custom basket constituents."]
    [docReference ISDA EUUKNAPeerReviewGroup date "20250423" field "Underlying asset trading platform identifier"
        provision "CDM currently represents indexes as baskets with single basket constituents. Thus, a custom basket constituent is considered when basket is represented with more than one basket constituent."]
    extract
        if underlier.UnderlierForProduct(ProductForEvent) -> Observable -> Basket -> basketConstituent count <= 1
        then common.PayoutFromProductLeg1(
                    TradableProductForEvent -> product,
                    TradableProductForEvent -> tradeLot only-element,
                    item -> reportableInformation
                )
    then extract
        (if optionPayout -> underlier exists
        then optionPayout -> underlier
        else if settlementPayout -> underlier exists
        then settlementPayout -> underlier
        else if performancePayout -> underlier exists
        then performancePayout -> underlier
        else if commodityPayout -> underlier exists
        then commodityPayout -> underlier)
    then extract
        (if Observable -> Asset -> Commodity -> exchange exists
        then Observable -> Asset -> Commodity -> exchange
        else if Observable -> Asset -> Instrument -> Security -> exchange exists
        then Observable -> Asset -> Instrument -> Security -> exchange
        else if Observable -> Basket -> basketConstituent -> Asset -> Instrument -> Security -> exchange
            only-element
            exists
        then Observable -> Basket -> basketConstituent -> Asset -> Instrument -> Security -> exchange only-element)
    then extract entityIdentifier
    then filter identifierType = MIC
    then extract identifier
    then first

reporting rule UnderlyingAssetTradingPlatformIdentifierLeg2 from TransactionReportInstruction: <"Underlying asset trading platform identifier">
    [docReference CPMI_IOSCO cdeV3.CDE section "2" field "104"
        provision "For a platform (e.g. exchange) traded underlying asset, the platform on which the asset is traded. This data element is not applicable to OTC derivative transactions with custom basket constituents."]
    [docReference ISDA EUUKNAPeerReviewGroup date "20250423" field "Underlying asset trading platform identifier"
        provision "CDM currently represents indexes as baskets with single basket constituents. Thus, a custom basket constituent is considered when basket is represented with more than one basket constituent."]
    extract
        if underlier.UnderlierForProduct(ProductForEvent) -> Observable -> Basket -> basketConstituent count <= 1
        then common.PayoutFromProductLeg2(
                    TradableProductForEvent -> product,
                    TradableProductForEvent -> tradeLot only-element,
                    item -> reportableInformation
                )
    then extract
        (if optionPayout -> underlier exists
        then optionPayout -> underlier
        else if settlementPayout -> underlier exists
        then settlementPayout -> underlier
        else if performancePayout -> underlier exists
        then performancePayout -> underlier
        else if commodityPayout -> underlier exists
        then commodityPayout -> underlier)
    then extract
        (if Observable -> Asset -> Commodity -> exchange exists
        then Observable -> Asset -> Commodity -> exchange
        else if Observable -> Asset -> Instrument -> Security -> exchange exists
        then Observable -> Asset -> Instrument -> Security -> exchange
        else if Observable -> Basket -> basketConstituent -> Asset -> Instrument -> Security -> exchange
            only-element
            exists
        then Observable -> Basket -> basketConstituent -> Asset -> Instrument -> Security -> exchange only-element)
    then extract entityIdentifier
    then filter identifierType = MIC
    then extract identifier
    then first

reporting rule UnderlyingAssetPriceSourceLeg1 from TransactionReportInstruction: <"Underlying asset price source Leg 1">
    [docReference CPMI_IOSCO cdeV3.CDE section "2" field "105"
        provision "For an underlying asset or benchmark not traded on a platform, the source of the price used to determine the value or level of the asset or benchmark. This data element is not applicable to OTC derivative transactions with custom basket constituents."]
    [docReference ISDA EUUKNAPeerReviewGroup date "20250514" field "Underlying asset price source Leg 1"
        provision "CDM currently represents indexes as baskets with single basket constituents. Thus, a custom basket constituent is considered when basket is represented with more than one basket constituent."]
    extract reportableEvent [
        ProductForEvent
            then if underlier.UnderlierForProduct -> Observable -> Basket -> basketConstituent count <= 1
                then (extract
                    reportableEvent -> reportableInformation -> underlyingAssetPriceSource
                then (if GetUnderlierProductIdentifierLeg1(ProductForEvent(reportableEvent))
                            exists
                            and GetUnderlierProductIdentifierLeg1(
                                    ProductForEvent(reportableEvent)
                                ) -> identifierType all <> ISIN
                    then filter
                        assetIdentifier -> identifier = GetUnderlierProductIdentifierLeg1(
                                ProductForEvent(reportableEvent)
                            ) -> identifier
                    else if GetOtherUnderlierLeg1(ProductForEvent(reportableEvent)) exists
                    then filter
                        otherId = GetOtherUnderlierLeg1(ProductForEvent(reportableEvent)))
                then extract underlyingAssetPriceSource
                then distinct only-element)
    ]

reporting rule UnderlyingAssetPriceSourceLeg2 from TransactionReportInstruction: <"Underlying asset price source Leg 2">
    [docReference CPMI_IOSCO cdeV3.CDE section "2" field "105"
        provision "For an underlying asset or benchmark not traded on a platform, the source of the price used to determine the value or level of the asset or benchmark. This data element is not applicable to OTC derivative transactions with custom basket constituents."]
    [docReference ISDA EUUKNAPeerReviewGroup date "20250514" field "Underlying asset price source Leg 2"
        provision "CDM currently represents indexes as baskets with single basket constituents. Thus, a custom basket constituent is considered when basket is represented with more than one basket constituent."]
    extract reportableEvent [
        ProductForEvent
            then if underlier.UnderlierForProduct -> Observable -> Basket -> basketConstituent count <= 1
                then extract
                    reportableEvent -> reportableInformation -> underlyingAssetPriceSource
            then if GetUnderlierProductIdentifierLeg2(ProductForEvent(reportableEvent))
                        exists
                        and GetUnderlierProductIdentifierLeg2(
                                ProductForEvent(reportableEvent)
                            ) -> identifierType all <> ISIN
                then filter
                    assetIdentifier = GetUnderlierProductIdentifierLeg2(
                            ProductForEvent(reportableEvent)
                        )
                else if GetOtherUnderlierLeg2(ProductForEvent(reportableEvent)) exists
                then filter
                    otherId = GetOtherUnderlierLeg2(ProductForEvent(reportableEvent))
            then extract underlyingAssetPriceSource
            then distinct only-element
    ]

reporting rule CryptoAssetUnderlyingIndicator from TransactionReportInstruction: <"Crypto asset underlying indicator">
    [docReference CPMI_IOSCO cdeV3.CDE section "2" field "106"
        provision "Indicator of whether the underlying of the derivative is crypto asset. This element should be reported as true if any of the underlyings is a crypto asset (immediate or ultimate underlying as well as where the derivative is based on a mix of crypto assets and other underlyings)."]
    [docReference ISDA PeerReviewGroup date "20230614"
        provision "Does not allow different crypto definitions for different reporting regimes. Thus, crypto indicator remains the same."]
    extract
        if reportableInformation -> cryptoBased exists
        then reportableInformation -> cryptoBased
        else False
