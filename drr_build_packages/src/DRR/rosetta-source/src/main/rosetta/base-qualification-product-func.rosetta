namespace drr.base.qualification.product
version "${project.version}"

import cdm.base.*
import cdm.base.math.*
import cdm.event.common.*
import cdm.observable.asset.*
import cdm.product.asset.*
import cdm.product.qualification.*
import cdm.product.template.*

import drr.base.trade.*

func IsEquitySwap:
    inputs:
        tradableProduct TradableProduct (1..1)
    output:
        result boolean (1..1)
    set result: IsEquitySwapProduct(tradableProduct -> product) = True

func IsEquitySwapProduct:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: Qualify_BaseProduct_EquitySwap(EconomicTermsForProduct(product)) = True

func IsEquityOther: <"Evaluates a product as Equity Other product when it is either qualifies as Equity Option (Other) or Equity Swap (Other)">
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_Equity_OtherOption(EconomicTermsForProduct(product)) = True
            or Qualify_Equity_Swap_NonStandard(EconomicTermsForProduct(product)) = True

func IsCommoditySwap:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_Commodity_Swap_FixedFloat(EconomicTermsForProduct(product)) = True
            or Qualify_Commodity_Swap_Basis(EconomicTermsForProduct(product)) = True

func IsCommoditySwaption:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: Qualify_Commodity_Swaption(EconomicTermsForProduct(product)) = True

func IsCommodityForward:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: Qualify_Commodity_Forward(EconomicTermsForProduct(product)) = True

func IsCommodityFixedPriceForward:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        IsCommodityForward(product) = True
            and EconomicTermsForProduct(product) -> payout -> FixedPricePayout exists

func IsCommodityFloatingPriceForward:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        IsCommodityForward(product) = True
            and EconomicTermsForProduct(product) -> payout -> CommodityPayout exists

func IsProductOTC: <"True if the product is and OTC under contractualProduct element">
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: product exists

func IsProductETD: <"True if the product is and ETD under security element">
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        product -> economicTerms -> payout count = 1
            and product -> economicTerms -> payout -> SettlementPayout -> underlier -> Product -> TransferableProduct -> Instrument -> ListedDerivative exists

func IsOption:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: EconomicTermsForProduct(product) -> payout -> OptionPayout exists

func IsCommoditySwapFixedFloat:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: Qualify_Commodity_Swap_FixedFloat(EconomicTermsForProduct(product)) = True

func IsCommodityOption:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: Qualify_Commodity_Option(EconomicTermsForProduct(product)) = True

func IsEquityOption:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_EquityOption_PriceReturnBasicPerformance_SingleName(
                    EconomicTermsForProduct(product)
                ) = True
            or Qualify_EquityOption_PriceReturnBasicPerformance_Index(
                    EconomicTermsForProduct(product)
                ) = True
            or Qualify_EquityOption_PriceReturnBasicPerformance_Basket(
                    EconomicTermsForProduct(product)
                ) = True

func IsPutOption:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        IsOption(product)
            and (EconomicTermsForProduct(product) -> payout -> OptionPayout -> optionType all = OptionTypeEnum -> Put
                or EconomicTermsForProduct(product) -> payout -> OptionPayout -> optionType all = OptionTypeEnum -> Receiver)

func IsCallOption:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        IsOption(product)
            and (EconomicTermsForProduct(product) -> payout -> OptionPayout -> optionType all = OptionTypeEnum -> Call
                or EconomicTermsForProduct(product) -> payout -> OptionPayout -> optionType all = OptionTypeEnum -> Payer)

func IsSingleCommodityPayoutProduct:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    alias economicTerms: EconomicTermsForProduct(product)
    set result:
        // EconomicTermsForProduct(product) -> payout -> commodityPayout only-element exists
        // and EconomicTermsForProduct(product) -> payout -> fixedPricePayout is absent
        // and EconomicTermsForProduct(product) -> payout -> InterestRatePayout is absent
        economicTerms -> payout then count = 1 and CommodityPayout exists

func IsFXOption:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        EconomicTermsForProduct(product) -> payout -> OptionPayout exists
            and Qualify_AssetClass_ForeignExchange(EconomicTermsForProduct(product))

func IsCap:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_InterestRate_CapFloor(EconomicTermsForProduct(product)) = True
            and EconomicTermsForProduct(product) -> payout -> InterestRatePayout -> rateSpecification -> FloatingRateSpecification -> capRateSchedule exists

func IsFloor:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_InterestRate_CapFloor(EconomicTermsForProduct(product)) = True
            and EconomicTermsForProduct(product) -> payout -> InterestRatePayout -> rateSpecification -> FloatingRateSpecification -> floorRateSchedule exists

func IsEquityForward:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_UnderlierObservable_Equity(
                EconomicTermsForProduct(product) -> payout -> SettlementPayout only-element -> underlier -> Observable
            )

func IsProductWithUnderlier:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        productWithUnderlier boolean (1..1)
    alias payout: EconomicTermsForProduct(product) -> payout
    set productWithUnderlier:
        payout -> OptionPayout exists or payout -> SettlementPayout exists

func IsFixedInterestRate: <"Returns true if Price has priceType of InterestRate, with no spreadType specified.">
    inputs:
        price PriceSchedule (1..1)
    output:
        result boolean (1..1)
    set result:
        price -> priceType = PriceTypeEnum -> InterestRate
            and price -> arithmeticOperator is absent

func IsInterestRateSpread: <"Returns true if Price has priceType of InterestRate, and a spreadType of Spread.">
    inputs:
        price PriceSchedule (1..1)
    output:
        result boolean (1..1)
    set result:
        price -> priceType = PriceTypeEnum -> InterestRate
            and price -> arithmeticOperator = ArithmeticOperationEnum -> Add

func IsCommoditySwap_SingleIndex: <"Evaluates a product as a Commodity Swap on Single Index when the product satisfies the following criteria: 1) It is a Commodity Swap, 2) the instrument qualifies as a Financial Commodity, as it is based on the performance of a Commodity Index, and 3) the floating leg contains a Commodity Reference Price (ISDACRP) or an underlying commodity index.">
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)

    alias economicTerms: EconomicTermsForProduct(product)
    alias commodityUnderlier: economicTerms -> payout -> CommodityPayout -> underlier

    set result:
        IsCommoditySwap(product) = True
            and economicTerms -> payout -> CommodityPayout -> settlementTerms -> settlementType all = Cash
            and (commodityUnderlier -> Observable -> Asset -> Commodity -> identifier -> identifierType all = ISDACRP
                or commodityUnderlier -> Observable -> Index ->> assetClass any = Commodity)

func IsCommodityForward_SingleIndex: <"Evaluates a product as a Commodity Forward on Single Index when the product satisfies the following criteria: 1) It is a Commodity Forward, 2) the instrument qualifies as a Financial Commodity, as it is based on the performance of a Commodity Index, and 3) the floating leg contains a Commodity Reference Price (ISDACRP) or an underlying commodity index.">
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)

    alias economicTerms: EconomicTermsForProduct(product)
    alias forwardUnderlier:
        economicTerms -> payout -> SettlementPayout only-element -> underlier

    set result:
        Qualify_Commodity_Forward(economicTerms) = True
            and economicTerms -> payout -> SettlementPayout only-element -> settlementTerms -> settlementType = Cash
            and (forwardUnderlier -> Observable -> Asset -> Commodity -> identifier only-element -> identifierType = ISDACRP
                or forwardUnderlier -> Observable -> Index ->> assetClass = Commodity)

func IsCommodityOption_SingleIndex: <"Evaluates a product as a Commodity Option on Single Index when the product satisfies the following criteria: 1) It is a Commodity Option, 2) the instrument qualifies as a Financial Commodity, as it is based on the performance of a Commodity Index, and 3) the floating leg contains a Commodity Reference Price (ISDACRP) or an underlying commodity index.">
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)

    alias economicTerms: EconomicTermsForProduct(product)
    alias optionUnderlier: economicTerms -> payout -> OptionPayout only-element -> underlier

    set result:
        Qualify_Commodity_Option_Cash(economicTerms) = True
            and (optionUnderlier -> Observable -> Asset -> Commodity -> identifier only-element -> identifierType = ISDACRP
                or optionUnderlier -> Observable -> Index ->> assetClass = Commodity)

func IsCommodityTotalReturnSwap_SingleIndex: <"Evaluates a product as a Commodity Total Return Swap on Single Index when the product satisfies the following criteria: 1) It is a Commodity product, 2) has an interest rate leg and a performance leg, 3) the instrument qualifies as a Financial Commodity, as it is based on the performance of a Commodity Index, and 4) has a performance leg that contains a Commodity Reference Price (ISDACRP) or an underlying commodity index.">
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)

    alias economicTerms: EconomicTermsForProduct(product)
    alias performanceUnderlier:
        economicTerms -> payout -> PerformancePayout only-element -> underlier

    set result:
        Qualify_AssetClass_Commodity(economicTerms) = True
            and PerformancePayoutAndInterestRatePayoutOnlyExists(
                    product -> economicTerms -> payout
                )
            and economicTerms -> payout -> PerformancePayout only-element -> settlementTerms -> settlementType = Cash
            and (performanceUnderlier -> Observable -> Asset -> Commodity -> identifier only-element -> identifierType = ISDACRP
                or performanceUnderlier -> Observable -> Index ->> assetClass = Commodity)

func IsInflationRateBasis:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_BaseProduct_Inflation(EconomicTermsForProduct(product)) = True
            and Qualify_BaseProduct_CrossCurrency(EconomicTermsForProduct(product)) = False
            and Qualify_SubProduct_Basis(EconomicTermsForProduct(product)) = True

func IsInterestRateCrossCurrency:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: Qualify_BaseProduct_CrossCurrency(EconomicTermsForProduct(product)) = True

func IsInterestRateCrossCurrencyBasis:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_SubProduct_Basis(EconomicTermsForProduct(product)) = True
            and Qualify_BaseProduct_CrossCurrency(EconomicTermsForProduct(product)) = True

func IsInterestRateFixedFloatSingleCurrency:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_SubProduct_FixedFloat(EconomicTermsForProduct(product)) = True
            and Qualify_BaseProduct_CrossCurrency(EconomicTermsForProduct(product)) = False

func IsInterestRateFixedFixed:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_SubProduct_FixedFixed(EconomicTermsForProduct(product)) = True
            and Qualify_BaseProduct_CrossCurrency(EconomicTermsForProduct(product)) = False

func IsInterestRateBasis:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_SubProduct_Basis(EconomicTermsForProduct(product)) = True
            and Qualify_BaseProduct_CrossCurrency(EconomicTermsForProduct(product)) = False

func IsInterestRateReturnSwap:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)

    set result:
        if EconomicTermsForProduct(product) -> payout -> InterestRatePayout count = 1
                and EconomicTermsForProduct(product) -> payout -> PerformancePayout count = 1
        then (EconomicTermsForProduct(product) -> payout -> InterestRatePayout only-element -> rateSpecification -> FloatingRateSpecification exists
                or EconomicTermsForProduct(product) -> payout -> InterestRatePayout only-element -> rateSpecification -> FixedRateSpecification exists
                or EconomicTermsForProduct(product) -> payout -> InterestRatePayout only-element -> rateSpecification -> InflationRateSpecification exists)

func InterestRateReturnSwap:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        interestRatePayout InterestRatePayout (1..1)

    set interestRatePayout:
        EconomicTermsForProduct(product) -> payout -> InterestRatePayout only-element

func IsGenericIRS:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: EconomicTermsForProduct(product) -> payout -> InterestRatePayout count = 2

func IsCommoditySwapFloatFloat: //FloatFloat
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: Qualify_Commodity_Swap_Basis(EconomicTermsForProduct(product)) = True

func IsIRSwaption:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_InterestRate_Option_Swaption(EconomicTermsForProduct(product)) = True

func IsCapFloor:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: Qualify_InterestRate_CapFloor(EconomicTermsForProduct(product)) = True

func IsFXForward:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        (Qualify_ForeignExchange_Spot_Forward(EconomicTermsForProduct(product)) = True
                or Qualify_ForeignExchange_NDF(EconomicTermsForProduct(product)) = True)
            and IsProductETD(product) = False

func IsFXPerformance:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        EconomicTermsForProduct(product) -> payout -> PerformancePayout -> underlier -> Observable -> Asset -> Cash exists

func IsFXSwap:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_ForeignExchange_Swap(EconomicTermsForProduct(product))
            or Qualify_ForeignExchange_NDS(EconomicTermsForProduct(product))

func IsFXProduct:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: IsFXForward(product) or IsFXOption(product) or IsFXSwap(product)

func IsEquity: //@TODO: should this also include equity forwards?
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_UnderlierObservable_Equity(
                    EconomicTermsForProduct(product) -> payout -> PerformancePayout only-element -> underlier -> Observable
                ) = True
            or Qualify_UnderlierObservable_Equity(
                    EconomicTermsForProduct(product) -> payout -> OptionPayout only-element -> underlier -> Observable
                ) = True
            or Qualify_UnderlierObservable_Equity(
                    EconomicTermsForProduct(product) -> payout -> SettlementPayout only-element -> underlier -> Observable
                )

func IsFRA:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: Qualify_InterestRate_Fra(EconomicTermsForProduct(product)) = True

func IsCreditSwaption:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: Qualify_CreditDefaultSwaption(EconomicTermsForProduct(product)) = True

func IsCommodity:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_AssetClass_Commodity(EconomicTermsForProduct(product)) = True
            or IsSingleCommodityPayoutProduct(product) = True

func IsCredit:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: Qualify_AssetClass_Credit(EconomicTermsForProduct(product)) = True

func IsCreditDefaultSwapIndex:
    inputs:
        trade Trade (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_CreditDefaultSwap_Index(EconomicTermsForProduct(ProductForTrade(trade))) = True
            or Qualify_CreditDefaultSwap_IndexTranche(
                    EconomicTermsForProduct(ProductForTrade(trade))
                ) = True

func IsCreditDefaultSwapBasket:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result: Qualify_CreditDefaultSwap_Basket(EconomicTermsForProduct(product)) = True

func IsInterestRateDebtOption:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_InterestRate_Option_DebtOption(EconomicTermsForProduct(product)) = True

func IsVarianceSwap:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_EquitySwap_ParameterReturnVariance_SingleName(
                    EconomicTermsForProduct(product)
                ) = True
            or Qualify_EquitySwap_ParameterReturnVariance_Index(
                    EconomicTermsForProduct(product)
                ) = True
            or Qualify_EquitySwap_ParameterReturnVariance_Basket(
                    EconomicTermsForProduct(product)
                ) = True
            or Qualify_EquitySwap_ParameterReturnDispersion(
                    EconomicTermsForProduct(product)
                ) = True
            or Qualify_ForeignExchange_ParameterReturnVariance(
                    EconomicTermsForProduct(product)
                ) = True

func IsVolatilitySwap:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_EquitySwap_ParameterReturnVolatility_SingleName(
                    EconomicTermsForProduct(product)
                ) = True
            or Qualify_EquitySwap_ParameterReturnVolatility_Index(
                    EconomicTermsForProduct(product)
                ) = True
            or Qualify_EquitySwap_ParameterReturnVolatility_Basket(
                    EconomicTermsForProduct(product)
                ) = True
            or Qualify_ForeignExchange_ParameterReturnVolatility(
                    EconomicTermsForProduct(product)
                ) = True

func IsDividendSwap:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_EquitySwap_ParameterReturnDividend_SingleName(
                    EconomicTermsForProduct(product)
                ) = True
            or Qualify_EquitySwap_ParameterReturnDividend_Index(
                    EconomicTermsForProduct(product)
                ) = True
            or Qualify_EquitySwap_ParameterReturnDividend_Basket(
                    EconomicTermsForProduct(product)
                ) = True

func IsFixedFloatZeroCouponSwap:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)
    set result:
        Qualify_InterestRate_IRSwap_FixedFloat_ZeroCoupon(EconomicTermsForProduct(product)) = True
            or Qualify_InterestRate_InflationSwap_FixedFloat_ZeroCoupon(
                    EconomicTermsForProduct(product)
                ) = True

func IsTotalReturnSwapDebtUnderlier:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)

    alias performanceUnderlier:
        product -> economicTerms -> payout -> PerformancePayout only-element -> underlier

    set result:
        PerformancePayoutAndInterestRatePayoutOnlyExists(product -> economicTerms -> payout)
            and (if performanceUnderlier exists
                then performanceUnderlier -> Observable -> Asset -> Instrument
                    extract (Loan exists or Security -> instrumentType = Debt)
                else True)

func IsFixedFloatZeroCouponSwapKnownAmount:
    inputs:
        product NonTransferableProduct (1..1)
    output:
        result boolean (1..1)

    set result:
        IsFixedFloatZeroCouponSwap(product) = True
            and (EconomicTermsForProduct(product) -> payout -> InterestRatePayout
                filter IsZeroCouponSwapKnownAmount
                then count = 1
                )

func IsZeroCouponSwapKnownAmount:
    inputs:
        payout InterestRatePayout (1..1)
    output:
        result boolean (1..1)
    set result: payout -> priceQuantity exists and payout -> rateSpecification is absent
