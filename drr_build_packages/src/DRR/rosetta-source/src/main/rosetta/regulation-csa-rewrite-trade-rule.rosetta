reporting rule TotalNotionalQuantityLeg1 from TransactionReportInstruction: <"Total Notional Quantity - Leg 1">
    filter IsAllowableActionForCSA
    then if IsEquity(ProductForEvent) or IsCommodity(ProductForEvent)
        then cde.quantity.TotalNotionalQuantity(PayoutLeg1, 99999999999999999999.99999)

reporting rule TotalNotionalQuantityLeg2 from TransactionReportInstruction: <"Total Notional Quantity - Leg 2">
    filter IsAllowableActionForCSA
    then if IsCommoditySwap(ProductForEvent)
                or (IsEquity(ProductForEvent) and csa.InterestRateLeg2(ProductForEvent) -> priceQuantity -> quantitySchedule -> unit -> financialUnit exists)
        then cde.quantity.TotalNotionalQuantity(PayoutLeg2, 99999999999999999999.99999)

