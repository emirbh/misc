    then cde.execution.SettlementCurrency(PayoutLeg2)

reporting rule SpreadLeg1 from TransactionReportInstruction: <"Spread - Leg 1">
    filter IsAllowableActionForCSA
    then price.PriceFormatFromNotation(
                cde.price.SpreadValue(PayoutLeg1),
                SpreadNotationLeg1
            )

reporting rule SpreadLeg2 from TransactionReportInstruction: <"Spread - Leg 2">
    filter IsAllowableActionForCSA
    then price.PriceFormatFromNotation(
                cde.price.SpreadValue(PayoutLeg2),
                SpreadNotationLeg2
            )

reporting rule SpreadNotationLeg1 from TransactionReportInstruction: <"Spread notation - Leg 1">
    price.DefaultPercentageToDecimal(cde.price.SpreadNotationEnum(PayoutLeg1), False)

reporting rule SpreadNotationLeg2 from TransactionReportInstruction: <"Spread notation - Leg 2">
    price.DefaultPercentageToDecimal(cde.price.SpreadNotationEnum(PayoutLeg2), False)

reporting rule SpreadCurrencyLeg1 from TransactionReportInstruction: <"Spread Currency - Leg 1">
    filter IsAllowableActionForCSA
    then cde.price.SpreadCurrency(PayoutLeg1)

reporting rule SpreadCurrencyLeg2 from TransactionReportInstruction: <"Spread Currency - Leg 2">
    filter IsAllowableActionForCSA
    then cde.price.SpreadCurrency(PayoutLeg2)

reporting rule QuantityUnitOfMeasureLeg1 from TransactionReportInstruction: <"Quantity Unit Of Measure - Leg 1">
    filter IsAllowableActionForCSA
    then extract TradeForEvent
    then extract
        if Qualify_Commodity_Swap_Basis(ProductForTrade -> economicTerms) = True
        then drr.regulation.csa.rewrite.trade.CommodityLeg1(ProductForTrade) -> priceQuantity -> quantitySchedule
        else if Qualify_Commodity_Swap_FixedFloat(ProductForTrade -> economicTerms) = True
        then EconomicTermsForProduct(ProductForTrade) -> payout -> FixedPricePayout only-element -> priceQuantity -> quantitySchedule
        else if Qualify_Commodity_Swaption(product -> economicTerms) = True
                and Qualify_Commodity_Swap_Basis(
                        underlier.UnderlierForProduct(ProductForTrade) -> Product -> NonTransferableProduct -> economicTerms
                    )
        then EconomicTermsForProduct(ProductForTrade) -> payout -> OptionPayout only-element -> priceQuantity -> quantitySchedule
        else if Qualify_Commodity_Swaption(product -> economicTerms) = True
                and Qualify_Commodity_Swap_FixedFloat(
                        underlier.UnderlierForProduct(ProductForTrade) -> Product -> NonTransferableProduct -> economicTerms
                    )
        then EconomicTermsForProduct(ProductForTrade) -> payout -> OptionPayout only-element -> priceQuantity -> quantitySchedule
        else if IsCommodityOption(product)
        then EconomicTermsForProduct(ProductForTrade) -> payout -> OptionPayout only-element -> priceQuantity -> quantitySchedule
        else if IsEquityOption(ProductForTrade)
                and EconomicTermsForProduct(ProductForTrade) -> payout -> OptionPayout -> priceQuantity -> quantitySchedule -> unit -> financialUnit exists
        then EconomicTermsForProduct(ProductForTrade) -> payout -> OptionPayout only-element -> priceQuantity -> quantitySchedule
        else if IsEquityForward(ProductForTrade)
                and EconomicTermsForProduct(ProductForTrade) -> payout -> SettlementPayout only-element -> priceQuantity -> quantitySchedule -> unit -> financialUnit exists
        then EconomicTermsForProduct(ProductForTrade) -> payout -> SettlementPayout only-element -> priceQuantity -> quantitySchedule
        else if EconomicTermsForProduct(ProductForTrade) -> payout -> PerformancePayout only-element -> priceQuantity -> quantitySchedule -> unit -> financialUnit exists
        then EconomicTermsForProduct(ProductForTrade) -> payout -> PerformancePayout only-element -> priceQuantity -> quantitySchedule
        else if IsEquity(ProductForTrade)
                and tradeLot -> priceQuantity -> quantity -> unit -> financialUnit exists
        then (tradeLot only-element -> priceQuantity -> quantity
            then filter unit -> financialUnit exists
            then only-element)
    then extract quantity.UnitOfMeasureFromQuantity default "OTHR"

reporting rule QuantityUnitOfMeasureLeg2 from TransactionReportInstruction: <"Quantity Unit Of Measure - Leg 2">
    filter IsAllowableActionForCSA
    then extract TradeForEvent
    then extract
        if IsCommoditySwap(product)
        then drr.regulation.csa.rewrite.trade.CommodityLeg2(ProductForTrade) -> priceQuantity -> quantitySchedule
        else if IsEquity(ProductForTrade)
                and drr.regulation.common.InterestRateLeg2(ProductForTrade) -> priceQuantity -> quantitySchedule -> unit -> financialUnit exists
        then drr.regulation.common.InterestRateLeg2(ProductForTrade) -> priceQuantity -> quantitySchedule
    then extract quantity.UnitOfMeasureFromQuantity default "OTHR"

reporting rule Direction2Leg1 from TransactionReportInstruction: <"Direction2 - Leg 1">
    filter IsAllowableActionForCSA
    then if cde.party.Direction1 is absent
        then cde.party.Direction2(
                    PayoutLeg1,
                    CounterpartyRoleFromLEI(CounterpartiesForEvent, cde.party.Counterparty1)
                )

reporting rule Direction2Leg2 from TransactionReportInstruction: <"Direction2 - Leg 2">
    filter IsAllowableActionForCSA
    then if cde.party.Direction1 is absent
        then cde.party.Direction2(
                    PayoutLeg2,
                    CounterpartyRoleFromLEI(CounterpartiesForEvent, cde.party.Counterparty1)
                )

// Common Leg fields
reporting rule NotionalQuantityLeg1 from TransactionReportInstruction: <"Notional Quantity - Leg 1">
    filter IsAllowableActionForCSA
    then if IsSingleCommodityPayoutProduct(ProductForEvent) = False
                and (IsEquity(ProductForEvent) or IsCommodity(ProductForEvent))
        then extract common.quantity.NotionalQuantity(common.PayoutLeg1)

reporting rule NotionalQuantityLeg2 from TransactionReportInstruction: <"Notional Quantity - Leg 2">
    filter IsAllowableActionForCSA
    then if IsEquity(ProductForEvent) or IsCommodity(ProductForEvent)
        then common.quantity.NotionalQuantity(PayoutLeg2)

reporting rule QuantityFrequencyPeriodLeg1 from TransactionReportInstruction: <"Notional Quantity Frequency Period - Leg 1">
    filter IsAllowableActionForCSA
    then if IsSingleCommodityPayoutProduct(ProductForEvent) = False
        then common.quantity.QuantityFrequency(PayoutLeg1) -> period

reporting rule QuantityFrequencyPeriodLeg2 from TransactionReportInstruction: <"Notional Quantity Frequency Period - Leg 2">
    filter IsAllowableActionForCSA
    then common.quantity.QuantityFrequency(PayoutLeg2) -> period

reporting rule QuantityFrequencyPeriodMultiplierLeg1 from TransactionReportInstruction: <"Notional Quantity Frequency Period Multiplier - Leg 1">
    filter IsAllowableActionForCSA
    then if IsSingleCommodityPayoutProduct(ProductForEvent) = False
        then common.quantity.QuantityFrequency(PayoutLeg1) -> periodMultiplier

reporting rule QuantityFrequencyPeriodMultiplierLeg2 from TransactionReportInstruction: <"Notional Quantity Frequency Period Multiplier - Leg 2">
    filter IsAllowableActionForCSA
    then common.quantity.QuantityFrequency(PayoutLeg2) -> periodMultiplier

reporting rule FloatingRateResetFrequencyPeriodOfLeg1 from TransactionReportInstruction: <"Floating rate reset frequency period of leg 1">
    filter IsAllowableActionForCSA
    then extract common.payment.FloatingInterestRatePayoutFromPayout(PayoutLeg1)
    then common.payment.FloatingRateResetFrequencyPeriod

reporting rule FloatingRateResetFrequencyMultiplierOfLeg1 from TransactionReportInstruction: <"Floating rate reset frequency multiplier of leg 1">
    filter IsAllowableActionForCSA
    then extract common.payment.FloatingInterestRatePayoutFromPayout(PayoutLeg1)
    then common.payment.FloatingRateResetFrequencyPeriodMultiplier

reporting rule FloatingRateResetFrequencyPeriodOfLeg2 from TransactionReportInstruction: <"Floating rate reset frequency period of leg 2">
    filter IsAllowableActionForCSA
    then extract common.payment.FloatingInterestRatePayoutFromPayout(PayoutLeg2)
    then common.payment.FloatingRateResetFrequencyPeriod

reporting rule FloatingRateResetFrequencyMultiplierOfLeg2 from TransactionReportInstruction:
    filter IsAllowableActionForCSA
    then extract common.payment.FloatingInterestRatePayoutFromPayout(PayoutLeg2)
    then common.payment.FloatingRateResetFrequencyPeriodMultiplier

reporting rule FixingDateLeg1 from TransactionReportInstruction: <"Fixing Date - Leg 1">
    filter IsAllowableActionForCSA
    then common.datetime.FixingDate(PayoutLeg1)

reporting rule FixingDateLeg2 from TransactionReportInstruction: <"Fixing Date - Leg 2">
    filter IsAllowableActionForCSA
    then common.datetime.FixingDate(PayoutLeg2)

reporting rule PayerIdentifierLeg1 from TransactionReportInstruction: <"Payer Identifier-Leg 1">
    filter IsAllowableActionForCSA
    then if BuyerIdentifier is absent
                or IsVarianceSwap(ProductForEvent)
                or IsVolatilitySwap(ProductForEvent)
        then // Ascent Uplift analysis - We are making an exception for IsVarianceSwap(ProductForEvent) or IsVolatilitySwap(ProductForEvent) as to mimic current behvaiour as still populate even if we only have a single leg
        extract
            PartyLeiAndPersonByRoles(
                    cde.party.PayerParty(PayoutLeg1, CounterpartiesForEvent),
                    reportingSide -> reportingParty
                )

reporting rule PayerIdentifierLeg2 from TransactionReportInstruction: <"Payer Identifier-Leg 2">
    filter IsAllowableActionForCSA
    then if BuyerIdentifier is absent
                or IsVarianceSwap(ProductForEvent)
                or IsVolatilitySwap(ProductForEvent)
        then extract
            PartyLeiAndPersonByRoles(
                    cde.party.PayerParty(PayoutLeg2, CounterpartiesForEvent),
                    reportingSide -> reportingParty
                )

reporting rule ReceiverIdentifierLeg1 from TransactionReportInstruction: <"Receiver Identifier-Leg 1">
    filter IsAllowableActionForCSA
    then if SellerIdentifier is absent
                or IsVarianceSwap(ProductForEvent)
                or IsVolatilitySwap(ProductForEvent)
        then extract
            PartyLeiAndPersonByRoles(
                    cde.party.ReceiverParty(PayoutLeg1, CounterpartiesForEvent),
                    reportingSide -> reportingParty
                )

reporting rule ReceiverIdentifierLeg2 from TransactionReportInstruction: <"Receiver Identifier-Leg 2">
    filter IsAllowableActionForCSA
    then if SellerIdentifier is absent
                or IsVarianceSwap(ProductForEvent)
                or IsVolatilitySwap(ProductForEvent)
        then extract
            PartyLeiAndPersonByRoles(
                    cde.party.ReceiverParty(PayoutLeg2, CounterpartiesForEvent),
                    reportingSide -> reportingParty
                )

reporting rule CryptoAssetUnderlyingIndicatorLeg1 from TransactionReportInstruction: <"Crypto asset underlying indicator-Leg 1">
    filter IsAllowableActionForCSA
    then if IsCSALeg1Aligned = True
        then (if Qualify_AssetClass_Commodity(EconomicTermsForProduct(ProductForEvent))
            then cde.underlier.CryptoAssetUnderlyingIndicator)
        else if IsCSALeg2Aligned = False
        then (if IsCommoditySwapFloatFloat(ProductForEvent)
                    or IsCommoditySwapFixedFloat(ProductForEvent)
            then cde.underlier.CryptoAssetUnderlyingIndicator)

reporting rule CryptoAssetUnderlyingIndicatorLeg2 from TransactionReportInstruction: <"Crypto asset underlying indicator-Leg 2">
    filter IsAllowableActionForCSA
    then if IsCSALeg2Aligned = True
        then (if IsCommoditySwapFloatFloat(ProductForEvent)
                    or IsCommoditySwapFixedFloat(ProductForEvent)
            then cde.underlier.CryptoAssetUnderlyingIndicator)
        else if IsCSALeg2Aligned = False
        then (if Qualify_AssetClass_Commodity(EconomicTermsForProduct(ProductForEvent))
            then cde.underlier.CryptoAssetUnderlyingIndicator)

reporting rule UnderlyingAssetTradingPlatformIdentifierLeg1 from TransactionReportInstruction: <"Underlying Asset Trading Platform Identifier-Leg 1">
    filter IsAllowableActionForCSA
    then extract
        if IsEquity(ProductForEvent)
                or IsEquityForward(ProductForEvent)
                or Qualify_AssetClass_Credit(EconomicTermsForProduct(ProductForEvent))
        then if IsCSALeg1Aligned = True
            then cde.underlier.UnderlyingAssetTradingPlatformIdentifierLeg1
            else cde.underlier.UnderlyingAssetTradingPlatformIdentifierLeg2

reporting rule UnderlyingAssetTradingPlatformIdentifierLeg2 from TransactionReportInstruction: <"Underlying Asset Trading Platform Identifier-Leg 2">
    filter IsAllowableActionForCSA
    then extract
        if IsEquity(ProductForEvent)
                or IsEquityForward(ProductForEvent)
                or Qualify_AssetClass_Credit(EconomicTermsForProduct(ProductForEvent))
        then if IsCSALeg2Aligned = True
            then cde.underlier.UnderlyingAssetTradingPlatformIdentifierLeg2
            else cde.underlier.UnderlyingAssetTradingPlatformIdentifierLeg1

reporting rule UnderlyingAssetPriceSourceLeg1 from TransactionReportInstruction: <"Underlying Asset Price Source-Leg 1">
    filter IsAllowableActionForCSA
    then if IsUnderlierTOTV(reportableInformation)
        then (if IsCSALeg1Aligned = True
            then cde.underlier.UnderlyingAssetPriceSourceLeg1
            else cde.underlier.UnderlyingAssetPriceSourceLeg2)

reporting rule UnderlyingAssetPriceSourceLeg2 from TransactionReportInstruction: <"Underlying Asset Price Source-Leg 2">
    filter IsAllowableActionForCSA
    then if IsUnderlierTOTV(reportableInformation)
        then (if IsCSALeg2Aligned = True
            then cde.underlier.UnderlyingAssetPriceSourceLeg2
            else cde.underlier.UnderlyingAssetPriceSourceLeg1)

//DTCC Fields
reporting rule UnderlierIDOtherLeg1 from TransactionReportInstructionBase: <"Underlier ID (Other) - Leg 1">
    filter IsAllowableActionForCSA
    then if IsCSALeg1Aligned = True
        then cde.underlier.UnderlierIDOtherLeg1
        else cde.underlier.UnderlierIDOtherLeg2

reporting rule UnderlierIDOtherLeg2 from TransactionReportInstructionBase: <"Underlier ID (Other) - Leg 2">
    filter IsAllowableActionForCSA
    then if IsCSALeg2Aligned = True
        then cde.underlier.UnderlierIDOtherLeg2
        else cde.underlier.UnderlierIDOtherLeg1

reporting rule UnderlierIDOtherSourceLeg1 from TransactionReportInstructionBase: <"Underlier ID (Other) Source - Leg 1">
    filter IsAllowableActionForCSA
    then if IsCSALeg1Aligned = True
        then cde.underlier.UnderlierIDOtherSourceLeg1
        else cde.underlier.UnderlierIDOtherSourceLeg2

reporting rule UnderlierIDOtherSourceLeg2 from TransactionReportInstructionBase: <"Underlier ID (Other) Source - Leg 2">
    filter IsAllowableActionForCSA
    then if IsCSALeg2Aligned = True
        then cde.underlier.UnderlierIDOtherSourceLeg2
        else cde.underlier.UnderlierIDOtherSourceLeg1

reporting rule SettlementLocationLeg1 from TransactionReportInstruction: <"Settlement Location - Leg 1">
    filter IsAllowableActionForCSA
    then extract cde.execution.SettlementLocation(PayoutLeg1)
