namespace drr.standards.iosco.cde.version1.party
version "${project.version}"

import cdm.base.staticdata.party.*
import cdm.event.common.*
import cdm.product.qualification.*

import drr.base.*
import drr.base.qualification.*
import drr.base.trade.*
import drr.base.util.party.*
import drr.standards.iosco.*
import drr.standards.iosco.cde.version1.* as cdeV1
import drr.standards.iso.*

func Direction1BuyerParty:
    inputs:
        trade Trade (1..1)
    output:
        party Party (0..1)

    alias productPayout: EconomicTermsForProduct(trade -> product) -> payout
    alias counterparty:
        if productPayout as OptionPayout exists
        then ExtractCounterpartyByRole(
                    trade -> counterparty,
                    productPayout as OptionPayout -> buyerSeller -> buyer only-element
                )
        else if product.IsCredit(trade -> product)
        then ExtractCounterpartyByRole(
                    trade -> counterparty,
                    productPayout as CreditDefaultPayout -> payerReceiver -> receiver only-element
                )
        else if product.IsVarianceSwap(trade -> product)
                or product.IsVolatilitySwap(trade -> product)
                or product.IsTotalReturnSwapDebtUnderlier(trade -> product)
        then ExtractCounterpartyByRole(
                    trade -> counterparty,
                    productPayout as PerformancePayout -> payerReceiver -> receiver only-element
                )
        else if product.IsCapFloor(trade -> product)
        then ExtractCounterpartyByRole(
                    trade -> counterparty,
                    CapFloorPayerReceiver(
                            productPayout as InterestRatePayout only-element,
                            BYER
                        )
                        default productPayout as InterestRatePayout -> payerReceiver -> receiver only-element
                )
        else if (product.IsProductETD(trade -> product)
                    and productPayout as SettlementPayout exists)
                or Qualify_InterestRate_Forward_Debt(trade -> product -> economicTerms)
                or (product.IsEquityForward(trade -> product)
                    and productPayout as SettlementPayout exists)
        then ExtractCounterpartyByRole(
                    trade -> counterparty,
                    productPayout as SettlementPayout -> payerReceiver -> payer only-element
                )
        else if product.IsSingleCommodityPayoutProduct(trade -> product)
        then ExtractCounterpartyByRole(
                    trade -> counterparty,
                    productPayout as CommodityPayout -> payerReceiver -> payer only-element
                )
        else if product.IsCommodityForward(trade -> product)
        then ExtractCounterpartyByRole(
                    trade -> counterparty,
                    productPayout as SettlementPayout -> payerReceiver -> receiver only-element
                )

    set party: counterparty -> partyReference

func Direction1SellerParty:
    inputs:
        trade Trade (1..1)
    output:
        party Party (0..1)

    alias productPayout: EconomicTermsForProduct(trade -> product) -> payout
    alias economicTerms: trade -> product -> economicTerms
    alias counterparty:
        if productPayout as OptionPayout exists
        then ExtractCounterpartyByRole(
                    trade -> counterparty,
                    productPayout as OptionPayout -> buyerSeller -> seller only-element
                )
        else if product.IsCredit(trade -> product)
        then ExtractCounterpartyByRole(
                    trade -> counterparty,
                    productPayout as CreditDefaultPayout -> payerReceiver -> payer only-element
                )
        // TH Review -> should apply to all VOL/VAR/CORR swaps. Correlation pending
        else if product.IsVarianceSwap(trade -> product)
                or product.IsVolatilitySwap(trade -> product)
                or product.IsTotalReturnSwapDebtUnderlier(trade -> product)
        then ExtractCounterpartyByRole(
                    trade -> counterparty,
                    productPayout as PerformancePayout -> payerReceiver -> payer only-element
                )
        else if product.IsCapFloor(trade -> product)
        then ExtractCounterpartyByRole(
                    trade -> counterparty,
                    CapFloorPayerReceiver(
                            productPayout as InterestRatePayout only-element,
                            SLLR
                        )
                        default productPayout as InterestRatePayout -> payerReceiver -> payer only-element
                )
        else if product.IsSingleCommodityPayoutProduct(trade -> product)
        then ExtractCounterpartyByRole(
                    trade -> counterparty,
                    productPayout as CommodityPayout -> payerReceiver -> receiver only-element
                )
        else if (product.IsProductETD(trade -> product)
                    and productPayout as SettlementPayout exists)
                or product.IsEquityForward(trade -> product)
                or Qualify_InterestRate_Forward_Debt(economicTerms)
        then ExtractCounterpartyByRole(
                    trade -> counterparty,
                    productPayout as SettlementPayout -> payerReceiver -> receiver only-element
                )
        else if product.IsCommodityForward(trade -> product)
        then ExtractCounterpartyByRole(
                    trade -> counterparty,
                    productPayout as SettlementPayout -> payerReceiver -> payer only-element
                )
    set party: counterparty -> partyReference

func CapFloorPayerReceiver:
    inputs:
        interestRatePayout cdm.product.asset.InterestRatePayout (0..1)
        side Direction1Enum (1..1)
    output:
        payerReceiver CounterpartyRoleEnum (0..1)

    alias schedule:
        [interestRatePayout -> rateSpecification as FloatingRateSpecification -> capRateSchedule, interestRatePayout -> rateSpecification as FloatingRateSpecification -> floorRateSchedule]
    alias streamPayer: interestRatePayout -> payerReceiver -> payer
    alias streamReceiver: interestRatePayout -> payerReceiver -> receiver
    alias seller:
        schedule
            extract
                if seller = Receiver
                then streamReceiver
                else if seller = Payer
                then streamPayer

    alias buyer:
        schedule
            extract
                if buyer = Receiver
                then streamReceiver
                else if buyer = Payer
                then streamPayer

    set payerReceiver:
        side switch
            BYER then buyer only-element,
            SLLR then seller only-element

func Direction1: <"2.13 Direction. Reporting counterparties should use either:
    - the element Direction 1 or Buyer identifier and Seller identifier to identify the direction of the transaction for the reporting counterparty as Buyer or Seller (model 1); or
    - the element Direction 2 or Payer identifier and Receiver identifier to identify the payer and the receiver of each leg (model 2).
    Reporting counterparties should NOT use both approaches, but adopt the appropriate one for the type of instrument concerned.">
    [docReference CPMI_IOSCO cdeV1.CDE section "2" field "13" dataElement "1"
        provision "Indicator of whether the counterparty 1 is the buyer or the seller as determined at the time of the transaction."]
    inputs:
        event TransactionReportInstructionBase (1..1)
    output:
        direction Direction1Enum (1..1)
    alias economicTerms: tradableProduct -> product -> economicTerms
    alias productPayout: EconomicTermsForProduct(tradableProduct -> product) -> payout
    alias tradableProduct: TradableProductForEvent(event)
    alias reportingParty: Counterparty1(event)
    alias buyer: Direction1BuyerParty(TradeForEvent(event))

    alias seller: Direction1SellerParty(TradeForEvent(event))
    set direction:
        if reportingParty exists and reportingParty = PartyLei(buyer -> partyId)
        then BYER
        else if reportingParty exists and reportingParty = PartyLei(seller -> partyId)
        then SLLR

func Counterparty1FromReportingSide: <"Report-agnostic extraction of the Counterparty 1 (reporting counterparty)">
    inputs:
        reportingSide ReportingSide (1..1)
    output:
        counterparty1 LEIIdentifier (1..1)
    set counterparty1: PartyLei(reportingSide -> reportingParty -> partyId)

func Counterparty2FromReportingSide: <"Report-agnostic extraction of the Counterparty 2">
    inputs:
        reportingSide ReportingSide (1..1)
    output:
        counterparty2 Min20Max72AlphaNumericText (0..1)
    set counterparty2:
        PartyLeiAndPersonByRoles(
                reportingSide -> reportingCounterparty,
                reportingSide -> reportingParty
            )

func Direction2: <"2.13 Direction. Reporting counterparties should use either:
    - the element Direction 1 or Buyer identifier and Seller identifier to identify the direction of the transaction for the reporting counterparty as Buyer or Seller (model 1); or
    - the element Direction 2 or Payer identifier and Receiver identifier to identify the payer and the receiver of each leg (model 2).
    Reporting counterparties should NOT use both approaches, but adopt the appropriate one for the type of instrument concerned.">
    [docReference CPMI_IOSCO cdeV1.CDE section "2" field "13" dataElement "1"
        provision "Indicator of whether the reporting counterparty is the payer or the receiver of the leg as determined at the time of the transaction."]
    inputs:
        payout PayoutLegWithAuxiliary (0..1)
        reportingParty CounterpartyRoleEnum (0..1)
    output:
        direction Direction2Enum (1..1)
    // This Alias should be incorperated into PayerReceiverFromPayout but has been removed due to DirectionPayer/Reicever Bug where we do not use the fixedPricePayout payerReceiver
    alias payerReceiver:
        PayerReceiverFromPayout(payout) default payout -> auxiliaryLeg -> fixedPricePayout -> payerReceiver

    set direction:
        if reportingParty exists and payerReceiver -> payer = reportingParty
        then MAKE
        else if reportingParty exists and payerReceiver -> receiver = reportingParty
        then TAKE

func PayerParty:
    [docReference CPMI_IOSCO cdeV1.CDE section "2" field "13" dataElement "1"
        provision "Indicator of whether the reporting counterparty is the payer or the receiver of the leg as determined at
            the time of the transaction.
            Or
            Identifier of the counterparty of the payer leg and the counterparty of the receiver leg as determined at
            the time of the transaction.
            A non-exhaustive list of examples of instruments for which this data element could apply are:
            • most swaps and swap-like contracts including interest rate swaps, credit total return swaps, and
            equity swaps (except for credit default swaps, variance, volatility, and correlation swaps)
            • foreign exchange swaps, forwards, non-deliverable forwards
            This data element is not applicable to instrument types covered by data elements Direction 1 or Buyer
            identifier and Seller identifier"]
    inputs:
        payout PayoutLegWithAuxiliary (0..1)
        counterparties Counterparty (2..2)
    output:
        party Party (0..1)
    set party:
        ExtractCounterpartyByRole(counterparties, PayerReceiverFromPayout(payout) -> payer) -> partyReference

func ReceiverParty:
    [docReference CPMI_IOSCO cdeV1.CDE section "2" field "13" dataElement "1"
        provision "Indicator of whether the reporting counterparty is the payer or the receiver of the leg as determined at
            the time of the transaction.
            Or
            Identifier of the counterparty of the payer leg and the counterparty of the receiver leg as determined at
            the time of the transaction.
            A non-exhaustive list of examples of instruments for which this data element could apply are:
            • most swaps and swap-like contracts including interest rate swaps, credit total return swaps, and
            equity swaps (except for credit default swaps, variance, volatility, and correlation swaps)
            • foreign exchange swaps, forwards, non-deliverable forwards
            This data element is not applicable to instrument types covered by data elements Direction 1 or Buyer
            identifier and Seller identifier"]
    inputs:
        payout PayoutLegWithAuxiliary (0..1)
        counterparties Counterparty (2..2)
    output:
        party Party (0..1)
    set party:
        ExtractCounterpartyByRole(
                counterparties,
                PayerReceiverFromPayout(payout) -> receiver
            ) -> partyReference

func PayerReceiverFromPayout:
    inputs:
        payout PayoutLegWithAuxiliary (0..1)
    output:
        payerReceiver PayerReceiver (0..1)

    set payerReceiver:
        payout -> commodityPayout -> payerReceiver
            then default payout -> fixedPricePayout -> payerReceiver
            then default payout -> performancePayout -> payerReceiver
            then default payout -> cashflow -> payerReceiver
            then default payout -> interestRatePayout -> payerReceiver
            then default payout -> auxiliaryLeg -> commodityPayout -> payerReceiver
            then default payout -> auxiliaryLeg -> interestRatePayout -> payerReceiver
