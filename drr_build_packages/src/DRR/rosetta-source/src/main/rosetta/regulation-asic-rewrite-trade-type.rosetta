            provision "Other than for OTC Derivatives that are physically settled, the currency code of the currency for the cash settlement of Leg 2 of the OTC Derivative the subject of the Reportable Transaction."]
        [ruleReference for settlementCurrency SettlementCurrencyLeg2]

        [label for nextFloatingReferenceResetDate "2.12 Next floating reference reset date - Leg 2"]
        [docReference for nextFloatingReferenceResetDate ASIC Trade table "2" dataElement "12" field "Next floating reference reset date - Leg 2"
            provision "If applicable and other than for floating reference rates that reset on a daily frequency, the unadjusted nearest date in the future on which the interest rate reference rate of Leg 2 will be reset."]
        [docReference for nextFloatingReferenceResetDate ISDA TechnicalExecutionGroup date "20240418"
            provision "Credit products are implicitly filtered out by calling the function InterestRateLeg2, so no explicit filtering is needed."]
        [ruleReference for nextFloatingReferenceResetDate NextFloatingReferenceResetDateLeg2]

        [label for notionalQuantitySchedule -> value "[Not in regulation]-$ Notional quantity which becomes effective on the associated unadjusted effective date-Leg 2 (DTCC)"]
        [docReference for notionalQuantitySchedule -> value ASIC Trade dataElement "[Not in regulation]" field "Notional quantity schedules - Notional quantity which becomes effective on the associated unadjusted effective date of leg 2 (DTCC)"
            provision "Notional quantity schedules - Notional quantity which becomes effective on the associated unadjusted effective date of leg 2."]
       
        [label for notionalQuantitySchedule -> effectiveDate "[Not in regulation]-$ Notional quantity schedules - Unadjusted date on which the associated notional quantity becomes effective of leg 2 (DTCC)"]
        [docReference for notionalQuantitySchedule -> effectiveDate ASIC Trade dataElement "[Not in regulation]" field "Notional quantity schedules - Unadjusted date on which the associated notional quantity becomes effective of leg 2"
