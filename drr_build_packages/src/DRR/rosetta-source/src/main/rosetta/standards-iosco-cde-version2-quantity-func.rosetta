namespace drr.standards.iosco.cde.version2.quantity
version "${project.version}"

import cdm.base.math.*

import drr.base.trade.*
import drr.standards.iosco.cde.version1.* as cdeV1

func Notional:
    inputs:
        payoutLeg PayoutLegWithAuxiliary (0..1)
    output:
        measure Measure (0..1)
    set measure: cdeV1.quantity.Notional(payoutLeg)

func TotalNotionalQuantity:
    inputs:
        payout PayoutLegWithAuxiliary (0..1)
        defaultValue number (1..1)
    output:
        totalTotalNotionalQuantity number (0..1)
    set totalTotalNotionalQuantity:
        cdeV1.quantity.TotalNotionalQuantity(payout, defaultValue)

func NotionalAmount:
    inputs:
        payout PayoutLegWithAuxiliary (0..1)
        defaultValue number (1..1)
    output:
        notionalAmount number (0..1)
    set notionalAmount: cdeV1.quantity.NotionalAmount(payout, defaultValue)

func NotionalAmountFormat:
    inputs:
        payout PayoutLegWithAuxiliary (0..1)
        defaultValue number (1..1)
    output:
        notionalAmount number (0..1)
    set notionalAmount: cdeV1.quantity.NotionalAmountFormat(payout, defaultValue)
