                cde.price.SpreadValue(common.PayoutLeg1),
                SpreadNotationLeg1
            )

reporting rule SpreadLeg2 from TransactionReportInstruction: <"Spread - Leg 2">
    filter IsAllowableActionForHKMA
    then price.PriceFormatFromNotation(
                cde.price.SpreadValue(common.PayoutLeg2),
                SpreadNotationLeg2
            )

reporting rule SpreadNotationLeg1 from TransactionReportInstruction: <"Spread notation - Leg 1">
    extract
        price.DefaultPercentageToDecimal(
                cde.price.SpreadNotationEnum(common.PayoutLeg1),
                False
            )

reporting rule SpreadNotationLeg2 from TransactionReportInstruction: <"Spread notation - Leg 2">
