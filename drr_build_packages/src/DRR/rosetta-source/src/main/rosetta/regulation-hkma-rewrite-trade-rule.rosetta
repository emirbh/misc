reporting rule NotionalAmountLeg1 from TransactionReportInstruction: <"Notional of Leg 1">
    filter IsAllowableAction
    then cde.quantity.NotionalAmountFormat(
                common.PayoutForQuantityLeg1,
                9999999999999999999999999
            )

reporting rule NotionalAmountLeg2 from TransactionReportInstruction: <"Notional Amount of Leg 2">
    filter IsAllowableAction
    then cde.quantity.NotionalAmountFormat(
                common.PayoutForQuantityLeg2,
                9999999999999999999999999
            )

reporting rule NotionalCurrencyLeg1 from TransactionReportInstruction: <"Notional Currency - Leg 1">
    filter IsAllowableActionForHKMA
    then cde.quantity.Notional(common.PayoutForQuantityLeg1)
    then quantity.CurrencyFromNotional

reporting rule NotionalCurrencyLeg2 from TransactionReportInstruction: <"Notional Currency - Leg 2">
    filter IsAllowableActionForHKMA
    then cde.quantity.Notional(common.PayoutForQuantityLeg2)
    then quantity.CurrencyFromNotional

reporting rule TotalNotionalQuantityLeg1 from TransactionReportInstruction: <"Total Notional Quantity - Leg 1">
    filter IsAllowableActionForHKMA
    then if IsEquity(ProductForEvent) or IsCommodity(ProductForEvent)
        then cde.quantity.TotalNotionalQuantity(
                    common.PayoutLeg1,
                    9999999999999999999999999
                )

reporting rule TotalNotionalQuantityLeg2 from TransactionReportInstruction: <"Total Notional Quantity - Leg 2">
    filter IsAllowableActionForHKMA
    then if IsCommoditySwap(ProductForEvent)
                or (IsEquity(ProductForEvent) and InterestRateLeg2(ProductForEvent) -> priceQuantity -> quantitySchedule -> unit -> financialUnit exists)
        then cde.quantity.TotalNotionalQuantity(
                    common.PayoutLeg2,
                    9999999999999999999999999
                )

reporting rule NotionalAmountScheduleLeg1 from TransactionReportInstruction: <"Notional Amount Schedule - Leg 1">
