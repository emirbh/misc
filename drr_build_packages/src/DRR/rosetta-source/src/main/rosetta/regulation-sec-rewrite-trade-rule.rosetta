                cde.price.PackageTransactionSpreadNotationEnum,
                False
            )

reporting rule FixedRateDayCountConventionLeg1 from TransactionReportInstruction: <"Fixed rate day count convention-leg 1">
    filter IsAllowableActionForSEC
    then common.payment.FixedInterestRatePayoutFromPayout(common.PayoutLeg1)
    then cde.payment.DayCountConvention

reporting rule FixedRateDayCountConventionLeg2 from TransactionReportInstruction: <"Fixed rate day count convention-leg 2">
    filter IsAllowableActionForSEC
    then common.payment.FixedInterestRatePayoutFromPayout(common.PayoutLeg2)
    then cde.payment.DayCountConvention

reporting rule FloatingRateDayCountConventionLeg1 from TransactionReportInstruction: <"Floating rate day count convention-leg 1">
    filter IsAllowableActionForSEC
    then common.payment.FloatingInterestRatePayoutFromPayout(common.PayoutLeg1)
    then cde.payment.DayCountConvention

reporting rule FloatingRateDayCountConventionLeg2 from TransactionReportInstruction: <"Floating rate day count convention-leg 2">
    filter IsAllowableActionForSEC
    then common.payment.FloatingInterestRatePayoutFromPayout(common.PayoutLeg2)
    then cde.payment.DayCountConvention

reporting rule FixingDateLeg1 from TransactionReportInstruction: <"Fixing Date Leg 1">
    filter IsAllowableActionForSEC
    then extract common.datetime.FixingDate(common.PayoutLeg1)

reporting rule FixingDateLeg2 from TransactionReportInstruction: <"Fixing Date Leg 2">
    filter IsAllowableActionForSEC
    then extract common.datetime.FixingDate(common.PayoutLeg2)

reporting rule FloatingRateResetFrequencyPeriodLeg1 from TransactionReportInstruction: <"Floating Rate Reset Frequency Period - Leg 1">
    filter IsAllowableActionForSEC
    then common.payment.FloatingInterestRatePayoutFromPayout(common.PayoutLeg1)
    then common.payment.FloatingRateResetFrequencyPeriod

reporting rule FloatingRateResetFrequencyPeriodLeg2 from TransactionReportInstruction: <"Floating Rate Reset Frequency Period - Leg 2">
    filter IsAllowableActionForSEC
    then common.payment.FloatingInterestRatePayoutFromPayout(common.PayoutLeg2)
    then common.payment.FloatingRateResetFrequencyPeriod

reporting rule FloatingRateResetFrequencyPeriodMultiplierLeg1 from TransactionReportInstruction: <"Floating Rate Reset Frequency Period Multiplier - Leg 1">
