    then extract cdeV3.price.StrikePriceCurrency

reporting rule StrikePriceNotation from TransactionReportInstruction: <"Strike Price Notation Enum">
    filter IsAllowableActionForSEC
    then price.DefaultPercentageToDecimal(cde.price.StrikePriceNotationEnum, False)

reporting rule OptionPremiumAmount from TransactionReportInstruction: <"Option Premium Amount">
    filter IsAllowableActionForSEC
    then extract cdeV3.price.OptionPremiumAmount

reporting rule OptionPremiumCurrency from TransactionReportInstruction: <"Option Premium Currency">
    filter IsAllowableActionForSEC
    then extract cdeV3.price.OptionPremiumCurrency

reporting rule OptionPremiumPaymentDate from TransactionReportInstruction: <"Option Premium Payment Date">
    filter IsAllowableActionForSEC
    then extract cde.price.OptionPremiumPaymentDate

reporting rule FirstExerciseDate from TransactionReportInstruction: <"First Exercise Date">
    filter IsAllowableActionForSEC
    then extract cdeV3.price.FirstExerciseDate

reporting rule CDSIndexAttachmentPoint from TransactionReportInstruction: <"CDS Index Attachment Point">
    filter IsAllowableActionForSEC
    then extract cde.index.CDSIndexAttachmentPoint

reporting rule CDSIndexDetachmentPoint from TransactionReportInstruction: <"CDS Index Detachment Point">
    filter IsAllowableActionForSEC
    then extract cde.index.CDSIndexDetachmentPoint

reporting rule IndexFactor from TransactionReportInstruction: <"Index Factor">
    filter IsAllowableActionForSEC
    then extract common.index.IndexFactor

reporting rule EmbeddedOptionType from TransactionReportInstruction: <"Embedded Option Type">
    filter IsAllowableActionForSEC
    then extract common.contract.EmbeddedOptionType

reporting rule CallAmount from TransactionReportInstruction: <"Call Amount">
    filter IsAllowableActionForSEC
    then cde.quantity.CallAmount

reporting rule CallCurrency from TransactionReportInstruction: <"Call Currency">
    filter IsAllowableActionForSEC
    then cde.quantity.CallCurrency

reporting rule PutAmount from TransactionReportInstruction: <"Put Amount">
    filter IsAllowableActionForSEC
    then cde.quantity.PutAmount

reporting rule PutCurrency from TransactionReportInstruction: <"Put Currency">
    filter IsAllowableActionForSEC
    then cde.quantity.PutCurrency

reporting rule UniqueProductIdentifier from TransactionReportInstruction: <"Unique Product Identifier">
    filter IsAllowableActionForSEC
    then extract upi.UniqueProductIdentifier

reporting rule FinalContractualSettlementDate from TransactionReportInstruction: <"CDE - Final Contractual Settlement Date">
    filter IsAllowableActionForSEC
    then extract cdeV3.execution.FinalContractualSettlementDate

reporting rule SettlementCurrencyLeg1 from TransactionReportInstruction: <"Settlement Currency Leg 1">
    filter IsAllowableActionForSEC
    then extract cde.execution.SettlementCurrency(common.PayoutLeg1)

reporting rule SettlementCurrencyLeg2 from TransactionReportInstruction: <"Settlement Currency Leg 2">
    filter IsAllowableActionForSEC
    then extract cde.execution.SettlementCurrency(common.PayoutLeg2)

reporting rule SettlementLocationLeg1 from TransactionReportInstruction: <"Settlement Location Leg 1 (PPD Dashboard Has Settlement Location)">
    filter IsAllowableActionForSEC
    then extract common.execution.SettlementLocation

reporting rule AllocationIndicator from TransactionReportInstruction: <"Allocation Indicator">
    filter IsAllowableActionForSEC
    then extract common.event.AllocationType

reporting rule NonStandardizedTermIndicator from TransactionReportInstruction: <"Non-standardized Term Indicator">
    filter IsAllowableActionForSEC
    then extract
        if event.IsCleared(originatingWorkflowStep) = False
                and originatingWorkflowStep -> nextEvent -> intent <> Clearing
        then common.contract.NonStandardizedTermIndicator

reporting rule EffectiveDate from TransactionReportInstruction: <"Effective Date">
    filter IsAllowableActionForSEC
    then cdeV3.datetime.EffectiveDate

reporting rule ExpirationDate from TransactionReportInstruction: <"Expiration Date">
    filter IsAllowableActionForSEC
    then extract ProductForEvent
    then extract cde.datetime.ExpirationDate

reporting rule ExecutionTimestamp from TransactionReportInstruction: <"Execution Timestamp">
    filter IsAllowableActionForSEC
    then cdeV3.datetime.ExecutionTimestamp

reporting rule PlatformIdentifier from TransactionReportInstruction: <"Platform Identifier">
    filter IsAllowableActionForSEC
    then cde.execution.PlatformIdentifier

reporting rule PriorUTI from TransactionReportInstruction: <"Prior UTI">
    filter
        IsAllowableActionForSEC and (event.IsActionTypeTERM = False or IsActionTypeEROR = False or IsActionTypePRTO = False)
    then extract common.link.GetPriorTransactionIdentifier(item, DoddFrankAct)

reporting rule UniqueSwapIdentifier from TransactionReportInstruction: <"Unique Swap Identifier (USI)">
    filter IsAllowableActionForSEC
    then extract common.link.USIID

reporting rule UniqueTransactionIdentifier from TransactionReportInstruction: <"Unique Transaction Identifier (UTI)">
    filter IsAllowableActionForSEC
    then extract
        uti.GetUniqueTransactionIdentifier(item -> reportableInformation, SEC, empty, item)
    then filter IsMax52UpperCaseAlphanumericTextWithSpecialChars = True

reporting rule Jurisdiction from TransactionReportInstruction: <"Jurisdiction">
    filter IsAllowableActionForSEC
    then extract
        if reportableInformation -> jurisdictionInformation -> supervisoryBody any = CFTC
                and reportableInformation -> jurisdictionInformation -> supervisoryBody any = SEC
        then JurisdictionEnum -> MIXX
        else if reportableInformation -> jurisdictionInformation -> supervisoryBody any = SEC
        then JurisdictionEnum -> SECH
        else if reportableInformation -> jurisdictionInformation -> supervisoryBody any = CFTC
        then JurisdictionEnum -> CFTC

reporting rule NewSDRIdentifier from TransactionReportInstruction: <"New SDR Identifier">
    filter IsActionTypePRTO
    then extract common.link.NewSDRIdentifier

reporting rule Counterparty1FinancialEntityIndicator from TransactionReportInstruction: <"Counterparty 1 Financial Entity Indicator">
    filter IsAllowableActionForSEC
    then (if IsCleared(item -> originatingWorkflowStep) = False
        then (extract
            common.party.ExtractRegimeInformation(
                    item,
                    item -> reportingSide -> reportingParty,
                    DoddFrankAct,
                    SEC
                )
        then if secPartyInformation -> financialEntity exists
            then True
            else False))

reporting rule Counterparty2FinancialEntityIndicator from TransactionReportInstruction: <"Counterparty 2 Financial Entity  Indicator">
    filter IsAllowableActionForSEC
    then (if IsCleared(item -> originatingWorkflowStep) = False
        then (extract
            common.party.ExtractRegimeInformation(
                    item,
                    item -> reportingSide -> reportingCounterparty,
                    DoddFrankAct,
                    SEC
                )
        then if secPartyInformation -> financialEntity exists
            then True
            else False))

func IsAllowableActionForSEC: <"Indicates the allowable actions for SEC">
    inputs:
        reportableEvent ReportableEventBase (1..1)
    output:
        isAllowableAction boolean (1..1)

    set isAllowableAction:
        IsActionTypeNEWT(reportableEvent)
            or IsActionTypeMODI(reportableEvent)
            or IsActionTypePositionMODI(reportableEvent)
            or IsActionTypeCORR(reportableEvent)
            or IsActionTypeREVI(reportableEvent)
            or event.IsActionTypeTERM(reportableEvent)
            or IsActionTypeEROR(reportableEvent)
            or IsActionTypePRTO(reportableEvent)
