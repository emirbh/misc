    then extract
        price.PriceFormatFromNotation(
                cde.price.SpreadValue(common.PayoutLeg2),
                SpreadNotationLeg2
            )

reporting rule SpreadNotationLeg2 from TransactionReportInstruction: <"Spread Notation Leg 2 Enum">
    filter IsAllowableActionForSEC
    then price.DefaultPercentageToDecimal(
                cde.price.SpreadNotationEnum(common.PayoutLeg2),
                False
            )

