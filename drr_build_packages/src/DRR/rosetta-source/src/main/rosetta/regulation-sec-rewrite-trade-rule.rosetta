    then common.payment.FloatingRateResetFrequencyPeriodMultiplier

reporting rule FloatingRateResetFrequencyPeriodMultiplierLeg2 from TransactionReportInstruction: <"Floating Rate Reset Frequency Period Multiplier - Leg 2">
    filter IsAllowableActionForSEC
    then common.payment.FloatingInterestRatePayoutFromPayout(common.PayoutLeg2)
    then common.payment.FloatingRateResetFrequencyPeriodMultiplier

reporting rule OtherPayment from TransactionReportInstruction: <"Other Payment">
    filter IsAllowableActionForSEC
    then extract cdeV3.payment.OtherPayment

reporting rule OtherPaymentPPD from TransactionReportInstruction: <"Other Payment PPD">
// TH Sprint 2026-04: extracts paymentType, amount, and currency for PPD, leaving date, payer, and receiver fields empty to reflect PPD scope.
    filter IsAllowableActionForSEC
    then extract cdeV3.payment.OtherPayment
    then extract
        payment.OtherPayment {
            paymentType: paymentType,
            amount: amount,
            currency: currency,
            date: empty,
            payer: empty,
            payerFormat: empty,
            receiver: empty,
            receiverFormat: empty,
            payerSchemeName: empty,
            receiverSchemeName: empty
        }

