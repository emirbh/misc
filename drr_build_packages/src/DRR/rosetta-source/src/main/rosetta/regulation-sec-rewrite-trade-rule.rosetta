namespace drr.regulation.sec.rewrite.trade
version "${project.version}"

import cdm.event.qualification.*
import cdm.product.qualification.*

import drr.base.qualification.*
import drr.base.qualification.event.*
import drr.base.qualification.product.*
import drr.base.trade.*
import drr.base.util.party.*
import drr.regulation.common.*
import drr.regulation.common.trade.* as common
import drr.regulation.sec.*
import drr.regulation.sec.rewrite.*
import drr.standards.iosco.cde.version2.* as cde
import drr.standards.iosco.cde.version3.* as cdeV3
import drr.standards.iosco.upi.* as upi
import drr.standards.iosco.uti.* as uti
import drr.standards.iso.*

corpus Dissemination Trade

corpus Dissemination PPD

report SEC Trade in T+1
  	from TransactionReportInstruction
  	when ReportableProduct
  	with type SECTransactionReportTrade

report SEC PPD in T+1
    from TransactionReportInstruction
    when ReportableProductPPD
    with type SECTransactionReportPPD

eligibility rule ReportableProduct from TransactionReportInstruction: <"When eligible for SEC">
    [docReference SEC Trade
        provision "Demonstrative eligibility rule for display"]
    True

eligibility rule ReportableProductPPD from TransactionReportInstruction: <"When eligible for SEC PPD">
    [docReference SEC PPD
        provision "Demonstrative eligibility rule for display"]
    True

// SEC Definitions
reporting rule emptyRule from TransactionReportInstruction:
    empty

reporting rule Cleared from TransactionReportInstruction: <"Cleared">
    filter IsAllowableActionForSEC
    then extract cdeV3.execution.Cleared

reporting rule CentralCounterparty from TransactionReportInstruction: <"Central Counterparty">
    filter IsAllowableActionForSEC
    then extract cdeV3.execution.CentralCounterparty

reporting rule ClearingAccountOrigin from TransactionReportInstruction: <"Clearing Account Origin">
    filter IsAllowableActionForSEC
    then extract common.execution.ClearingAccountOrigin

reporting rule ClearingMember from TransactionReportInstruction: <"Clearing Member">
    filter IsAllowableActionForSEC
    then extract cde.execution.ClearingMember

reporting rule ClearingSwapUSIs from TransactionReportInstruction: <"Clearing Swap USIs">
    filter IsAllowableActionForSEC
    then extract common.link.ClearingSwapUSIID

reporting rule ClearingSwapUTIs from TransactionReportInstruction: <"Clearing Swap UTIs">
    filter IsAllowableActionForSEC
    then extract common.link.ClearingSwapUTIID

reporting rule OriginalSwapUSI from TransactionReportInstruction: <"Original Swap USI">
    filter IsAllowableActionForSEC
    then extract common.link.OriginalSwapUSI

reporting rule OriginalSwapUTI from TransactionReportInstruction: <"Original Swap UTI">
    filter IsAllowableActionForSEC
    then extract common.link.OriginalSwapUTI
    then last

reporting rule OriginalSwapSDRIdentifier from TransactionReportInstruction: <"Original Swap SDR Identifier">
    filter IsAllowableActionForSEC
    then extract common.link.OriginalSwapSDRIdentifier

reporting rule ClearingReceiptTimestamp from TransactionReportInstruction: <"Clearing Receipt Timestamp">
    filter
        IsAllowableActionForSEC and (IsActionTypeEROR = False and IsActionTypePRTO = False)
    then extract common.datetime.ClearingReceiptTimestamp

reporting rule ClearingExceptionsAndExemptionsCounterparty1 from TransactionReportInstruction: <"Clearing Exceptions And Exemptions Counterparty 1">
    filter IsAllowableActionForSEC
    then extract
        common.execution.ClearingExceptionsAndExemptionsCounterparty(
                item,
                reportingSide -> reportingParty,
                CFTC
            )

reporting rule ClearingExceptionsAndExemptionsCounterparty2 from TransactionReportInstruction: <"Clearing Exceptions And Exemptions Counterparty 2">
    filter IsAllowableActionForSEC
    then extract
        common.execution.ClearingExceptionsAndExemptionsCounterparty(
                item,
                reportingSide -> reportingCounterparty,
                CFTC
            )

reporting rule Counterparty1 from TransactionReportInstruction: <"Counterparty 1 (reporting counterparty)">
    extract PartyLeiAndPersonByRoles(reportingSide -> reportingParty, empty)

reporting rule BuyerIdentifier from TransactionReportInstruction: <"Buyer Identifier">
    filter IsAllowableActionForSEC
    then extract cde.party.Direction1BuyerIdentifier

reporting rule SellerIdentifier from TransactionReportInstruction: <"Seller Identifier">
    filter IsAllowableActionForSEC
    then extract cde.party.Direction1SellerIdentifier

reporting rule PayerIdentifierLeg1 from TransactionReportInstruction: <"Payer Identifier Leg1">
    filter IsAllowableActionForSEC
    then if BuyerIdentifier is absent
                or IsVarianceSwap(ProductForEvent)
                or IsVolatilitySwap(ProductForEvent)
        // Ascent Uplift analysis - We are making an exception for IsVarianceSwap(ProductForEvent) or IsVolatilitySwap(ProductForEvent) as to mimic current behvaiour as still populate even if we only have a single leg
        then extract
            PartyLeiAndPersonByRoles(
                    cde.party.PayerParty(common.PayoutLeg1, CounterpartiesForEvent),
                    reportingSide -> reportingParty
                )

reporting rule PayerIdentifierLeg2 from TransactionReportInstruction: <"Payer Identifier Leg2">
    filter IsAllowableActionForSEC
    then if BuyerIdentifier is absent
                or IsVarianceSwap(ProductForEvent)
                or IsVolatilitySwap(ProductForEvent)
        then extract
            PartyLeiAndPersonByRoles(
                    cde.party.PayerParty(common.PayoutLeg2, CounterpartiesForEvent),
                    reportingSide -> reportingParty
                )

reporting rule ReceiverIdentifierLeg1 from TransactionReportInstruction: <"Receiver Identifier Leg1">
    filter IsAllowableActionForSEC
    then if SellerIdentifier is absent
                or IsVarianceSwap(ProductForEvent)
                or IsVolatilitySwap(ProductForEvent)
        then extract
            PartyLeiAndPersonByRoles(
                    cde.party.ReceiverParty(common.PayoutLeg1, CounterpartiesForEvent),
                    reportingSide -> reportingParty
                )

reporting rule ReceiverIdentifierLeg2 from TransactionReportInstruction: <"Receiver Identifier Leg2">
    filter IsAllowableActionForSEC
    then if SellerIdentifier is absent
                or IsVarianceSwap(ProductForEvent)
                or IsVolatilitySwap(ProductForEvent)
        then extract
            PartyLeiAndPersonByRoles(
                    cde.party.ReceiverParty(common.PayoutLeg2, CounterpartiesForEvent),
                    reportingSide -> reportingParty
                )

reporting rule CustomBasketIndicator from TransactionReportInstruction: <"Custom Basket Indicator">
    filter IsAllowableActionForSEC
    then extract common.basket.CustomBasketIndicator

reporting rule EventType from TransactionReportInstruction: <"Event Type">
    filter IsAllowableActionForSEC
    then if Qualify_PartialTermination(item -> originatingWorkflowStep -> businessEvent) = True
                and cdeV3.event.EventType = ETRM
        then EventTypeEnum -> TRAD
        else extract cdeV3.event.EventType

reporting rule AmendmentIndicator from TransactionReportInstruction: <"Amendment Indicator">
    filter
        IsAllowableActionForSEC and (event.IsActionTypeTERM = False and IsActionTypeEROR = False and IsActionTypePRTO = False)
    then extract common.event.AmendmentIndicator

reporting rule EventIdentifier from TransactionReportInstruction: <"Event Identifier">
    filter IsAllowableActionForSEC
    then extract cdeV3.event.EventIdentifier

reporting rule NotionalAmountLeg1 from TransactionReportInstruction: <"Notional Amount Leg 1">
    filter IsAllowableActionForSEC
    then extract
        cde.quantity.NotionalAmountFormat(
                common.PayoutForQuantityLeg1,
                99999999999999999999.99999
            )

reporting rule NotionalAmountLeg2 from TransactionReportInstruction: <"Notional Amount Leg 2">
    filter IsAllowableActionForSEC
    then extract
        cde.quantity.NotionalAmountFormat(
                common.PayoutForQuantityLeg2,
                99999999999999999999.99999
            )

reporting rule NotionalCurrencyLeg1 from TransactionReportInstruction: <"Notional Currency Leg 1">
    filter IsAllowableActionForSEC
    then extract cde.quantity.NotionalCurrency(common.PayoutForQuantityLeg1)

reporting rule NotionalCurrencyLeg2 from TransactionReportInstruction: <"Notional Currency Leg 2">
    filter IsAllowableActionForSEC
    then extract cde.quantity.NotionalCurrency(common.PayoutForQuantityLeg2)

reporting rule NotionalAmountScheduleLeg1 from TransactionReportInstruction: <"Notional Amount in Effect on Associated Effective Date - Leg 1">
    filter IsAllowableActionForSEC
    then extract cde.quantity.NotionalAmountSchedule(common.PayoutLeg1)

reporting rule NotionalAmountScheduleLeg2 from TransactionReportInstruction: <"Notional Amount Schedule Leg 2">
    filter IsAllowableActionForSEC
    then extract cde.quantity.NotionalAmountSchedule(common.PayoutLeg2)

reporting rule QuantityUnitOfMeasureLeg1 from TransactionReportInstruction: <"Quantity Unit Of Measure Leg 1">
    filter IsAllowableActionForSEC
    then extract cde.quantity.QuantityUnitOfMeasure(common.PayoutLeg1)

reporting rule QuantityUnitOfMeasureLeg2 from TransactionReportInstruction: <"Quantity Unit Of Measure Leg 2">
    filter IsAllowableActionForSEC
    then extract cde.quantity.QuantityUnitOfMeasure(common.PayoutLeg2)

reporting rule TotalNotionalQuantityLeg1 from TransactionReportInstruction: <"Total Notional Quantity Leg 1">
    filter IsAllowableActionForSEC
    then common.quantity.TotalNotionalQuantityLeg1(item, empty)

reporting rule TotalNotionalQuantityLeg2 from TransactionReportInstruction: <"Total Notional Quantity Leg 2">
    filter IsAllowableActionForSEC
    then common.quantity.TotalNotionalQuantityLeg2(item, empty)

reporting rule PackageIndicator from TransactionReportInstruction: <"Package Indicator">
    filter IsAllowableActionForSEC
    then extract common.link.PackageIndicator

reporting rule PackageIdentifier from TransactionReportInstruction: <"Package Identifier">
    filter IsAllowableActionForSEC
    then extract cde.link.PackageIdentifier

reporting rule PackageTransactionPrice from TransactionReportInstruction: <"Package Transaction Price">
    filter IsAllowableActionForSEC
    then extract
        price.PriceFormatFromNotation(
                cde.price.PackageTransactionPriceValue,
                PackageTransactionPriceNotation
            )

reporting rule PackageTransactionPriceCurrency from TransactionReportInstruction: <"Package Transaction Price Currency">
    filter IsAllowableActionForSEC
    then extract cdeV3.price.PackageTransactionPriceCurrency

reporting rule PackageTransactionPriceNotation from TransactionReportInstruction: <"Package Transaction Price Notation Enum">
    filter IsAllowableActionForSEC
    then price.DefaultPercentageToDecimal(
                cde.price.PackageTransactionPriceNotationEnum,
                False
            )

reporting rule PackageTransactionSpread from TransactionReportInstruction: <"Package Transaction Spread">
    filter IsAllowableActionForSEC
    then extract
        price.PriceFormatFromNotation(
                cde.price.PackageTransactionSpreadValue,
                PackageTransactionSpreadNotation
            )

reporting rule PackageTransactionSpreadCurrency from TransactionReportInstruction: <"Package Transaction Spread Currency">
    filter IsAllowableActionForSEC
    then extract cdeV3.price.PackageTransactionSpreadCurrency

reporting rule PackageTransactionSpreadNotation from TransactionReportInstruction: <"Package Transaction Spread Notation Enum">
