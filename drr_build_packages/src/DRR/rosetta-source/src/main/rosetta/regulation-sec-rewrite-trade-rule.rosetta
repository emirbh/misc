        price.PriceFormatFromNotation(
                cde.price.SpreadValue(common.PayoutLeg1),
                SpreadNotationLeg1
            )

reporting rule SpreadNotationLeg1 from TransactionReportInstruction: <"Spread Notation Leg 1 Enum">
    filter IsAllowableActionForSEC
    then price.DefaultPercentageToDecimal(
                cde.price.SpreadNotationEnum(common.PayoutLeg1),
                False
            )

reporting rule SpreadCurrencyLeg1 from TransactionReportInstruction: <"Spread currency Leg 1">
    filter IsAllowableActionForSEC
    then extract cde.price.SpreadCurrency(common.PayoutLeg1)

reporting rule SpreadLeg2 from TransactionReportInstruction: <"SpreadLeg2">
