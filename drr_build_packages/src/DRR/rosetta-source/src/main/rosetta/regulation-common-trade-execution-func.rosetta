namespace drr.regulation.common.trade.execution
version "${project.version}"

import cdm.base.staticdata.asset.common.*
import cdm.base.staticdata.party.*

import drr.base.qualification.event.*
import drr.regulation.common.*
import drr.standards.iosco.cde.version3.* as cde
import drr.standards.iso.*

func CentralCounterparty_Validation: <"Central Counterparty">
    inputs:
        actionType ActionTypeEnum (1..1)
        cleared ClearedEnum (1..1)
        centralCounterparty LEIIdentifier (0..1)
        clearingMember LEIIdentifier (0..1)
    output:
        result boolean (0..1)
    set result:
        if [ActionTypeEnum -> NEWT, ActionTypeEnum -> MODI, ActionTypeEnum -> CORR, ActionTypeEnum -> REVI] any = actionType
                and cleared = Y
        then centralCounterparty exists and centralCounterparty <> clearingMember
        else if cleared = N
        then centralCounterparty is absent

func ClearingMember_Validation: <"Clearing Member">
    inputs:
        actionType ActionTypeEnum (1..1)
        cleared ClearedEnum (1..1)
        centralCounterparty LEIIdentifier (0..1)
        clearingMember LEIIdentifier (0..1)
    output:
        result boolean (0..1)
    set result:
        if [ActionTypeEnum -> NEWT, ActionTypeEnum -> MODI, ActionTypeEnum -> CORR, ActionTypeEnum -> REVI] any = actionType
                and cleared = Y
        then clearingMember exists and centralCounterparty <> clearingMember
        else if cleared = N
        then clearingMember is absent

func SettlementCurrency_Validation: <"Settlement currency of the contract or leg 1 Condition. DTCC_ASIC_BR_1072_01 & DTCC_MAS_BR_0036_01">
    inputs:
        actionType ActionTypeEnum (1..1)
        settlementCurrencyLeg1 ISOCurrencyCodeEnum (1..1)
    output:
        result boolean (0..1)
    set result:
        if [ActionTypeEnum -> NEWT, ActionTypeEnum -> MODI, ActionTypeEnum -> CORR, ActionTypeEnum -> REVI] any = actionType
                and [ISOCurrencyCodeEnum -> XAG, ISOCurrencyCodeEnum -> XAU, ISOCurrencyCodeEnum -> XBA, ISOCurrencyCodeEnum -> XBB, ISOCurrencyCodeEnum -> XBC, ISOCurrencyCodeEnum -> XBD, ISOCurrencyCodeEnum -> XDR, ISOCurrencyCodeEnum -> XPD, ISOCurrencyCodeEnum -> XPT, ISOCurrencyCodeEnum -> XTS, ISOCurrencyCodeEnum -> XXX] any = settlementCurrencyLeg1
        then False

func Extract_TradingCapacity: <"Trading Capacity Of Specified Person">
    inputs:
        transactionReportInstruction TransactionReportInstruction (0..1)
        sprvsryBody SupervisoryBodyEnum (0..1)
    output:
        result TradingCapacity7Code (0..1)

    set result:
        transactionReportInstruction -> reportableInformation -> jurisdictionInformation
            then filter supervisoryBody = sprvsryBody
            then extract partyInformation
            then filter
                partyReference any = transactionReportInstruction -> reportingSide -> reportingParty
            then flatten only-element
            then extract
                if tradingCapacity = Agent
                then AGEN
                else if tradingCapacity = Principal
                then PRIN

func PlatformIdentifier: <"Identifies the trading facility on which the transaction was executed per jurisdiction">
    inputs:
        transactionReportInstruction TransactionReportInstruction (1..1)
        regimeName RegimeNameEnum (1..1)
        supervisoryBodies SupervisoryBodyEnum (1..*)
    output:
        result Max4Text (1..1)

    set result:
        if transactionReportInstruction -> reportableInformation -> enrichment -> micData is absent
                and TOTVExists(
                        transactionReportInstruction -> reportableInformation,
                        regimeName,
                        supervisoryBodies
                    )
        then (transactionReportInstruction -> reportableInformation -> jurisdictionInformation
            then filter regimeName = regimeName and supervisoryBodies any = supervisoryBody
            then transactionInformation -> tradableOnTradingVenue distinct only-element
            then if item = Admitted
                then "XOFF"
                else if item = NotAdmitted
                then "XXXX"
                else if item = Unknown
                then "BILT")
        else if transactionReportInstruction -> reportableInformation -> enrichment -> micData exists
                and ["XOFF", "XXXX", "BILT"] any = transactionReportInstruction -> reportableInformation -> enrichment -> micData only-element -> mic
        then transactionReportInstruction -> reportableInformation -> enrichment -> micData only-element -> mic
        else cde.execution.PlatformIdentifier(transactionReportInstruction)

func TOTVExists: <"Determines whether the financial instrument is admitted to trading, or traded on a trading venue or for which a request for admission was made.">
    inputs:
        reportableInformation ReportableInformation (1..1)
        regimeName RegimeNameEnum (1..1)
        supervisoryBodies SupervisoryBodyEnum (1..*)
    output:
        result boolean (1..1)

    set result:
        reportableInformation -> jurisdictionInformation
            then filter regimeName = regimeName and supervisoryBodies any = supervisoryBody
            then transactionInformation -> tradableOnTradingVenue distinct only-element
            then extract if item exists then True else False

func ClearingExceptionsAndExemptionsCounterparty: <"Specifies the clearing exceptions and exemptions">
    inputs:
        transactionReportInstruction TransactionReportInstruction (1..1)
        party Party (1..1)
        supervisor SupervisoryBodyEnum (1..1)
    output:
        exceptions ClearingExceptionsAndExemptionsEnum (0..*)

    add exceptions:
        transactionReportInstruction
            then filter
                IsCleared(originatingWorkflowStep) = False
                    and IntendedToClear(originatingWorkflowStep) = False
            then extract reportInstruction [
                reportInstruction -> reportableInformation -> jurisdictionInformation
                    filter supervisoryBody = supervisor
                    then only-element
                    then extract partyInformation
                    then filter partyReference = party
                    then filter clearingException -> clearingException = True
                    then extract clearingException -> clearingExceptionReason
                    then flatten
                    then extract ClearingExceptionsAndExemptions
            ]
