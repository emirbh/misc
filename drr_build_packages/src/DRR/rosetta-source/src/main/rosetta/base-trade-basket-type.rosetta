    customBasketCode string (0..1)

type BasketConstituentsReport:
    identifier Max210Text (0..1)
    source AssetIdTypeEnum (0..1)
    numberOfUnits Max18D13Number (0..1)
    unitOfMeasure Max4Text (0..1)
