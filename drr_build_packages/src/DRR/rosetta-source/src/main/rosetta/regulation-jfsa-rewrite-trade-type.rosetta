    override barrier common.price.SingleOrUpperAndLowerBarrier (0..1)
        [label for _single -> notation "187 Single barrier price notation"]
        [docReference for _single -> notation JFSA Trade dataElement "187" field "Single barrier price notation"
            provision "Manner in which the Single barrier price is expressed."]
        [docReference for _single -> notation JFSA Trade dataElement "187" field "Single barrier price notation" footnote "1"
