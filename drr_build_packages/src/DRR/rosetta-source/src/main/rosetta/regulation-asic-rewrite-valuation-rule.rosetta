namespace drr.regulation.asic.rewrite.valuation
version "${project.version}"

import drr.base.*
import drr.base.util.party.*
import drr.regulation.asic.*
import drr.regulation.common.*
import drr.standards.iosco.uti.*
import drr.standards.iso.*

corpus Dissemination Valuation

report ASIC Valuation in T+1
  	from ValuationReportInstruction
  	when ReportableProduct
  	with type ASICValuationReport

eligibility rule ReportableProduct from ValuationReportInstruction: <"When eligible for ASIC">
    [docReference ASIC Valuation
        provision "Demonstrative eligibility rule for display"]
    True

reporting rule UniqueTransactionIdentifier from ValuationReportInstruction: <"Unique transaction identifier">
    GetUniqueTransactionIdentifier(
            item -> reportableInformation,
            ASIC,
            item -> valuationDetails -> tradeInformation -> uniqueTradeIdentifier,
            empty
        )
        then filter IsMax52UpperCaseAlphanumericText = True

reporting rule UniqueTransactionIdentifierProprietary from ValuationReportInstruction: <"Unique transaction identifier">
    GetUniqueTransactionIdentifier(
            item -> reportableInformation,
            ASIC,
            item -> valuationDetails -> tradeInformation -> uniqueTradeIdentifier,
            empty
        )
        then filter IsMax52UpperCaseAlphanumericText = False

reporting rule Counterparty2 from ValuationReportInstruction: <"Counterparty 2">
    extract
        if (reportingSide -> reportingCounterparty -> partyId -> identifierType any = LEI
                or reportingSide -> reportingCounterparty -> personRole -> role any = Buyer
                or reportingSide -> reportingCounterparty -> personRole -> role any = Seller)
        then PartyLeiAndPersonByRoles(
                    reportingSide -> reportingCounterparty,
                    reportingSide -> reportingParty
                )
        else reportingSide -> reportingCounterparty -> partyId -> identifier first

reporting rule ExecutionAgentOfTheCounterparty1 from ValuationReportInstruction: <"Execution agent of the Counterparty 1">
    extract ReportableValuation [
        ReportableValuation -> reportableInformation -> globalPartyInformation
            filter partyReference = ReportableValuation -> reportingSide -> reportingParty
            then distinct only-element
            then extract ExtractPartyFromRelatedPartyByRole(relatedParty, ExecutionAgent)
            then extract PartyLei(partyId)
    ]

reporting rule SmallScaleBuySideEntityIndicator from ValuationReportInstruction: <"Small-scale buy-side Entity indicator">
    extract reportInstruction [
        reportableInformation -> jurisdictionInformation
            then filter supervisoryBody = ASIC
            then extract partyInformation
            then filter
                partyReference any = reportInstruction -> reportingSide -> reportingParty
            then flatten
            then extract asicPartyInformation
            then only-element
            then extract
                if smallScaleBuySideIndicator exists and smallScaleBuySideIndicator = True
                then "SSBS"
    ]

reporting rule TechnicalRecordId from ValuationReportInstruction: <"Technical Record Id (ISO)">
    extract
        if trade.link.TechnicalRecordId(reportableInformation, ASIC) -> isUnique
        then trade.link.TechnicalRecordId(reportableInformation, ASIC) -> id
        else trade.link.TechnicalRecordId(reportableInformation, ASIC) -> id + "_" + (valuation.datetime.ReportingTimestamp to-string)

reporting rule ExecutionAgentOfTheCounterparty2DTCC from ValuationReportInstruction: <"Execution Agent of Counterparty 2">
    extract reportableValuation [
        reportableValuation -> reportableInformation -> globalPartyInformation
            filter
                partyReference = reportableValuation -> reportingSide -> reportingCounterparty
            then distinct only-element
            then extract ExtractPartyFromRelatedPartyByRole(relatedParty, ExecutionAgent)
            then extract PartyLei(partyId)
    ]
