namespace drr.regulation.mas.rewrite.margin
version "${project.version}"

import cdm.base.*
import cdm.base.staticdata.asset.common.*

import drr.base.*
import drr.regulation.common.*
import drr.regulation.common.margin.*
import drr.regulation.mas.*
import drr.standards.iso.*

type MASMarginReport extends CommonMarginReport:
    override counterparty1 LEIIdentifier (1..1)
        [label "1 Counterparty 1"]
        [docReference MAS Margin dataElement "1" field "Counterparty 1"
            provision "Identifier of Counterparty 1."]
    override counterparty2 Min20Max72AlphaNumericText (0..1)
        [label "2 Counterparty 2"]
        [docReference MAS Margin dataElement "2" field "Counterparty 2"
            provision "Identifier of Counterparty 2"]
    override counterparty2IdentifierType boolean (1..1)
        [label "3 Counterparty 2 Identifier Type"]
        [docReference MAS Margin dataElement "3" field "Counterparty 2 Identifier Type"
            provision "Indicator of whether LEI (including pre-LEI) was used to identify Counterparty 2."]
    override reportSubmittingEntityID string (1..1)
        [label "9 Data submitter"]
        [docReference MAS Margin dataElement "9" field "Data submitter"
            provision "Identifier of the entity submitting information on the contract, which is reported to a licensed trade repository or licensed foreign trade repository."]
    override uti UTIIdentifier (0..1)
        [label "10 Unique Transaction Identifier (UTI)"]
        [docReference MAS Margin dataElement "10" field "Unique Transaction Identifier (UTI)"
            provision "Unique identifier to denote the contract."]
        [docReference ISDA APACJFSAPeerReviewGroup date "20251203" field "Unique Transaction Identifier (UTI)"
            provision "It has been agreed to represent the transaction identifier under reportable information, in addition to the CDM trade, because the UTI reported can vary across jurisdictions. Each regime may apply different rules for generation, formatting, and lifecycle interpretation."]
        [ruleReference UniqueTransactionIdentifier]
    override reportingTimestamp zonedDateTime (1..1)
        [label "50 Reporting Timestamp"]
        [docReference MAS Margin dataElement "50" field "Reporting timestamp"
            provision "Date and time when the contract was reported to the trade repository."]
    override collateralTimestamp zonedDateTime (0..1)
        [label "50_0 Collateral timestamp"]
        [docReference MAS Margin dataElement "50_1" field "Collateral Timestamp"
            provision "Date and time as of which the values of the margins are reported."]
    override collateralPortfolioIndicator boolean (0..1)
        [label "57 Collateral Portfolio Indicator"]
        [docReference MAS Margin dataElement "57" field "Collateral Portfolio Indicator"
            provision "Indicator of whether the collateralisation was performed on a portfolio basis."]
    override initialMarginCollateralPortfolioCode Max52AlphaNumericText (0..1)
        [label "58.1 Initial margin collateral portfolio code (DTCC)"]
        [docReference MAS Margin dataElement "58" field "Initial margin collateral portfolio code (DTCC)"
            provision "Unique code assigned by Counterparty 1 to the portfolio when collateral is reported on a portfolio basis, where applicable."]
    override variationMarginCollateralPortfolioCode Max52AlphaNumericText (1..1)
        [label "58.2 Variation margin collateral portfolio code (DTCC)"]
        [docReference MAS Margin dataElement "58" field "Initial margin collateral portfolio code (DTCC)"
            provision "Unique code assigned by Counterparty 1 to the portfolio when collateral is reported on a portfolio basis, where applicable."]
    override initialMarginPostedByTheCounterparty1PreHaircut ShortFraction5DecimalNumber (0..1)
        [label "59 Initial margin posted by Counterparty 1 (pre-haircut)"]
        [docReference MAS Margin dataElement "59" field "Initial margin posted by Counterparty 1 (pre-haircut)"
            provision "Monetary value of initial margin that has been posted by Counterparty 1, where applicable."]
    override initialMarginPostedByTheCounterparty1PostHaircut ShortFraction5DecimalNumber (0..1)
        [label "60 Initial margin posted by Counterparty 1 (post-haircut)"]
        [docReference MAS Margin dataElement "60" field "Initial margin posted by Counterparty 1 (post-haircut)"
            provision "Monetary value of initial margin that has been posted by Counterparty 1 after application of the haircut, where applicable."]
    override initialMarginPostedByCounterparty1Currency ISOCurrencyCodeEnum (0..1)
        [label "61 Currency of initial margin posted"]
        [docReference MAS Margin dataElement "61" field "Currency of initial margin posted"
            provision "Currency in which the initial margin (both pre-haircut and post-haircut) posted by Counterparty 1 is denominated, where applicable."]
    override initialMarginCollectedByCounterparty1PreHaircut ShortFraction5DecimalNumber (0..1)
        [label "62 Initial margin collected by Counterparty 1 (pre-haircut)"]
        [docReference MAS Margin dataElement "62" field "Initial margin collected by Counterparty 1 (pre-haircut)"
            provision "Monetary value of initial margin that has been collected by Counterparty 1, where applicable."]
    override initialMarginCollectedByCounterparty1PostHaircut ShortFraction5DecimalNumber (0..1)
        [label "63 Initial margin collected by the counterparty 1 (post-haircut)"]
        [docReference MAS Margin dataElement "63" field "Initial margin collected by the counterparty 1 (post-haircut)"
            provision "Monetary value of initial margin that has been collected by Counterparty 1 after application of the haircut, where applicable."]
    override initialMarginCollectedByCounterparty1Currency ISOCurrencyCodeEnum (0..1)
        [label "64 Currency of initial margin collected"]
        [docReference MAS Margin dataElement "64" field "Currency of initial margin collected"
            provision "Currency in which the initial margin (both pre-haircut and post-haircut) collected by Counterparty 1is denominated, where applicable."]
    override variationMarginPostedByTheCounterparty1PreHaircut ShortFraction5DecimalNumber (0..1)
        [label "65 Variation margin posted by Counterparty 1 (pre-haircut)"]
        [docReference MAS Margin dataElement "65" field "Variation margin posted by Counterparty 1 (pre-haircut)"
            provision "Monetary value of the variation margin posted by Counterparty 1, where applicable."]
    override variationMarginPostedByTheCounterparty1PostHaircut ShortFraction5DecimalNumber (0..1)
        [label "66 Variation margin posted by Counterparty 1 (post-haircut)"]
        [docReference MAS Margin dataElement "66" field "Variation margin posted by Counterparty 1 (post-haircut)"
            provision "Monetary value of the variation margin posted by Counterparty 1 after application of the haircut, where applicable."]
    override variationMarginPostedByCounterparty1Currency ISOCurrencyCodeEnum (0..1)
        [label "67 Currency of variation margin posted"]
        [docReference MAS Margin dataElement "67" field "Currency of variation margin posted"
            provision "Currency in which the variation margin (both pre-haircut and post-haircut) posted is denominated, where applicable."]
    override variationMarginCollectedByTheCounterparty1PreHaircut ShortFraction5DecimalNumber (0..1)
        [label "68 Variation margin collected by Counterparty 1 (pre-haircut)"]
        [docReference MAS Margin dataElement "68" field "Variation margin collected by Counterparty 1 (pre-haircut)"
            provision "Monetary value of the variation margin collected by Counterparty 1, where applicable."]
    override variationMarginCollectedByTheCounterparty1PostHaircut ShortFraction5DecimalNumber (0..1)
        [label "69 Variation margin collected by Counterparty 1 (post-haircut)"]
        [docReference MAS Margin dataElement "69" field "Variation margin collected by Counterparty 1 (post-haircut)"
            provision "Monetary value of the variation margin collected by Counterparty 1 after application of the haircut, where applicable."]
    override variationMarginCollectedByCounterparty1Currency ISOCurrencyCodeEnum (0..1)
        [label "70 Currency of variation margin collected"]
        [docReference MAS Margin dataElement "70" field "Currency of variation margin collected"
            provision "Currency in which the variation margin (both pre-haircut and post-haircut) collected by Counterparty 1 is denominated, where applicable"]
    override excessCollateralPostedByTheCounterparty1 ShortFraction5DecimalNumber (0..1)
        [label "71 Excess collateral posted by Counterparty 1"]
        [docReference MAS Margin dataElement "71" field "Excess collateral posted by Counterparty 1"
            provision "Monetary value of any additional collateral posted by Counterparty 1 which is separate and independent from initial and variation margin, where applicable."]
    override currencyOfTheExcessCollateralPosted string (0..1)
        [label "72 Currency of excess collateral posted"]
        [docReference MAS Margin dataElement "72" field "CCurrency of excess collateral posted"
            provision "Currency in which Excess collateral posted by Counterparty 1 is denominated, where applicable."]
    override excessCollateralCollectedByTheCounterparty1 ShortFraction5DecimalNumber (0..1)
        [label "73 Excess collateral collected by Counterparty 1"]
        [docReference MAS Margin dataElement "73" field "Excess collateral collected by Counterparty 1"
            provision "Monetary value of any additional collateral collected by Counterparty 1 which is separate and independent from initial margin and variation margin, where applicable."]
    override currencyOfTheExcessCollateralCollected string (0..1)
        [label  "74 Currency of excess collateral collected"]
        [docReference MAS Margin dataElement "74" field "Currency of excess collateral collected"
            provision "Currency in which Excess collateral collected by Counterparty 1 is denominated, where applicable."]
    override collateralisationCategory CollateralisationType3Code (1..1)
        [label "75 Collateralisation category"]
        [docReference MAS Margin dataElement "75" field "Collateralisation category"
            provision "Indicator of whether a collateral agreement (or collateral agreements) between the counterparties exists (uncollateralised/partially collateralised/one-way collateralised/fully collateralised) , where applicable."]
    override actionType MarginActionEnum (1..1)
        [label  "133 Action Type"]
        [docReference MAS Margin dataElement "133" field "Action type"
            provision "Type of action taken on the contract."]
    override eventTimestamp zonedDateTime (1..1)
        [label "134 Event Timestamp"]
        [docReference MAS Margin dataElement "134" field "Event Timestamp"
            provision "Date of occurrence of the event"]
    override eventDate date (0..1)
        [ruleReference empty]
    uniqueTransactionIdentifierProprietary UTIProprietaryIDFormat (0..1)
        [label "10 Unique Transaction Identifier (Proprietary)"]
        [docReference MAS Margin dataElement "10" field "Unique Transaction Identifier (UTI)"
            provision "Unique identifier to denote the contract."]
        [ruleReference UniqueTransactionIdentifierProprietary]
    technicalRecordId string (0..1)
        [label "[Internal] Technical Record Id (ISO)"]
        [docReference MAS Margin dataElement "[Internal]" field "Technical Record Id (ISO)"
            provision "Unique technical identification of the original data for which the status is provided for the BDR."]
        [ruleReference TechnicalRecordId]
    executionAgentOfTheCounterparty1 LEIIdentifier (1..1)
        [label "[Not in regulation] Execution agent of Counterparty 1 (DTCC)"]
        [docReference MAS Margin dataElement "[Not in regulation]" field "Execution agent of Counterparty 1"
            provision "LEI of the entity that entered into the Reportable Transaction as agent for the Reporting Entity without becoming a counterparty themselves."]
        [ruleReference ExecutionAgentOfTheCounterparty1DTCC]
    reportingSpecifiedPerson LEIIdentifier (1..1)
        [label "8 Reporting specified person"]
        [docReference MAS Margin dataElement "8" field "Reporting specified person"
            provision "Identifier of the specified person with the reporting obligation in respect of the contract."]
        [ruleReference ReportingSpecifiedPerson]

    condition DTCC_MAS_BR_0001_01: <"Counterparty 1 Condition">
        [docReference MAS DTCC_Specs dataElement "1" field "Counterparty 1"
        provision "When [Action Type] = NEWT, MODI, CORR, REVI, TERM, ERROR, MARU, VALU then [Counterparty 1] must NOT = [Counterparty 2]."]
        trade.party.Counterparty_Validation(
                actionType to-enum ActionTypeEnum,
                counterparty1,
                counterparty2
            )

    condition DTCC_MAS_BR_0002_01: <"Counterparty 2 Condition">
        [docReference MAS DTCC_Specs dataElement "2" field "Counterparty 2"
        provision "When [Action Type] = NEWT, MODI, CORR, REVI, TERM, ERROR, MARU, VALU then [Counterparty 1] must NOT = [Counterparty 2]."]
        trade.party.Counterparty_Validation(
                actionType to-enum ActionTypeEnum,
                counterparty1,
                counterparty2
            )

    condition DTCC_MAS_BR_0010_02: <"Unique transaction identifier Condition">
        [docReference MAS DTCC_Specs dataElement "10" field "Unique transaction identifier"
        provision "When [Action Type] = MARU, CORR then Required if [Initial margin collateral portfolio code] = 'NOAP' or Blank and [Variation margin collateral portfolio code] is = 'NOAP'. (Hence, required If  [Collateral portfolio indicator] = False.) Reject if [Collateral portfolio indicator] = True."]
        if [MarginActionEnum -> MARU, MarginActionEnum -> CORR] any = actionType
        then (if ((initialMarginCollateralPortfolioCode = "NOAP" or initialMarginCollateralPortfolioCode is absent)
                        and variationMarginCollateralPortfolioCode = "NOAP"
                    or collateralPortfolioIndicator = False)
            then required choice uti, uniqueTransactionIdentifierProprietary
            else if collateralPortfolioIndicator = True
            then uti is absent and uniqueTransactionIdentifierProprietary is absent)

    condition DTCC_MAS_BR_0050_03: <"Reporting timestamp Condition">
        [docReference MAS DTCC_Specs dataElement "50" field "Reporting timestamp"
            provision "When [Action Type] = MARU, CORR then [Reporting timestamp] must be equal to or before the [Message Received timestamp] derived by the TR.
            Reject if the date value of the [Reporting timestamp] is more than 2 days before the date value of the [Message Received timestamp]."]
        [docReference ISDA ISDAWorkingGroup date "unknown"
            provision "The logic regarding the order between submissions is not modelled. The condition cannot be executed in a stateless environment."]
        // The logic regarding the [Message Received timestamp] is not included as this data is known post submission.
        if [MarginActionEnum -> MARU, MarginActionEnum -> CORR] any = actionType
        then True

    condition DTCC_MAS_BR_0058_02: <"Initial margin collateral portfolio code Condition">
        [docReference MAS DTCC_Specs dataElement "58" field "Initial margin collateral portfolio code"
            provision "When [Action Type] = MARU, CORR then 
            Required if [Variation margin collateral portfolio code] = 'NOAP' and [Unique transaction identifier (UTI)] is blank. Reject if the value [NOAP]  is submitted in '/Prtfl/Cd'.
            Reject if [UTI] is populated and [Initial margin collateral portfolio code] does NOT = 'NOAP'.
            Note: If the [Initial margin collateral portfolio code] is not applicable to your trade, clients should submit the value [NOAP] to represent 'No Applicable' in '/NoPrtfl' XML."]
            [docReference ISDA APACJFSAPeerReviewGroup date "20240731"
            provision "The business rule contains ISO mapping validation: if the portfolio code is False, then the initial margin should be mapped as 'NOAP' to /NoPrtfl instead of /Prtfl/Cd. This check cannot be included in the business rule logic."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
        then (if variationMarginCollateralPortfolioCode = "NOAP"
                    and (uti is absent and uniqueTransactionIdentifierProprietary is absent)
            then initialMarginCollateralPortfolioCode exists
            else if uti exists
                    or uniqueTransactionIdentifierProprietary exists
                        and initialMarginCollateralPortfolioCode <> "NOAP"
            then False)

    condition DTCC_MAS_BR_0058_04: <"Variation margin collateral portfolio code Condition">
        [docReference MAS DTCC_Specs dataElement "58" field "Variation margin collateral portfolio code code"
          provision "When [Action Type] = MARU, CORR then 
          Reject if [UTI] is populated and [Variation margin collateral portfolio code] does NOT = 'NOAP'.
          Reject if the value [NOAP] is submitted in '/Prtfl/Cd'.
          Note: If the [Variation margin collateral portfolio code] is not applicable to your trade, clients must submit the value [NOAP] to represent 'No Applicable' in '/NoPrtfl' XML."]
        [docReference ISDA APACJFSAPeerReviewGroup date "20240731"
        provision "The business rule contains ISO mapping validation: if the portfolio code is False, then the variation margin should be mapped as 'NOAP' to /NoPrtfl instead of /Prtfl/Cd. This check cannot be included in the business rule logic."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
        then if (uti exists or uniqueTransactionIdentifierProprietary exists)
                    and variationMarginCollateralPortfolioCode <> "NOAP"
            then False

    condition DTCC_MAS_BR_0059_01: <"Initial margin posted by Counterparty 1 (pre-haircut) Condition">
        [docReference MAS DTCC_Specs dataElement "59" field "Initial margin posted by Counterparty 1 (pre-haircut)"
            provision "when [Action Type] = MARU, CORR then Required if [Collateralisation category] = OWC1 or OWP1 or FLCL. Reject if [Collateralisation category] does not equal to OWC1 or OWP1 or FLCL. Reject if Negative"]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
        then if [CollateralisationType3Code -> OWC1, CollateralisationType3Code -> OWC2, CollateralisationType3Code -> FLCL] any = collateralisationCategory
            then initialMarginPostedByTheCounterparty1PreHaircut exists and initialMarginPostedByTheCounterparty1PreHaircut >= 0
            else if [CollateralisationType3Code -> OWC1, CollateralisationType3Code -> OWC2, CollateralisationType3Code -> FLCL] all <> collateralisationCategory
            then initialMarginPostedByTheCounterparty1PreHaircut is absent

    condition DTCC_MAS_BR_0060_01: <"Initial margin posted by Counterparty 1 (post-haircut) Condition">
        [docReference MAS DTCC_Specs dataElement "60" field "Initial margin posted by Counterparty 1 (post-haircut)"
            provision "When [Action Type] = MARU, CORR then Required if [Collateralisation category] = OWC1 or OWP1 or FLCL. Reject if [Collateralisation category] does not equal to OWC1 or OWP1 or FLCL. Reject if Negative"]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
        then if [CollateralisationType3Code -> OWC1, CollateralisationType3Code -> OWP1, CollateralisationType3Code -> FLCL] any = collateralisationCategory
            then initialMarginPostedByTheCounterparty1PostHaircut exists and initialMarginPostedByTheCounterparty1PostHaircut >= 0
            else if [CollateralisationType3Code -> OWC1, CollateralisationType3Code -> OWP1, CollateralisationType3Code -> FLCL] all <> collateralisationCategory
            then initialMarginPostedByTheCounterparty1PostHaircut is absent

    condition DTCC_MAS_BR_0061_01: <"Currency of initial margin posted Condition">
        [docReference MAS DTCC_Specs dataElement "61" field "Currency of initial margin posted"
            provision "When [Action Type] = MARU, CORR then Required if [Initial margin posted by the reporting counterparty (pre-haircut)] is populated.
                Reject if [Currency of initial margin posted (pre-haircut)] = XAG, XAU, XBA, XBB, XBC, XBD, XDR, XEU, XFU, XPD, XPT, XTS or XXX."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
                and initialMarginPostedByTheCounterparty1PreHaircut exists
        then initialMarginPostedByCounterparty1Currency exists
                and [ISOCurrencyCodeEnum -> XAG, ISOCurrencyCodeEnum -> XAU, ISOCurrencyCodeEnum -> XBA, ISOCurrencyCodeEnum -> XBB, ISOCurrencyCodeEnum -> XBC, ISOCurrencyCodeEnum -> XBD, ISOCurrencyCodeEnum -> XDR, ISOCurrencyCodeEnum -> XPD, ISOCurrencyCodeEnum -> XPT, ISOCurrencyCodeEnum -> XTS, ISOCurrencyCodeEnum -> XXX] all <> initialMarginPostedByCounterparty1Currency

    condition DTCC_MAS_BR_0061_02: <"Currency of initial margin posted Condition">
        [docReference MAS DTCC_Specs dataElement "61" field "Currency of initial margin posted"
            provision "When [Action Type] = MARU, CORR then Required if [Initial margin posted by the reporting counterparty (post- haircut)] is populated. Reject if [Currency of initial margin posted (post-haircut)] = XAG, XAU, XBA, XBB, XBC, XBD, XDR, XEU, XFU, XPD, XPT, XTS or XXX."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
                and initialMarginPostedByTheCounterparty1PostHaircut exists
        then initialMarginPostedByCounterparty1Currency exists
                and [ISOCurrencyCodeEnum -> XAG, ISOCurrencyCodeEnum -> XAU, ISOCurrencyCodeEnum -> XBA, ISOCurrencyCodeEnum -> XBB, ISOCurrencyCodeEnum -> XBC, ISOCurrencyCodeEnum -> XBD, ISOCurrencyCodeEnum -> XDR, ISOCurrencyCodeEnum -> XPD, ISOCurrencyCodeEnum -> XPT, ISOCurrencyCodeEnum -> XTS, ISOCurrencyCodeEnum -> XXX] all <> initialMarginPostedByCounterparty1Currency

    condition DTCC_MAS_BR_0062_01: <"Initial margin collected by Counterparty 1 (pre-haircut) Condition">
        [docReference MAS DTCC_Specs dataElement "62" field "Initial margin collected by Counterparty 1 (pre-haircut)"
            provision "when [Action Type] = MARU, CORR then Required if [Collateralisation category] = OWC2 or OWP2 or FLCL. Reject if [Collateralisation category] does not equal to OWC2 or OWP2 or FLCL. Reject if Negative."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
        then if [CollateralisationType3Code -> OWC2, CollateralisationType3Code -> OWP2, CollateralisationType3Code -> FLCL] any = collateralisationCategory
            then initialMarginCollectedByCounterparty1PreHaircut exists and initialMarginCollectedByCounterparty1PreHaircut >= 0
            else if [CollateralisationType3Code -> OWC2, CollateralisationType3Code -> OWP2, CollateralisationType3Code -> FLCL] all <> collateralisationCategory
            then initialMarginCollectedByCounterparty1PreHaircut is absent

    condition DTCC_MAS_BR_0063_01: <"Initial margin collected by Counterparty 1 (post-haircut) Condition">
        [docReference MAS DTCC_Specs dataElement "63" field "Initial margin collected by Counterparty 1 (post-haircut)"
            provision "when [Action Type] = MARU, CORR then Required if [Collateralisation category] = OWC2 or OWP2 or FLCL. Reject if [Collateralisation category] does not equal to OWC2 or OWP2 or FLCL. Reject if Negative."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
        then if [CollateralisationType3Code -> OWC2, CollateralisationType3Code -> OWP2, CollateralisationType3Code -> FLCL] any = collateralisationCategory
            then initialMarginCollectedByCounterparty1PostHaircut exists and initialMarginCollectedByCounterparty1PostHaircut >= 0
            else if [CollateralisationType3Code -> OWC2, CollateralisationType3Code -> OWP2, CollateralisationType3Code -> FLCL] all <> collateralisationCategory
            then initialMarginCollectedByCounterparty1PostHaircut is absent

    condition DTCC_MAS_BR_0064_01: <"Currency of initial margin collected Condition">
        [docReference MAS DTCC_Specs dataElement "64" field "Currency of initial margin collected"
            provision "when [Action Type] = MARU, CORR then Required if [Initial margin collected by the reporting counterparty (pre-haircut)] is populated. Reject if [Currency of initial margin collected (pre-haircut)] = XAG, XAU, XBA, XBB, XBC, XBD, XDR, XEU, XFU, XPD, XPT, XTS or XXX."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
                and initialMarginCollectedByCounterparty1PreHaircut exists
        then initialMarginCollectedByCounterparty1Currency exists
                and [ISOCurrencyCodeEnum -> XAG, ISOCurrencyCodeEnum -> XAU, ISOCurrencyCodeEnum -> XBA, ISOCurrencyCodeEnum -> XBB, ISOCurrencyCodeEnum -> XBC, ISOCurrencyCodeEnum -> XBD, ISOCurrencyCodeEnum -> XDR, ISOCurrencyCodeEnum -> XPD, ISOCurrencyCodeEnum -> XPT, ISOCurrencyCodeEnum -> XTS, ISOCurrencyCodeEnum -> XXX] all <> initialMarginCollectedByCounterparty1Currency

    condition DTCC_MAS_BR_0064_02: <"Currency of initial margin collected Condition">
        [docReference MAS DTCC_Specs dataElement "64" field "Currency of initial margin collected"
            provision "When [Action Type] = MARU, CORR then Required if [Initial margin collected by the reporting counterparty (post-haircut)] is populated. Reject if [Currency of initial margin collected (post-haircut)] = XAG, XAU, XBA, XBB, XBC, XBD, XDR, XEU, XFU, XPD, XPT, XTS or XXX."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
                and initialMarginCollectedByCounterparty1PostHaircut exists
        then initialMarginCollectedByCounterparty1Currency exists
                and [ISOCurrencyCodeEnum -> XAG, ISOCurrencyCodeEnum -> XAU, ISOCurrencyCodeEnum -> XBA, ISOCurrencyCodeEnum -> XBB, ISOCurrencyCodeEnum -> XBC, ISOCurrencyCodeEnum -> XBD, ISOCurrencyCodeEnum -> XDR, ISOCurrencyCodeEnum -> XPD, ISOCurrencyCodeEnum -> XPT, ISOCurrencyCodeEnum -> XTS, ISOCurrencyCodeEnum -> XXX] all <> initialMarginCollectedByCounterparty1Currency

    condition DTCC_MAS_BR_0065_01: <"Variation margin posted by Counterparty 1 (pre-haircut) Condition">
        [docReference MAS DTCC_Specs dataElement "65" field "Variation margin posted by Counterparty 1 (pre-haircut)"
            provision "When [Action Type] = MARU, CORR then Required if [Collateralisation category] = PRC1 or PRCL or OWC1 or OWP1 or OWP2 or FLCL. Reject if [Collateralisation category] does not equal to PRC1 or PRCL or OWC1 or OWP1 or OWP2 or FLCL. Reject if Negative"]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
        then if [CollateralisationType3Code -> PRC1, CollateralisationType3Code -> PRCL, CollateralisationType3Code -> OWC1, CollateralisationType3Code -> OWP1, CollateralisationType3Code -> OWP2, CollateralisationType3Code -> FLCL] any = collateralisationCategory
            then variationMarginPostedByTheCounterparty1PreHaircut exists and initialMarginCollectedByCounterparty1PostHaircut >= 0
            else if [CollateralisationType3Code -> PRC1, CollateralisationType3Code -> PRCL, CollateralisationType3Code -> OWC1, CollateralisationType3Code -> OWP1, CollateralisationType3Code -> OWP2, CollateralisationType3Code -> FLCL] all <> collateralisationCategory
            then variationMarginPostedByTheCounterparty1PreHaircut is absent

    condition DTCC_MAS_BR_0066_01: <"Variation margin posted by Counterparty 1 (post-haircut) Condition">
        [docReference MAS DTCC_Specs dataElement "66" field "Variation margin posted by Counterparty 1 (post-haircut)"
            provision "When [Action Type] = MARU, CORR then Required if [Collateralisation category] = PRC1 or PRCL or OWC1 or OWP1 or OWP2 or FLCL. Reject if [Collateralisation category] does not equal to PRC1 or PRCL or OWC1 or OWP1 or OWP2 or FLCL. Reject if Negative."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
        then if [CollateralisationType3Code -> PRC1, CollateralisationType3Code -> PRCL, CollateralisationType3Code -> OWC1, CollateralisationType3Code -> OWP1, CollateralisationType3Code -> OWP2, CollateralisationType3Code -> FLCL] any = collateralisationCategory
            then variationMarginPostedByTheCounterparty1PostHaircut exists and initialMarginCollectedByCounterparty1PostHaircut >= 0
            else if [CollateralisationType3Code -> PRC1, CollateralisationType3Code -> PRCL, CollateralisationType3Code -> OWC1, CollateralisationType3Code -> OWP1, CollateralisationType3Code -> OWP2, CollateralisationType3Code -> FLCL] all <> collateralisationCategory
            then variationMarginPostedByTheCounterparty1PostHaircut is absent

    condition DTCC_MAS_BR_0067_01: <"Currency of variation margin posted Condition">
        [docReference MAS DTCC_Specs dataElement "67" field "Currency of variation margin posted"
            provision "When [Action Type] = MARU, CORR then Required if [Variation margin posted by the reporting counterparty (pre-haircut)] is populated. Reject if [Currency of variation margin posted (pre-haircut)] = XAG, XAU, XBA, XBB, XBC, XBD, XDR, XEU, XFU, XPD, XPT, XTS or XXX."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
                and variationMarginPostedByTheCounterparty1PreHaircut exists
        then variationMarginPostedByCounterparty1Currency exists
                and [ISOCurrencyCodeEnum -> XAG, ISOCurrencyCodeEnum -> XAU, ISOCurrencyCodeEnum -> XBA, ISOCurrencyCodeEnum -> XBB, ISOCurrencyCodeEnum -> XBC, ISOCurrencyCodeEnum -> XBD, ISOCurrencyCodeEnum -> XDR, ISOCurrencyCodeEnum -> XPD, ISOCurrencyCodeEnum -> XPT, ISOCurrencyCodeEnum -> XTS, ISOCurrencyCodeEnum -> XXX] all <> variationMarginPostedByCounterparty1Currency

    condition DTCC_MAS_BR_0067_02: <"Currency of variation margin posted Condition">
        [docReference MAS DTCC_Specs dataElement "67" field "Currency of variation margin posted"
            provision "When [Action Type] = MARU, CORR then Required if [Variation margin posted by the reporting counterparty (post-haircut)] is populated.  Reject if [Currency of variation margin posted (post-haircut)] = XAG, XAU, XBA, XBB, XBC, XBD, XDR, XEU, XFU, XPD, XPT,XTS or XXX."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
                and variationMarginPostedByTheCounterparty1PostHaircut exists
        then variationMarginPostedByCounterparty1Currency exists
                and [ISOCurrencyCodeEnum -> XAG, ISOCurrencyCodeEnum -> XAU, ISOCurrencyCodeEnum -> XBA, ISOCurrencyCodeEnum -> XBB, ISOCurrencyCodeEnum -> XBC, ISOCurrencyCodeEnum -> XBD, ISOCurrencyCodeEnum -> XDR, ISOCurrencyCodeEnum -> XPD, ISOCurrencyCodeEnum -> XPT, ISOCurrencyCodeEnum -> XTS, ISOCurrencyCodeEnum -> XXX] all <> variationMarginPostedByCounterparty1Currency

    condition DTCC_MAS_BR_0068_01: <"Variation margin collected by Counterparty 1 (pre-haircut) Condition">
        [docReference MAS DTCC_Specs dataElement "68" field "Variation margin collected by Counterparty 1 (pre-haircut)"
            provision "When [Action Type] = MARU, CORR then Required if [Collateralisation category] = PRC2 or PRCL or OWC2 or OWP1 or OWP2 or FLCL. Reject if [Collateralisation category] does not equal to PRC2 or PRCL or OWC2 or OWP1 or OWP2 or FLCL. Reject if Negative."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
        then if [CollateralisationType3Code -> PRC2, CollateralisationType3Code -> PRCL, CollateralisationType3Code -> OWC2, CollateralisationType3Code -> OWP1, CollateralisationType3Code -> OWP2, CollateralisationType3Code -> FLCL] any = collateralisationCategory
            then variationMarginCollectedByTheCounterparty1PreHaircut exists and variationMarginCollectedByTheCounterparty1PreHaircut >= 0
            else if [CollateralisationType3Code -> PRC2, CollateralisationType3Code -> PRCL, CollateralisationType3Code -> OWC2, CollateralisationType3Code -> OWP1, CollateralisationType3Code -> OWP2, CollateralisationType3Code -> FLCL] all <> collateralisationCategory
            then variationMarginCollectedByTheCounterparty1PreHaircut is absent

    condition DTCC_MAS_BR_0069_01: <"Variation margin collected by Counterparty 1 (post-haircut) Condition">
        [docReference MAS DTCC_Specs dataElement "69" field "Variation margin collected by Counterparty 1 (post-haircut)"
            provision "When [Action Type] = MARU, CORR then Required if [Collateralisation category] = PRC2 or PRCL or OWC2 or OWP1 or OWP2 or FLCL. Reject if [Collateralisation category] does not equal to PRC2 or PRCL or OWC2 or OWP1 or OWP2 or FLCL. Reject if Negative."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
        then if [CollateralisationType3Code -> PRC2, CollateralisationType3Code -> PRCL, CollateralisationType3Code -> OWC2, CollateralisationType3Code -> OWP1, CollateralisationType3Code -> OWP2, CollateralisationType3Code -> FLCL] any = collateralisationCategory
            then variationMarginCollectedByTheCounterparty1PostHaircut exists and variationMarginCollectedByTheCounterparty1PostHaircut >= 0
            else if [CollateralisationType3Code -> PRC2, CollateralisationType3Code -> PRCL, CollateralisationType3Code -> OWC2, CollateralisationType3Code -> OWP1, CollateralisationType3Code -> OWP2, CollateralisationType3Code -> FLCL] all <> collateralisationCategory
            then variationMarginCollectedByTheCounterparty1PostHaircut is absent

    condition DTCC_MAS_BR_0070_01: <"Currency of variation margin collected Condition">
        [docReference MAS DTCC_Specs dataElement "70" field "Currency of variation margin collected"
            provision "When [Action Type] = MARU, CORR then Required if [Variation margin collected by the reporting counterparty (pre-haircut)] is populated.Reject if [Currency of variation margin collected (pre-haircut)] = XAG, XAU, XBA, XBB, XBC, XBD, XDR, XEU, XFU, XPD, XPT, XTS or XXX."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
                and variationMarginCollectedByTheCounterparty1PreHaircut exists
        then variationMarginCollectedByCounterparty1Currency exists
                and [ISOCurrencyCodeEnum -> XAG, ISOCurrencyCodeEnum -> XAU, ISOCurrencyCodeEnum -> XBA, ISOCurrencyCodeEnum -> XBB, ISOCurrencyCodeEnum -> XBC, ISOCurrencyCodeEnum -> XBD, ISOCurrencyCodeEnum -> XDR, ISOCurrencyCodeEnum -> XPD, ISOCurrencyCodeEnum -> XPT, ISOCurrencyCodeEnum -> XTS, ISOCurrencyCodeEnum -> XXX] all <> variationMarginCollectedByCounterparty1Currency

    condition DTCC_MAS_BR_0070_02: <"Currency of variation margin collected Condition">
        [docReference MAS DTCC_Specs dataElement "70" field "Currency of variation margin collected"
            provision "When [Action Type] = MARU, CORR then Required if [Variation margin collected by the reporting counterparty (post-haircut)] is populated. Reject if [Currency of variation margin collected (post-haircut)] = XAG, XAU, XBA, XBB, XBC, XBD, XDR, XEU, XFU, XPD, XPT, XTS or XXX."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
                and variationMarginCollectedByTheCounterparty1PostHaircut exists
        then variationMarginCollectedByCounterparty1Currency exists
                and [ISOCurrencyCodeEnum -> XAG, ISOCurrencyCodeEnum -> XAU, ISOCurrencyCodeEnum -> XBA, ISOCurrencyCodeEnum -> XBB, ISOCurrencyCodeEnum -> XBC, ISOCurrencyCodeEnum -> XBD, ISOCurrencyCodeEnum -> XDR, ISOCurrencyCodeEnum -> XPD, ISOCurrencyCodeEnum -> XPT, ISOCurrencyCodeEnum -> XTS, ISOCurrencyCodeEnum -> XXX] all <> variationMarginCollectedByCounterparty1Currency

    condition DTCC_MAS_BR_0071_01: <"Excess colleral posted by Counterparty 1 Condition">
        [docReference MAS DTCC_Specs dataElement "71" field "Excess colleral posted by Counterparty 1"
            provision "When [Action Type] = MARU, CORR then Reject if Negative."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
        then excessCollateralPostedByTheCounterparty1 exists and excessCollateralPostedByTheCounterparty1 >= 0

    condition DTCC_MAS_BR_0072_01: <"Currency of excess collateral posted Condition">
        [docReference MAS DTCC_Specs dataElement "72" field "Currency of excess collateral posted"
            provision "When [Action Type] = MARU, CORR then Required if [Excess collateral posted by the reporting counterparty] is populated. Reject if [Currency of excess collateral posted] = XAG, XAU, XBA, XBB, XBC, XBD, XDR, XEU, XFU, XPD, XPT, XTS or XXX."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
                and excessCollateralPostedByTheCounterparty1 exists
        then currencyOfTheExcessCollateralPosted exists
                and ["XAG", "XAU", "XBA", "XBB", "XBC", "XBD", "XDR", "XEU", "XFU", "XPD", "XPT", "XTS", "XXX"] all <> currencyOfTheExcessCollateralPosted

    condition DTCC_MAS_BR_0073_01: <"Excess colleral collected by Counterparty 1 Condition">
        [docReference MAS DTCC_Specs dataElement "73" field "Excess colleral collected by Counterparty 1"
            provision "When [Action Type] = MARU, CORR then Reject if Negative."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
        then excessCollateralCollectedByTheCounterparty1 exists and excessCollateralCollectedByTheCounterparty1 >= 0

    condition DTCC_MAS_BR_0074_01: <"Currency of excess collateral collected Condition">
        [docReference MAS DTCC_Specs dataElement "74" field "Currency of excess collateral collected"
            provision "When [Action Type] = MARU, CORR then Required if [Excess collateral collected by the reporting counterparty] is populated. Reject if [Currency of excess collateral collected] = XAG, XAU, XBA, XBB, XBC, XBD, XDR, XEU, XFU, XPD, XPT, XTS or XXX."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
                and excessCollateralCollectedByTheCounterparty1 exists
        then currencyOfTheExcessCollateralCollected exists
                and ["XAG", "XAU", "XBA", "XBB", "XBC", "XBD", "XDR", "XEU", "XFU", "XPD", "XPT", "XTS", "XXX"] all <> currencyOfTheExcessCollateralCollected

    condition DTCC_MAS_BR_0132_01: <"Action type Condition">
        [docReference MAS DTCC_Specs dataElement "132" field "Action type"
            provision "When [Action Type] = NEWT, MODI, CORR, REVI, TERM, ERROR, MARU, VALU then See Action type & Event type tab for allowable combinations."]
        [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType

    condition DTCC_MAS_BR_0134_03: <"Event Timestamp Condition">
        [docReference MAS DTCC_Specs dataElement "135" field "Event Timestamp"
            provision "When [Action Type] = MARU/CORR then the date value in the [Event timestamp] must be equal to or before the date value in the [Reporting timestamp]. [Event timestamp] should not be before the [Initial Event timestamp] of the NEWT Message."]
        [docReference ISDA ISDAWorkingGroup date "unknown"
            provision "The logic regarding the [Initial event timestamp] is not modelled. The condition cannot be executed in a stateless environment."]
        if [MarginActionEnum -> MARU, MarginActionEnum -> CORR] any = actionType
        then eventTimestamp <= reportingTimestamp

    condition DTCC_MAS_BR_0001a_02: <"Execution agent of the Counterparty 1">
        [docReference MAS DTCC_Specs dataElement "[Not in regulation]" validationRule "Transaction"
        provision "When [Action Type] = MARU/CORR then [Execution agent of Counterparty 1] must NOT = [Counterparty 1] or [Counterparty 2] or [Reporting Entity]"]
        [docReference ISDA APACJFSAPeerReviewGroup date "20230515"
        provision "DTCC has provided clarification stating that the [Reporting Entity] in business rules for data field Execution Agent of the Counterparty 1 refers to [Data Submitter] field in MAS message spec v0.4."]
        if [MarginActionEnum -> CORR, MarginActionEnum -> MARU] any = actionType
        then executionAgentOfTheCounterparty1 <> counterparty1
                or executionAgentOfTheCounterparty1 <> counterparty2
                or executionAgentOfTheCounterparty1 <> reportSubmittingEntityID
