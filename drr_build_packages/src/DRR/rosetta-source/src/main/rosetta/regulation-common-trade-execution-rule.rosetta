namespace drr.regulation.common.trade.execution
version "${project.version}"

import cdm.base.*
import cdm.base.staticdata.asset.common.*

import drr.base.*
import drr.base.qualification.event.*
import drr.base.trade.*
import drr.base.util.party.*
import drr.regulation.common.*
import drr.standards.iosco.cde.version3.* as cde

reporting rule BookingLocation from TransactionReportInstruction: <"Booking location">
    extract
        reportingSide -> reportingParty -> contactInformation -> address -> country
            only-element
            to-enum ISOCountryCodeEnum

reporting rule TraderLocation from TransactionReportInstruction: <"Trader location">
    extract reportInstruction [
        reportableInformation -> globalPartyInformation
            then filter partyReference = reportInstruction -> reportingSide -> reportingParty
            then only-element
    ]
    then extract relatedPerson
    then filter role any = Trader
    then extract
        personReference -> contactInformation -> address -> country
            only-element
            to-enum ISOCountryCodeEnum

reporting rule Confirmed from TransactionReportInstruction: <"Confirmed">
    filter (IsCleared(originatingWorkflowStep) = False)
    then extract cde.execution.Confirmed

reporting rule ClearingAccountOrigin from TransactionReportInstruction: <"Clearing Account Origin">
    extract
        if IsCleared(originatingWorkflowStep) = True
        then if Counterparties(TradeForEvent)
                    any = ExtractPartyFromRelatedPartyByRole(
                            reportableInformation -> globalPartyInformation -> relatedParty,
                            ClearingFirm
                        )
            then ClearingAccountOriginEnum -> HOUS
            else ClearingAccountOriginEnum -> CLIE

reporting rule SettlementTerms from TransactionReportInstruction: <"Settlement terms">
    cde.execution.SettlementTerms(trade.PayoutLeg1)
        default cde.execution.SettlementTerms(trade.PayoutLeg2)

reporting rule SettlementLocation from TransactionReportInstruction: <"Settlement Location">
    [docReference ISDA EUUKNAPeerReviewGroup date "20250320" field "Settlement Location"
        provision "Improvement and cleaning of the logic by using the extraction of the SettlementTermsLeg1 and SettlementTermsLeg2."]
    [
        cde.execution.SettlementLocation(trade.PayoutLeg1),
        cde.execution.SettlementLocation(trade.PayoutLeg2)
    ]
        then distinct only-element
