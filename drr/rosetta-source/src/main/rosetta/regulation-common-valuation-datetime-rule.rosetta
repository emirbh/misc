namespace drr.regulation.common.valuation.datetime
version "${project.version}"

import drr.regulation.common.*
import drr.standards.iosco.cde.version1.* as cde

reporting rule ReportingTimestamp from ValuationReportInstruction: <"Reporting Timestamp">
    extract cde.datetime.ReportingTimestampFromReportableInformation(reportableInformation)

reporting rule EventDate from ValuationReportInstruction: <"Event Date">
    extract ValuationTimestamp -> date

reporting rule ValuationTimestamp from ValuationReportInstruction: <"Valuation Timestamp">
    extract valuationDetails -> valuation -> timestamp
