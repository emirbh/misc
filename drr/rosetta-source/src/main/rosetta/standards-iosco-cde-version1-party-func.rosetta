import drr.standards.iso.*

func Direction1BuyerParty:
    inputs:
        trade Trade (1..1)
    output:
        party Party (0..1)

    alias productPayout:
        EconomicTermsForProduct(trade -> tradableProduct -> product) -> payout
    alias economicTerms:
        trade -> tradableProduct -> product -> contractualProduct -> economicTerms
    alias counterparty:
        if productPayout -> optionPayout exists
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    productPayout -> optionPayout only-element -> buyerSeller -> buyer
                )
        else if product.IsCreditDefaultSwap(trade -> tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    productPayout -> creditDefaultPayout -> payerReceiver -> receiver
                )
        else if product.IsVarianceSwap(trade -> tradableProduct -> product)
                or product.IsVolatilitySwap(trade -> tradableProduct -> product)
                or product.IsTotalReturnSwapDebtUnderlier(
                        trade -> tradableProduct -> product
                    )
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    productPayout -> performancePayout only-element -> payerReceiver -> receiver
                )
        else if product.IsCapFloor(trade -> tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    productPayout -> interestRatePayout only-element -> payerReceiver -> payer
                )
        else if product.IsProductETD(trade -> tradableProduct -> product)
                and EconomicTermsForProduct(trade -> tradableProduct -> product) -> payout -> forwardPayout exists
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    EconomicTermsForProduct(trade -> tradableProduct -> product) -> payout -> forwardPayout only-element -> payerReceiver -> payer
                )
        else if product.IsSingleCommodityPayoutProduct(trade -> tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    productPayout -> commodityPayout only-element -> payerReceiver -> payer
                )
        else if Qualify_InterestRate_Forward_Debt(economicTerms)
                or product.IsEquityForward(trade -> tradableProduct -> product)
                    and productPayout -> forwardPayout exists
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    economicTerms -> payout -> forwardPayout only-element -> payerReceiver -> payer
                )
        else if product.IsCommodityForward(trade -> tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    economicTerms -> payout -> forwardPayout only-element -> payerReceiver -> receiver
                )

    set party: counterparty -> partyReference

func Direction1SellerParty:
    inputs:
        trade Trade (1..1)
    output:
        party Party (0..1)

    alias productPayout:
        EconomicTermsForProduct(trade -> tradableProduct -> product) -> payout
    alias economicTerms:
        trade -> tradableProduct -> product -> contractualProduct -> economicTerms
    alias counterparty:
        if productPayout -> optionPayout exists
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    productPayout -> optionPayout only-element -> buyerSeller -> seller
                )
        else if product.IsCreditDefaultSwap(trade -> tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    productPayout -> creditDefaultPayout -> payerReceiver -> payer
                )
        // TH Review -> should apply to all VOL/VAR/CORR swaps. Correlation pending
        else if product.IsVarianceSwap(trade -> tradableProduct -> product)
                or product.IsVolatilitySwap(trade -> tradableProduct -> product)
                or product.IsTotalReturnSwapDebtUnderlier(
                        trade -> tradableProduct -> product
                    )
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    productPayout -> performancePayout only-element -> payerReceiver -> payer
                )
        else if product.IsCapFloor(trade -> tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    productPayout -> interestRatePayout only-element -> payerReceiver -> receiver
                )
        else if product.IsSingleCommodityPayoutProduct(trade -> tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    productPayout -> commodityPayout only-element -> payerReceiver -> receiver
                )
        else if (product.IsProductETD(trade -> tradableProduct -> product)
                    and productPayout -> forwardPayout exists)
                or product.IsEquityForward(trade -> tradableProduct -> product)
                or Qualify_InterestRate_Forward_Debt(economicTerms)
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    economicTerms -> payout -> forwardPayout only-element -> payerReceiver -> receiver
                )
        else if product.IsCommodityForward(trade -> tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    trade -> tradableProduct -> counterparty,
                    economicTerms -> payout -> forwardPayout only-element -> payerReceiver -> payer
                )
    set party: counterparty -> partyReference

func Direction1: <"2.13 Direction. Reporting counterparties should use either:
    - the element Direction 1 or Buyer identifier and Seller identifier to identify the direction of the transaction for the reporting counterparty as Buyer or Seller (model 1); or
    - the element Direction 2 or Payer identifier and Receiver identifier to identify the payer and the receiver of each leg (model 2).
    Reporting counterparties should NOT use both approaches, but adopt the appropriate one for the type of instrument concerned.">
    [regulatoryReference CPMI_IOSCO cdeV1.CDE section "2" field "13" dataElement "1"
        provision "Indicator of whether the counterparty 1 is the buyer or the seller as determined at the time of the transaction."]
    inputs:
        event TransactionReportInstructionBase (1..1)
    output:
        direction Direction1Enum (1..1)
    alias economicTerms: tradableProduct -> product -> contractualProduct -> economicTerms
    alias productPayout: EconomicTermsForProduct(tradableProduct -> product) -> payout
    alias tradableProduct: TradableProductForEvent(event)
    alias reportingParty: Counterparty1(event)
    alias buyer:
        if productPayout -> optionPayout exists
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    productPayout -> optionPayout only-element -> buyerSeller -> buyer
                )
        else if product.IsCreditDefaultSwap(tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    productPayout -> creditDefaultPayout -> payerReceiver -> receiver
                )
        else if product.IsVarianceSwap(tradableProduct -> product)
                or product.IsVolatilitySwap(tradableProduct -> product)
                or product.IsTotalReturnSwapDebtUnderlier(tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    productPayout -> performancePayout only-element -> payerReceiver -> receiver
                )
        else if product.IsCapFloor(tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    productPayout -> interestRatePayout only-element -> payerReceiver -> payer
                )
        else if product.IsSingleCommodityPayoutProduct(tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    productPayout -> commodityPayout only-element -> payerReceiver -> payer
                )
        else if product.IsProductETD(tradableProduct -> product)
                and EconomicTermsForProduct(tradableProduct -> product) -> payout -> forwardPayout exists
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    productPayout -> forwardPayout only-element -> payerReceiver -> payer
                )
        else if product.IsCommodityForward(tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    economicTerms -> payout -> forwardPayout only-element -> payerReceiver -> receiver
                )
        else if Qualify_InterestRate_Forward_Debt(economicTerms)
                or product.IsEquityForward(tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    economicTerms -> payout -> forwardPayout only-element -> payerReceiver -> payer
                )
    alias seller:
        if productPayout -> optionPayout exists
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    productPayout -> optionPayout only-element -> buyerSeller -> seller
                )
        else if product.IsCreditDefaultSwap(tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    productPayout -> creditDefaultPayout -> payerReceiver -> payer
                )
        // TH Review -> should apply to all VOL/VAR/CORR swaps. Correlation pending
        else if product.IsVarianceSwap(tradableProduct -> product)
                or product.IsVolatilitySwap(tradableProduct -> product)
                or product.IsTotalReturnSwapDebtUnderlier(tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    productPayout -> performancePayout only-element -> payerReceiver -> payer
                )
        else if product.IsCapFloor(tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    productPayout -> interestRatePayout only-element -> payerReceiver -> receiver
                )
        else if product.IsSingleCommodityPayoutProduct(tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    productPayout -> commodityPayout only-element -> payerReceiver -> receiver
                )
        else if product.IsProductETD(tradableProduct -> product)
                and EconomicTermsForProduct(tradableProduct -> product) -> payout -> forwardPayout exists
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    productPayout -> forwardPayout only-element -> payerReceiver -> receiver
                )
        else if product.IsCommodityForward(tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    economicTerms -> payout -> forwardPayout only-element -> payerReceiver -> payer
                )
        else if Qualify_InterestRate_Forward_Debt(economicTerms)
                or product.IsEquityForward(tradableProduct -> product)
        then ExtractCounterpartyByRole(
                    tradableProduct -> counterparty,
                    economicTerms -> payout -> forwardPayout only-element -> payerReceiver -> receiver
                )
    set direction:
        if reportingParty = PartyLei(buyer -> partyReference -> partyId)
        then BYER
        else if reportingParty = PartyLei(seller -> partyReference -> partyId)
        then SLLR

func Counterparty1FromReportingSide: <"Report-agnostic extraction of the Counterparty 1 (reporting counterparty)">
    inputs:
        reportingSide ReportingSide (1..1)
    output:
        counterparty1 LEIIdentifier (1..1)
    set counterparty1: PartyLei(reportingSide -> reportingParty -> partyId)

func Counterparty2FromReportingSide: <"Report-agnostic extraction of the Counterparty 2">
    inputs:
        reportingSide ReportingSide (1..1)
    output:
        counterparty2 Min20Max72AlphaNumericText (0..1)
    set counterparty2:
        PartyLeiAndPersonByRoles(
                reportingSide -> reportingCounterparty,
                reportingSide -> reportingParty
            )

func Direction2: <"2.13 Direction. Reporting counterparties should use either:
    - the element Direction 1 or Buyer identifier and Seller identifier to identify the direction of the transaction for the reporting counterparty as Buyer or Seller (model 1); or
    - the element Direction 2 or Payer identifier and Receiver identifier to identify the payer and the receiver of each leg (model 2).
    Reporting counterparties should NOT use both approaches, but adopt the appropriate one for the type of instrument concerned.">
    [regulatoryReference CPMI_IOSCO cdeV1.CDE section "2" field "13" dataElement "1"
        provision "Indicator of whether the reporting counterparty is the payer or the receiver of the leg as determined at the time of the transaction."]
    inputs:
        payout PayoutLegWithAuxiliary (0..1)
        reportingParty CounterpartyRoleEnum (0..1)
    output:
        direction Direction2Enum (1..1)
    // This Alias should be incorperated into PayerReceiverFromPayout but has been removed due to DirectionPayer/Reicever Bug where we do not use the fixedPricePayout payerReceiver
    alias payerReceiver:
        PayerReceiverFromPayout(payout) default payout -> auxiliaryLeg -> fixedPricePayout -> payerReceiver

    set direction:
        if payerReceiver -> payer = reportingParty
        then MAKE
        else if payerReceiver -> receiver = reportingParty
        then TAKE

func PayerParty:
    [regulatoryReference CPMI_IOSCO cdeV1.CDE section "2" field "13" dataElement "1"
        provision "Indicator of whether the reporting counterparty is the payer or the receiver of the leg as determined at 
            the time of the transaction.  
            Or 
            Identifier of the counterparty of the payer leg and the counterparty of the receiver leg as determined at 
            the time of the transaction.  
            A non-exhaustive list of examples of instruments for which this data element could apply are: 
            • most swaps and swap-like contracts including interest rate swaps, credit total return swaps, and 
            equity swaps (except for credit default swaps, variance, volatility, and correlation swaps) 
            • foreign exchange swaps, forwards, non-deliverable forwards 
            This data element is not applicable to instrument types covered by data elements Direction 1 or Buyer 
            identifier and Seller identifier"]
    inputs:
        payout PayoutLegWithAuxiliary (0..1)
        counterparties Counterparty (2..2)
    output:
        party Party (0..1)
    set party:
        ExtractCounterpartyByRole(counterparties, PayerReceiverFromPayout(payout) -> payer) -> partyReference

func ReceiverParty:
    [regulatoryReference CPMI_IOSCO cdeV1.CDE section "2" field "13" dataElement "1"
        provision "Indicator of whether the reporting counterparty is the payer or the receiver of the leg as determined at 
            the time of the transaction.  
            Or 
            Identifier of the counterparty of the payer leg and the counterparty of the receiver leg as determined at 
            the time of the transaction.  
            A non-exhaustive list of examples of instruments for which this data element could apply are: 
            • most swaps and swap-like contracts including interest rate swaps, credit total return swaps, and 
            equity swaps (except for credit default swaps, variance, volatility, and correlation swaps) 
            • foreign exchange swaps, forwards, non-deliverable forwards 
            This data element is not applicable to instrument types covered by data elements Direction 1 or Buyer 
            identifier and Seller identifier"]
    inputs:
        payout PayoutLegWithAuxiliary (0..1)
        counterparties Counterparty (2..2)
    output:
        party Party (0..1)
    set party:
        ExtractCounterpartyByRole(
                counterparties,
                PayerReceiverFromPayout(payout) -> receiver
            ) -> partyReference

func PayerReceiverFromPayout:
    inputs:
        payout PayoutLegWithAuxiliary (0..1)
    output:
        payerReceiver PayerReceiver (0..1)

    set payerReceiver:
        payout -> commodityPayout -> payerReceiver
            then default payout -> auxiliaryLeg -> commodityPayout -> payerReceiver
            then default payout -> fixedPricePayout -> payerReceiver
            then default payout -> performancePayout -> payerReceiver
            then default payout -> cashflow -> payerReceiver
            then default payout -> interestRatePayout -> payerReceiver
            then default payout -> auxiliaryLeg -> interestRatePayout -> payerReceiver
