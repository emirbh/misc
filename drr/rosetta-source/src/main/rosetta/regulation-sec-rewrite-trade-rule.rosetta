    then extract cde.quantity.QuantityUnitOfMeasure(common.PayoutLeg2)

reporting rule TotalNotionalQuantityLeg1 from TransactionReportInstruction: <"Leg 1 - Total Notional Quantity">
    filter IsAllowableActionForSEC
    then extract cde.quantity.TotalNotionalQuantityLeg1(item, empty)

reporting rule TotalNotionalQuantityLeg2 from TransactionReportInstruction: <"Leg 2 - Total Notional Quantity">
    filter IsAllowableActionForSEC
    then extract cde.quantity.TotalNotionalQuantityLeg2(item, empty)

reporting rule PackageIndicator from TransactionReportInstruction: <"Package Indicator">
    filter IsAllowableActionForSEC
    then extract common.link.PackageIndicator

reporting rule PackageIdentifier from TransactionReportInstruction: <"CDE - Package Identifier">
    filter IsAllowableActionForSEC
    then extract cde.link.PackageIdentifier

reporting rule PackageTransactionPrice from TransactionReportInstruction: <"CDE - Package Transaction Price">
    filter IsAllowableActionForSEC
    then extract
        price.PriceFormatFromNotation(
                cde.price.PackageTransactionPriceValue,
                PackageTransactionPriceNotation
            )

reporting rule PackageTransactionPriceCurrency from TransactionReportInstruction: <"CDE - Package Transaction Price Currency">
