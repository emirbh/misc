    then extract cde.price.SpreadCurrency(common.PayoutLeg1)

reporting rule SpreadAmountLeg2 from TransactionReportInstruction: <"Leg 2 - Spread Amount">
    filter IsAllowableActionForSEC
    then extract
        price.PriceFormatFromNotation(
                cde.price.SpreadValue(common.PayoutLeg2),
                SpreadNotationLeg2
            )

reporting rule SpreadNotationLeg2 from TransactionReportInstruction: <"CDE - Spread notation - Leg 2">
    filter IsAllowableActionForSEC
    then common.price.DefaultPercentageToDecimal(
                cde.price.SpreadNotationEnum(common.PayoutLeg2),
                False
            )

reporting rule SpreadCurrencyLeg2 from TransactionReportInstruction: <"Spread Currency - Leg 2">
    filter IsAllowableActionForSEC
    then extract cde.price.SpreadCurrency(common.PayoutLeg2)

reporting rule StrikePrice from TransactionReportInstruction: <"Strike Price">
    filter IsAllowableActionForSEC
    then extract
        price.PriceFormatFromNotation(cde.price.StrikePriceValue, StrikePriceNotation)

reporting rule StrikePriceCurrency from TransactionReportInstruction: <"Strike Price - Currency">
    filter IsAllowableActionForSEC
    then extract cdeV3.price.StrikePriceCurrency

reporting rule StrikePriceNotation from TransactionReportInstruction: <"CDE - Strike price notation">
    filter IsAllowableActionForSEC
    then common.price.DefaultPercentageToDecimal(cde.price.StrikePriceNotationEnum, False)

reporting rule PremiumAmount from TransactionReportInstruction: <"Premium Amount">
    filter IsAllowableActionForSEC
    then extract cdeV3.price.OptionPremiumAmount

reporting rule PremiumCurrency from TransactionReportInstruction: <"Premium Currency">
    filter IsAllowableActionForSEC
    then extract cdeV3.price.OptionPremiumCurrency

reporting rule PremiumPaymentDateUnadjusted from TransactionReportInstruction: <"Premium Payment Date Unadjusted">
    filter IsAllowableActionForSEC
    then extract cde.price.OptionPremiumPaymentDate

reporting rule FirstExerciseDate from TransactionReportInstruction: <"CDE - First Exercise Date">
    filter IsAllowableActionForSEC
    then extract cdeV3.price.FirstExerciseDate

reporting rule AttachmentPoint from TransactionReportInstruction: <"Attachment Point">
    filter IsAllowableActionForSEC
    then extract cde.index.CDSIndexAttachmentPoint

reporting rule ExhaustionPoint from TransactionReportInstruction: <"Exhaustion Point">
    filter IsAllowableActionForSEC
    then extract cde.index.CDSIndexDetachmentPoint

reporting rule IndexFactor from TransactionReportInstruction: <"Index Factor">
    filter IsAllowableActionForSEC
    then extract common.index.IndexFactor

reporting rule EmbeddedOptionOnSwap from TransactionReportInstruction: <"Embedded Option on Swap">
    filter IsAllowableActionForSEC
    then extract common.contract.EmbeddedOptionType

reporting rule UPI from TransactionReportInstruction: <"UPI">
    filter IsAllowableActionForSEC
    then extract upi.UniqueProductIdentifier

reporting rule FinalContractualSettlementDate from TransactionReportInstruction: <"CDE - Final Contractual Settlement Date">
    filter IsAllowableActionForSEC
    then extract cdeV3.execution.FinalContractualSettlementDate

reporting rule SettlementCurrency1 from TransactionReportInstruction: <"Settlement Currency 1">
    filter IsAllowableActionForSEC
    then extract cde.execution.SettlementCurrency(common.PayoutLeg1)

reporting rule SettlementCurrency2 from TransactionReportInstruction: <"Leg 2 - Settlement Currency">
    filter IsAllowableActionForSEC
    then extract cde.execution.SettlementCurrency(common.PayoutLeg2)

reporting rule SettlementLocationLeg1 from TransactionReportInstruction: <"CDE - Settlement location - Leg 1">
    filter IsAllowableActionForSEC
    then extract common.execution.SettlementLocation

reporting rule AllocationType from TransactionReportInstruction: <"Allocation Type">
    filter IsAllowableActionForSEC
    then extract common.event.AllocationType

reporting rule NonStandardTradeIndicator from TransactionReportInstruction: <"Non Standard Trade Indicator">
    filter IsAllowableActionForSEC
    then extract
        if event.IsCleared(originatingWorkflowStep) = False
                and originatingWorkflowStep -> nextEvent -> intent <> EventIntentEnum -> Clearing
        then common.contract.NonStandardizedTermIndicator

reporting rule EffectiveDate from TransactionReportInstruction: <"CDE - Effective Date">
    filter IsAllowableActionForSEC
    then cdeV3.datetime.EffectiveDate

reporting rule ExpirationDate from TransactionReportInstruction: <"CDE - Expiration Date">
    filter IsAllowableActionForSEC
    then extract ProductForEvent
    then extract cde.datetime.ExpirationDate

reporting rule OriginalExecutionTimestamp from TransactionReportInstruction: <"Original Execution Timestamp">
    filter IsAllowableActionForSEC
    then cdeV3.datetime.ExecutionTimestamp

reporting rule PlatformIdentifier from TransactionReportInstruction: <"CDE - Platform Identifier">
    filter IsAllowableActionForSEC
    then cde.execution.PlatformIdentifier

reporting rule PriorUTIID from TransactionReportInstruction: <"Prior UTI ID">
    filter
        IsAllowableActionForSEC and (event.IsActionTypeTERM = False or IsActionTypeEROR = False or IsActionTypePRTO = False)
    then extract common.link.GetPriorTransactionIdentifier(item, DoddFrankAct)

reporting rule USIID from TransactionReportInstruction: <"USI ID">
    filter IsAllowableActionForSEC
    then extract common.link.USIID

reporting rule UTIID from TransactionReportInstruction: <"UTI ID">
    filter IsAllowableActionForSEC
    then extract uti.UniqueTransactionIdentifierForTransaction(item, SEC)

reporting rule SwapReportingJurisdiction from TransactionReportInstruction: <"Swap Reporting Jurisdiction">
    filter IsAllowableActionForSEC
    then extract
        if reportableInformation -> partyInformation -> regimeInformation -> supervisoryBody any = SupervisoryBodyEnum -> CFTC
                and reportableInformation -> partyInformation -> regimeInformation -> supervisoryBody any = SupervisoryBodyEnum -> SEC
        then JurisdictionEnum -> MIXX
        else if reportableInformation -> partyInformation -> regimeInformation -> supervisoryBody any = SupervisoryBodyEnum -> SEC
        then JurisdictionEnum -> SECH
        else if reportableInformation -> partyInformation -> regimeInformation -> supervisoryBody any = SupervisoryBodyEnum -> CFTC
        then JurisdictionEnum -> CFTC

reporting rule NewSDRIdentifier from TransactionReportInstruction: <"New SDR Identifier">
    filter IsActionTypePRTO
    then extract common.link.NewSDRIdentifier

reporting rule Counterparty1FinancialEntityIndicator from TransactionReportInstruction: <"Counterparty 1 Financial Entity Indicator">
    filter IsAllowableActionForSEC
    then extract common.party.Counterparty1FinancialEntityIndicator

reporting rule Counterparty2FinancialEntityIndicator from TransactionReportInstruction: <"Counterparty 2 Financial Entity  Indicator">
    filter IsAllowableActionForSEC
    then extract common.party.Counterparty2FinancialEntityIndicator

func IsAllowableActionForSEC: <"Indicates the allowable actions for SEC">
    inputs:
        reportableEvent ReportableEventBase (1..1)
    output:
        isAllowableAction boolean (1..1)

    set isAllowableAction:
        IsActionTypeNEWT(reportableEvent)
            or IsActionTypeMODI(reportableEvent)
            or IsActionTypePositionMODI(reportableEvent)
            or IsActionTypeCORR(reportableEvent)
            or IsActionTypeREVI(reportableEvent)
            or event.IsActionTypeTERM(reportableEvent)
            or IsActionTypeEROR(reportableEvent)
            or IsActionTypePRTO(reportableEvent)
