reporting rule FixedRateInitialLeg1 from TransactionReportInstruction: <"Leg 1 - Fixed Rate Initial">
    filter IsAllowableActionForSEC
    then cde.price.FixedRate(InterestRateLeg1(ProductForEvent))

reporting rule FixedRateInitialLeg2 from TransactionReportInstruction: <"Leg 2 - Fixed Rate Initial">
    filter IsAllowableActionForSEC
    then cde.price.FixedRate(InterestRateLeg2(ProductForEvent))

reporting rule PostPricedSwapIndicator from TransactionReportInstruction: <"Post-priced swap indicator">
    filter IsAllowableActionForSEC
    then extract common.link.PostPricedSwapIndicator

reporting rule Price from TransactionReportInstruction: <"Price 1 - Price">
    filter IsAllowableActionForSEC
    then filter
        Qualify_AssetClass_Commodity(EconomicTermsForProduct(ProductForEvent))
            or Qualify_AssetClass_Equity(EconomicTermsForProduct(ProductForEvent))
            or IsFixedFloatZeroCouponSwapKnownAmount(ProductForEvent)
    then extract price.PriceFormatFromNotation(cde.price.PriceValue, PriceNotation)

reporting rule PriceCurrency from TransactionReportInstruction: <"CDE - Price Currency">
    filter IsAllowableActionForSEC
    then filter
        Qualify_AssetClass_Commodity(EconomicTermsForProduct(ProductForEvent))
            or Qualify_AssetClass_Equity(EconomicTermsForProduct(ProductForEvent))
            or IsFixedFloatZeroCouponSwapKnownAmount(ProductForEvent)
    then extract cde.price.PriceCurrency

reporting rule PriceNotation from TransactionReportInstruction: <"CDE - Price Notation">
    filter IsAllowableActionForSEC
    then filter
        Qualify_AssetClass_Commodity(EconomicTermsForProduct(ProductForEvent))
            or Qualify_AssetClass_Equity(EconomicTermsForProduct(ProductForEvent))
            or IsFixedFloatZeroCouponSwapKnownAmount(ProductForEvent)
    then extract common.price.DefaultPercentageToDecimal(cde.price.PriceNotation, False)

reporting rule Units from TransactionReportInstruction: <"Price 1 - Units">
