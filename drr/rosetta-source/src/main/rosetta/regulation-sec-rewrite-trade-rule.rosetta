    then cde.payment.PaymentFrequencyPeriod

reporting rule FixedRatePaymentFrequencyPeriodLeg2 from TransactionReportInstruction: <"CDE - Fixed Rate Payment Frequency Period - Leg 2">
    filter IsAllowableActionForSEC
    then common.payment.FixedInterestRatePayoutFromPayout(common.PayoutLeg2)
    then cde.payment.PaymentFrequencyPeriod

reporting rule FloatingRatePaymentFrequencyPeriodLeg1 from TransactionReportInstruction: <"CDE - Floating Rate Payment Frequency Period - Leg 1">
    filter IsAllowableActionForSEC
    then common.payment.FloatingInterestRatePayoutFromPayout(common.PayoutLeg1)
    then cde.payment.PaymentFrequencyPeriod

reporting rule FloatingRatePaymentFrequencyPeriodLeg2 from TransactionReportInstruction: <"CDE - Floating Rate Payment Frequency Period - Leg 2">
    filter IsAllowableActionForSEC
    then common.payment.FloatingInterestRatePayoutFromPayout(common.PayoutLeg2)
    then cde.payment.PaymentFrequencyPeriod

