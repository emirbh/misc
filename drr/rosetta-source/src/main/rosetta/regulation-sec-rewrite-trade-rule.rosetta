namespace drr.regulation.sec.rewrite.trade
version "${project.version}"

import cdm.event.common.*
import cdm.event.qualification.*
import cdm.product.* as product
import cdm.product.qualification.*

import drr.base.qualification.*
import drr.base.qualification.event.*
import drr.base.trade.*
import drr.base.util.party.*
import drr.regulation.common.*
import drr.regulation.common.trade.* as common
import drr.regulation.sec.*
import drr.regulation.sec.rewrite.*
import drr.standards.iosco.cde.version2.* as cde
import drr.standards.iosco.cde.version3.* as cdeV3
import drr.standards.iosco.upi.* as upi
import drr.standards.iosco.uti.* as uti
import drr.standards.iso.*

corpus Dissemination Trade

report SEC Trade in T+1
  	from TransactionReportInstruction
  	when ReportableProduct
  	with type SECTransactionReport

eligibility rule ReportableProduct from TransactionReportInstruction: //To ask
    [regulatoryReference SEC Trade
        provision "Demonstrative eligibility rule for display"]
    True

reporting rule ClearingStatus from TransactionReportInstruction: <"Clearing Status">
    filter IsAllowableActionForSEC
    then extract cdeV3.execution.Cleared

reporting rule ClearingVenueID from TransactionReportInstruction: <"Clearing Venue - ID">
    filter IsAllowableActionForSEC
    then extract cdeV3.execution.CentralCounterparty

reporting rule Origin from TransactionReportInstruction: <"Origin">
    filter IsAllowableActionForSEC
    then extract common.execution.ClearingAccountOrigin

reporting rule TradeParty1ClearingBrokerID from TransactionReportInstruction: <"Trade Party 1 - Clearing Broker ID">
    filter IsAllowableActionForSEC
    then extract cde.execution.ClearingMember

reporting rule ClearingSwapUSIID from TransactionReportInstruction: <"Clearing Swap USI ID">
    filter IsAllowableActionForSEC
    then extract common.link.ClearingSwapUSIID

reporting rule ClearingSwapUTIID from TransactionReportInstruction: <"Clearing Swap UTI ID">
    filter IsAllowableActionForSEC
    then extract common.link.ClearingSwapUTIID

reporting rule OriginalSwapUSI from TransactionReportInstruction: <"Original Swap USI">
    filter IsAllowableActionForSEC
    then extract common.link.OriginalSwapUSI

reporting rule OriginalSwapUTI from TransactionReportInstruction: <"Original Swap UTI">
    filter IsAllowableActionForSEC
    then extract common.link.OriginalSwapUTI
    then last

reporting rule OriginalSwapSDRID from TransactionReportInstruction: <"Original Swap SDR - ID">
    filter IsAllowableActionForSEC
    then extract common.link.OriginalSwapSDRIdentifier

reporting rule ClearingReceiptDateTime from TransactionReportInstruction: <"Clearing Receipt DateTime">
    filter
        IsAllowableActionForSEC and (IsActionTypeEROR = False and IsActionTypePRTO = False)
    then extract common.datetime.ClearingReceiptTimestamp

reporting rule ClearingExceptionType from TransactionReportInstruction: <"Clearing Exception Type">
    filter IsAllowableActionForSEC
    then filter
        event.IsCleared(originatingWorkflowStep) = False
            and event.IntendedToClear(originatingWorkflowStep) = False
    then extract reportInstruction [
        reportInstruction -> reportableInformation -> partyInformation
            filter partyReference = reportInstruction -> reportingSide -> reportingParty
            then filter
                regimeInformation -> clearingException -> clearingException any = True
            then extract regimeInformation
            then flatten
            then filter supervisoryBody = SupervisoryBodyEnum -> CFTC
            then extract clearingException -> clearingExceptionReason
            then flatten
            then extract ClearingExceptionsAndExemptions
    ]

reporting rule ClearingExceptionTypeParty2 from TransactionReportInstruction: <"Clearing Exception Type - Party 2">
    filter IsAllowableActionForSEC
    then filter
        event.IsCleared(originatingWorkflowStep) = False
            and event.IntendedToClear(originatingWorkflowStep) = False
    then extract reportInstruction [
        reportInstruction -> reportableInformation -> partyInformation
            filter
                partyReference = reportInstruction -> reportingSide -> reportingCounterparty
            then filter
                regimeInformation -> clearingException -> clearingException any = True
            then extract regimeInformation
            then flatten
            then filter supervisoryBody = SupervisoryBodyEnum -> CFTC
            then extract clearingException -> clearingExceptionReason
            then flatten
            then extract ClearingExceptionsAndExemptions
    ]

reporting rule TradeParty1ID from TransactionReportInstruction: <"Trade Party 1 - ID)">
    extract PartyLeiAndPersonByRoles(reportingSide -> reportingParty, empty)

reporting rule BuyerPayer1 from TransactionReportInstruction: <"Buyer / Payer 1">
    filter IsAllowableActionForSEC
    then extract cde.party.Direction1BuyerIdentifier

reporting rule SellerPayer2 from TransactionReportInstruction: <"Seller / Payer 2">
    filter IsAllowableActionForSEC
    then extract cde.party.Direction1SellerIdentifier

reporting rule Payment1Payer from TransactionReportInstruction: <"Payment 1 - Payer">
    filter IsAllowableActionForSEC
    then extract PartyLeiAndPersonByRoles(PayerPartyLeg1, reportingSide -> reportingParty)

reporting rule Payment2Payer from TransactionReportInstruction: <"Payment 2 - Payer">
    filter IsAllowableActionForSEC
    then extract PartyLeiAndPersonByRoles(PayerPartyLeg2, reportingSide -> reportingParty)

reporting rule Payment1Receiver from TransactionReportInstruction: <"Payment 1 - Receiver">
    filter IsAllowableActionForSEC
    then extract
        PartyLeiAndPersonByRoles(ReceiverPartyLeg1, reportingSide -> reportingParty)

reporting rule ReceiverIdentifierLeg2 from TransactionReportInstruction: <"CDE - Receiver Identifier - Leg 2">
    filter IsAllowableActionForSEC
    then extract
        PartyLeiAndPersonByRoles(ReceiverPartyLeg2, reportingSide -> reportingParty)

reporting rule CustomBasketIndicator from TransactionReportInstruction: <"Custom Basket Indicator">
    filter IsAllowableActionForSEC
    then extract common.basket.CustomBasketIndicator

reporting rule EventType from TransactionReportInstruction: <"Event Type">
    filter IsAllowableActionForSEC
    then if Qualify_PartialTermination(item -> originatingWorkflowStep -> businessEvent) = True
                and cdeV3.event.EventType = ETRM
        then EventTypeEnum -> TRAD
        else extract cdeV3.event.EventType

reporting rule AmendmentIndicator from TransactionReportInstruction: <"Amendment Indicator">
    filter
        IsAllowableActionForSEC and (event.IsActionTypeTERM = False and IsActionTypeEROR = False and IsActionTypePRTO = False)
    then extract common.event.AmendmentIndicator

reporting rule EventIdentifier from TransactionReportInstruction: <"Event Identifier">
    filter IsAllowableActionForSEC
    then extract cdeV3.event.EventIdentifier

reporting rule NotionalAmount1 from TransactionReportInstruction: <"Notional Amount 1">
    filter IsAllowableActionForSEC
    then extract cde.quantity.NotionalAmountLeg1(item, 99999999999999999999.99999)

reporting rule NotionalAmount2 from TransactionReportInstruction: <"Notional Amount 2">
    filter IsAllowableActionForSEC
    then extract cde.quantity.NotionalAmountLeg2(item, 99999999999999999999.99999)

reporting rule NotionalCurrency1 from TransactionReportInstruction: <"Notional Currency 1">
    filter IsAllowableActionForSEC
    then extract cde.quantity.NotionalCurrencyLeg1

reporting rule NotionalCurrency2 from TransactionReportInstruction: <"Notional Currency 2">
    filter IsAllowableActionForSEC
    then extract cde.quantity.NotionalCurrencyLeg2

reporting rule NotionalAmountScheduleLeg1 from TransactionReportInstruction: <"Notional Amount in Effect on Associated Effective Date - Leg 1">
    filter IsAllowableActionForSEC
    then extract cde.quantity.NotionalAmountSchedule(common.PayoutLeg1)

reporting rule NotionalAmountScheduleLeg2 from TransactionReportInstruction: <"Notional Amount Schedule Leg 2">
    filter IsAllowableActionForSEC
    then extract cde.quantity.NotionalAmountSchedule(common.PayoutLeg2)

reporting rule QuantityUnitOfMeasureLeg1 from TransactionReportInstruction: <"CDE - Quantity unit of measure - Leg 1">
