    filter IsAllowableActionForCSA
    then if IsCSALeg1Aligned
        then CSALegEnrichment(
                    common.LegEnrichment(
                            cde.Leg1(item, SpreadNotationLeg1, 99999999999999999999.99999),
                            cde.quantity.NotionalAmountSchedule(common.PayoutLeg1),
                            cde.quantity.NotionalQuantitySchedule(common.PayoutLeg1),
                            common.quantity.NotionalQuantityLeg1,
                            common.payment.FloatingInterestRatePayoutFromPayout(
                                    common.PayoutLeg1
                                )
                                then common.payment.FloatingRateResetFrequencyPeriod,
                            common.payment.FloatingInterestRatePayoutFromPayout(
                                    common.PayoutLeg1
                                )
