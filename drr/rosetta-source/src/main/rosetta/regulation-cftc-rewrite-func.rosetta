import drr.regulation.common.trade.* as common
import drr.standards.iosco.cde.version2.* as cde
import drr.standards.iosco.cde.version2.quantity.*

func PayerPartyLeg1:
    inputs:
        transaction TransactionReportInstruction (0..1)
    output:
        party Party (0..1)
    set party:
        cde.party.PayerParty(
                common.PayoutLeg1(transaction),
                CounterpartiesForEvent(transaction)
            )

func PayerPartyLeg2:
    inputs:
        transaction TransactionReportInstruction (0..1)
    output:
        party Party (0..1)
    set party:
        cde.party.PayerParty(
                common.PayoutLeg2(transaction),
                CounterpartiesForEvent(transaction)
            )

