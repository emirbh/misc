namespace drr.regulation.common.trade.underlier
version "${project.version}"

import cdm.base.staticdata.asset.common.*
import cdm.product.asset.*
import cdm.product.qualification.*

import drr.base.qualification.product.*
import drr.base.trade.*
import drr.regulation.common.*
import drr.standards.iso.*

reporting rule NameOfTheUnderlyingIndex from TransactionReportInstruction: <"Name of the underlying index">
    extract
        (if IsCreditSwaption(ProductForEvent) or IsIRSwaption(ProductForEvent)
        then underlier.UnderlierForProduct(ProductForEvent)
        else ProductForEvent)
    then extract
        (if contractualProduct -> economicTerms -> payout -> creditDefaultPayout -> generalTerms -> indexReferenceInformation exists
        then contractualProduct -> economicTerms -> payout -> creditDefaultPayout -> generalTerms -> indexReferenceInformation -> indexName
        else if underlier.UnderlierForProduct -> contractualProduct -> economicTerms -> payout -> creditDefaultPayout -> generalTerms -> indexReferenceInformation exists
        then underlier.UnderlierForProduct -> contractualProduct -> economicTerms -> payout -> creditDefaultPayout -> generalTerms -> indexReferenceInformation -> indexName
        else if underlier.UnderlierForProduct -> index exists
                and underlier.UnderlierForProduct -> index -> productIdentifier -> source any = ProductIdTypeEnum -> Name
        then (underlier.UnderlierForProduct -> index -> productIdentifier
            then filter source = ProductIdTypeEnum -> Name
            then extract identifier)
        else if contractualProduct -> economicTerms -> payout -> performancePayout -> underlier -> index exists
        then (contractualProduct -> economicTerms -> payout -> performancePayout -> underlier -> index -> productIdentifier
            then filter source = ProductIdTypeEnum -> Name
            then extract identifier)
        else if contractualProduct -> economicTerms -> payout -> commodityPayout -> underlier -> index exists
        then (contractualProduct -> economicTerms -> payout -> commodityPayout -> underlier -> index -> productIdentifier
            then filter source = ProductIdTypeEnum -> Name
            then extract identifier)
        else if IsFRA
        then contractualProduct -> economicTerms -> payout -> interestRatePayout -> rateSpecification -> floatingRate -> rateOption -> indexReferenceInformation -> indexName
            first
            to-string
        else if Qualify_BaseProduct_IRSwap(EconomicTermsForProduct)
        then ([EconomicTermsForProduct -> payout -> interestRatePayout -> rateSpecification -> floatingRate -> rateOption -> indexReferenceInformation -> indexName first, EconomicTermsForProduct -> payout -> interestRatePayout -> rateSpecification -> inflationRate -> rateOption -> indexReferenceInformation -> indexName first] only-element)
            to-string)
    then distinct only-element

//leg agnostic
reporting rule FloatingRateIndicator from InterestRatePayout: <"Indicator Of The Floating Rate">
    RateOption
        then extract GetIndexIndicatorFromFloatingRate(item -> floatingRateIndex to-string)

reporting rule FloatingRateIdentifier from InterestRatePayout: <"Indicator Of The Floating">
    RateOption
        then extract
            item -> indexReferenceInformation -> productIdentifier -> identifier only-element

reporting rule FloatingRateReferencePeriod from InterestRatePayout: <"Floating rate reference period">
    RateOption -> indexTenor -> period then extract FloatingReferencePeriod

reporting rule FloatingRateReferencePeriodMultiplier from InterestRatePayout: <"Floating rate reference period muliplier">
    RateOption -> indexTenor -> periodMultiplier then FormatToMax3Number

reporting rule NameOfTheFloatingRate from InterestRatePayout: <"Name of the Floating Rate">
    RateOption -> indexReferenceInformation -> indexName

reporting rule UnderlyingIdentification from TransactionReportInstruction:
    if IsCreditSwaption(ProductForEvent) or IsIRSwaption(ProductForEvent)
    then underlier.UnderlierForProduct(ProductForEvent)
    else ProductForEvent
        then extract
            if underlier.UnderlierProductIdentifier(item, ISIN) exists
            then underlier.UnderlierProductIdentifier(item, ISIN) -> identifier only-element
