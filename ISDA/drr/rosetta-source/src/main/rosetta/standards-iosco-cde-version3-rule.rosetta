namespace drr.standards.iosco.cde.version3
version "${project.version}"

import drr.regulation.common.*
import drr.standards.iosco.*

corpus TechnicalGuidance "Harmonisation of Critical Data Elements (other than UTI and UPI) version 3" CDE <"Version 3 of the CDE Technical Guidance. This new version of the CDE Technical Guidance (version 3) includes certain revisions and new data elements to the September 2021 CDE Technical Guidance. These proposed revisions and additions are deemed necessary to further improve the standardisation and understanding of the data.">

report CPMI_IOSCO CDE in T+1
  	from TransactionReportInstruction
  	when ReportableProduct
  	with type CriticalDataElement

eligibility rule ReportableProduct from TransactionReportInstruction: <"When eligible for ASIC">
    True
