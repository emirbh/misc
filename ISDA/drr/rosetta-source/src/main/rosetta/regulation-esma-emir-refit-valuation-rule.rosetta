namespace drr.regulation.esma.emir.refit.valuation
version "${project.version}"

import drr.regulation.common.*
import drr.regulation.esma.*
import drr.regulation.esma.emir.*
import drr.standards.iosco.uti.*
import drr.standards.iso.*

corpus Dissemination Valuation

report ESMA EMIR Valuation in T+1
  	from ValuationReportInstruction
  	when ReportableProduct
  	with type ESMAValuationReport

eligibility rule ReportableProduct from ValuationReportInstruction: <"When eligible for ESMA EMIR">
    [regulatoryReference ESMA EMIR Valuation
        provision "Demonstrative eligibility rule for display"]
    True

reporting rule EntityResponsibleForReporting from ValuationReportInstruction: <"Entity Responsible for Reporting">
    extract
        if IsRegulatedMarketOrThirdCountryEquivalentMarket(reportableInformation, EMIR) = False // Not executed in a regulated market or 3rd country equivalent Market
        then ExtractPartyResponsibleForReportingIdentifier(reportingSide)

reporting rule UniqueTransactionIdentifier from ValuationReportInstruction: <"Unique Transaction Identifier">
    UniqueTransactionIdentifierForValuation(item, ESMA)
        then filter IsMax32UpperCaseAlphanumericText = True

reporting rule UtiProprietary from ValuationReportInstruction: <"Unique Transaction Identifier (Proprietary)">
    UniqueTransactionIdentifierForValuation(item, ESMA)
        then filter IsMax32UpperCaseAlphanumericText = False
